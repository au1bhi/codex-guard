#!/usr/bin/env python3
"""
Codex Plus 5h Quota Guard (额度守护神)
=====================================
自动检测 Codex 5小时订阅额度。当 5h 额度低于设定阈值（默认 3%）时：
1. 自动暂停/挂起 Codex 执行以避免消耗付费 Credits；
2. 完整快照并保存当前会话（Session）与会话列表元数据；
3. 待 5h 额度刷新恢复后，自动拉起/唤醒 Codex，自动向会话发送「继续」指令，
   并完整恢复原状（包括活跃会话上下文、会话锁及会话列表）。
"""

import os
import sys
import time
import socket
import select
import base64
import struct
import json
import signal
import glob
import sqlite3
import subprocess
import argparse
import threading
import shutil
import shlex
import stat
import math
import hashlib
import tempfile
import fcntl
from contextlib import contextmanager
from urllib.parse import quote
try:
    import curses
except ImportError:
    curses = None
from datetime import datetime
from typing import Optional, Dict, Any, List, Tuple

CODEX_HOME = os.path.abspath(os.path.expanduser(os.environ.get("CODEX_HOME", "~/.codex")))
LOG_FILE = os.path.join(CODEX_HOME, "quota_guard.log")
SNAPSHOT_FILE = os.path.join(CODEX_HOME, "quota_guard_snapshot.json")
SERVICE_NAME = "codex-quota-guard"
SERVICE_FILE = os.path.expanduser(f"~/.config/systemd/user/{SERVICE_NAME}.service")


def safe_text(value) -> str:
    """Prevent untrusted titles, tool output and prompts from emitting terminal controls."""
    return "".join(c if c.isprintable() else " " for c in str(value))


def safe_display_data(value):
    if isinstance(value, str):
        return safe_text(value)
    if isinstance(value, list):
        return [safe_display_data(item) for item in value]
    if isinstance(value, dict):
        return {key: safe_display_data(item) for key, item in value.items()}
    return value


def read_snapshot() -> Dict[str, Any]:
    try:
        with open(SNAPSHOT_FILE, encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            return {}
        for key in ("sessions", "interrupted_turns"):
            if key in data and (not isinstance(data[key], list) or any(not isinstance(item, dict) for item in data[key])):
                return {}
        if "active_pids" in data and (not isinstance(data["active_pids"], list) or
                any(type(pid) is not int or pid <= 1 for pid in data["active_pids"])):
            return {}
        if "loaded_thread_ids" in data and (not isinstance(data["loaded_thread_ids"], list) or
                any(not isinstance(tid, str) or not tid for tid in data["loaded_thread_ids"])):
            return {}
        if "process_identities" in data and not isinstance(data["process_identities"], dict):
            return {}
        return data
    except (OSError, ValueError):
        return {}


def write_snapshot(data: Dict[str, Any], automatic: bool = False) -> bool:
    """Atomically replace private state; manual intent takes priority under a file lock."""
    directory = os.path.dirname(SNAPSHOT_FILE)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    lock_fd = os.open(SNAPSHOT_FILE + ".lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    path = None
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        if automatic and read_snapshot().get("reason") in {"manual_pause", "manual_top_pause", "manual_stopped"}:
            return False
        fd, path = tempfile.mkstemp(prefix=".quota-guard-", dir=directory)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(path, SNAPSHOT_FILE)
        return True
    finally:
        if path and os.path.exists(path):
            os.unlink(path)
        os.close(lock_fd)


def read_guard_json(name):
    try:
        with open(os.path.join(CODEX_HOME, name), encoding="utf-8") as f:
            value = json.load(f)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def write_guard_json(name, value):
    os.makedirs(CODEX_HOME, mode=0o700, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".guard-config-", dir=CODEX_HOME)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(value, f, ensure_ascii=False)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary, os.path.join(CODEX_HOME, name))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def get_auto_continue(default=True):
    path = os.path.join(CODEX_HOME, "quota_guard_settings.json")
    if not os.path.exists(path):
        return default
    value = read_guard_json("quota_guard_settings.json").get("auto_continue")
    # A corrupt explicit setting cannot accidentally enable automatic messages.
    return value if isinstance(value, bool) else False


def set_auto_continue(enabled):
    write_guard_json("quota_guard_settings.json", {"auto_continue": bool(enabled)})


def read_guard_service():
    result = subprocess.run(["systemctl", "--user", "show", SERVICE_NAME,
        "--property=ActiveState", "--property=MainPID", "--property=ExecStart", "--property=LoadState"],
        capture_output=True, text=True, timeout=2, check=True)
    fields = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if fields.get("LoadState") == "not-found":
        raise RuntimeError("守护服务尚未安装，请运行项目的安装脚本。")
    state = fields.get("ActiveState")
    if state not in {"active", "inactive", "failed", "activating", "deactivating"}:
        raise RuntimeError("无法读取守护服务状态。")
    pid = fields.get("MainPID", "0")
    default_auto = "--no-auto-continue" not in fields.get("ExecStart", "")
    return {"service_active": state == "active", "service_state": state,
            "service_pid": pid, "default_auto_continue": default_auto}


@contextmanager
def monitor_lock():
    os.makedirs(CODEX_HOME, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(CODEX_HOME, "quota_guard.lock"),
                 os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SystemExit("已有守护监视器运行；请先停止它再启动 watch/run。")
        yield
    finally:
        os.close(fd)


def systemd_quote(value: str, expand_environment: bool = True) -> str:
    # systemd has its own quoting, specifier and environment expansion rules.
    value = str(value).replace("%", "%%")
    if expand_environment:
        value = value.replace("$", "$$")
    return json.dumps(value, ensure_ascii=False)


def log(msg: str, print_to_stdout: bool = True):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    formatted = f"[{timestamp}] {safe_text(msg)}"
    if print_to_stdout and threading.current_thread() is threading.main_thread():
        print(formatted, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        fd = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as f:
            if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
                return
            f.write(formatted + "\n")
    except Exception:
        pass


def get_gui_env() -> Dict[str, str]:
    """动态检索当前系统活跃桌面会话的图形环境变量 (含 Wayland, Xwayland 授权凭据与 DBus 路径)"""
    uid = os.getuid()
    env = os.environ.copy()

    # 1. 尝试从运行中的桌面会话进程中读取真实完整的图形环境
    gui_procs = ['gnome-shell', 'mutter', 'kwin', 'sway', 'hyprland', 'xfce4-session', 'plasmashell', 'nautilus', 'Xwayland']
    found = {}
    for pid_dir in glob.glob('/proc/[0-9]*'):
        try:
            if os.stat(pid_dir).st_uid != uid:
                continue
            with open(f'{pid_dir}/cmdline', 'rb') as f:
                cmd = f.read().decode('utf-8', errors='ignore')
            if any(p in cmd for p in gui_procs):
                with open(f'{pid_dir}/environ', 'rb') as f:
                    for item in f.read().split(b'\0'):
                        if b'=' in item:
                            k, v = item.split(b'=', 1)
                            ks = k.decode('utf-8', errors='ignore')
                            if ks in ('DISPLAY', 'WAYLAND_DISPLAY', 'XAUTHORITY', 'DBUS_SESSION_BUS_ADDRESS', 'XDG_RUNTIME_DIR'):
                                found[ks] = v.decode('utf-8', errors='ignore')
                if 'XAUTHORITY' in found or 'WAYLAND_DISPLAY' in found:
                    break
        except Exception:
            continue

    env.update(found)

    # 2. 如果缺少 XAUTHORITY，自动检索 /run/user/{uid}/.mutter-Xwaylandauth.* 或 ~/.Xauthority
    if 'XAUTHORITY' not in env or not os.path.exists(env['XAUTHORITY']):
        mutter_auth = glob.glob(f'/run/user/{uid}/.mutter-Xwaylandauth.*')
        if mutter_auth and os.path.exists(mutter_auth[0]):
            env['XAUTHORITY'] = mutter_auth[0]
        elif os.path.exists(os.path.expanduser('~/.Xauthority')):
            env['XAUTHORITY'] = os.path.expanduser('~/.Xauthority')

    # 3. 如果缺少 WAYLAND_DISPLAY，自动检索 /run/user/{uid}/wayland-*
    if 'WAYLAND_DISPLAY' not in env:
        wayland_socks = glob.glob(f'/run/user/{uid}/wayland-[0-9]*')
        if wayland_socks:
            env['WAYLAND_DISPLAY'] = os.path.basename(wayland_socks[0])

    if 'DISPLAY' not in env:
        env['DISPLAY'] = ':0'
    if 'XDG_RUNTIME_DIR' not in env:
        env['XDG_RUNTIME_DIR'] = f'/run/user/{uid}'
    if 'DBUS_SESSION_BUS_ADDRESS' not in env:
        bus = f'/run/user/{uid}/bus'
        if os.path.exists(bus):
            env['DBUS_SESSION_BUS_ADDRESS'] = f'unix:path={bus}'

    return env


def send_notification(title: str, message: str, urgency: str = "normal"):
    """发送系统桌面通知 (通过 notify-send)"""
    env = get_gui_env()
    try:
        subprocess.run(
            ["notify-send", "-a", "Codex Quota Guard", "-u", urgency, title, message],
            env=env,
            timeout=5,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


class CodexSocketClient:
    """与 Codex App-Server Daemon 进行 WebSocket 通信的轻量客户端"""

    @classmethod
    def get_socket_path(cls) -> Optional[str]:
        # 1. 优先尝试 ~/.codex/app-server-control/app-server-control.sock
        default_link = os.path.join(CODEX_HOME, "app-server-control/app-server-control.sock")
        if cls.is_trusted_socket(default_link):
            return os.path.realpath(default_link)

        # 2. 搜索 /tmp/codex-daemon-* 下的 socket
        candidates = glob.glob(f"/tmp/codex-daemon-{os.getuid()}/*")
        for cand in candidates:
            try:
                if cls.is_trusted_socket(cand):
                    return cand
            except OSError:
                pass
        return None

    @staticmethod
    def is_trusted_socket(path: str) -> bool:
        try:
            target = os.path.realpath(path)
            info = os.stat(target)
            parent = os.stat(os.path.dirname(target))
            return (stat.S_ISSOCK(info.st_mode) and info.st_uid == os.getuid()
                    and parent.st_uid == os.getuid() and not parent.st_mode & 0o022)
        except OSError:
            return False

    @classmethod
    def ensure_daemon_running(cls) -> bool:
        sock_path = cls.get_socket_path()
        if sock_path and os.path.exists(sock_path):
            return True
        try:
            # 尝试自启动 daemon
            subprocess.run(
                ["codex", "app-server", "daemon", "start"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
            time.sleep(1)
            sock_path = cls.get_socket_path()
            return sock_path is not None and os.path.exists(sock_path)
        except Exception:
            return False

    @classmethod
    def query_app_server(cls, method: str, params: Optional[Dict[str, Any]] = None, timeout: float = 6.0) -> Optional[Any]:
        if not cls.ensure_daemon_running():
            return None

        sock_path = cls.get_socket_path()
        if not sock_path:
            return None

        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        try:
            deadline = time.monotonic() + timeout
            s.connect(sock_path)
            if hasattr(socket, "SO_PEERCRED"):
                _, peer_uid, _ = struct.unpack("3i", s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                if peer_uid != os.getuid():
                    return None

            def receive(n):
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError("RPC deadline exceeded")
                s.settimeout(remaining)
                return s.recv(n)

            key = base64.b64encode(os.urandom(16)).decode("ascii")
            s.sendall(("GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\n"
                       "Connection: Upgrade\r\nSec-WebSocket-Key: " + key +
                       "\r\nSec-WebSocket-Version: 13\r\n\r\n").encode("ascii"))
            header = bytearray()
            while b"\r\n\r\n" not in header:
                chunk = receive(4096)
                if not chunk:
                    return None
                header.extend(chunk)
                if len(header) > 65536:
                    return None
            raw_header, buffered = bytes(header).split(b"\r\n\r\n", 1)
            lines = raw_header.decode("ascii").split("\r\n")
            if len(lines[0].split()) < 2 or lines[0].split()[1] != "101":
                return None
            headers = {k.lower().strip(): v.strip() for k, v in
                       (line.split(":", 1) for line in lines[1:])}
            expected = base64.b64encode(hashlib.sha1((key +
                        "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()).decode("ascii")
            if (headers.get("sec-websocket-accept") != expected or
                    headers.get("upgrade", "").lower() != "websocket" or
                    "upgrade" not in headers.get("connection", "").lower().split(",")):
                return None
            pending = bytearray(buffered)

            def send_frame(payload, opcode=1):
                data = payload.encode("utf-8") if isinstance(payload, str) else payload
                length = len(data)
                mask = os.urandom(4)
                hdr = bytearray([0x80 | opcode])
                if length <= 125:
                    hdr.append(0x80 | length)
                elif length <= 65535:
                    hdr.append(0x80 | 126)
                    hdr.extend(struct.pack("!H", length))
                else:
                    hdr.append(0x80 | 127)
                    hdr.extend(struct.pack("!Q", length))
                hdr.extend(mask)
                s.sendall(hdr + bytes(v ^ mask[i % 4] for i, v in enumerate(data)))

            def recv_exact(n):
                while len(pending) < n:
                    chunk = receive(n - len(pending))
                    if not chunk:
                        raise EOFError("WebSocket closed")
                    pending.extend(chunk)
                result = bytes(pending[:n])
                del pending[:n]
                return result

            def recv_message():
                fragments = bytearray()
                started = False
                while True:
                    b1, b2 = recv_exact(2)
                    opcode, fin = b1 & 15, bool(b1 & 128)
                    if b1 & 0x70 or b2 & 128:
                        raise ValueError("Invalid server frame")
                    length = b2 & 127
                    if length == 126:
                        length = struct.unpack("!H", recv_exact(2))[0]
                    elif length == 127:
                        length = struct.unpack("!Q", recv_exact(8))[0]
                    if length > 16 * 1024 * 1024 or len(fragments) + length > 16 * 1024 * 1024:
                        raise ValueError("WebSocket message too large")
                    if opcode >= 8 and (not fin or length > 125):
                        raise ValueError("Invalid control frame")
                    data = recv_exact(length)
                    if opcode == 8:
                        raise EOFError("WebSocket closed")
                    if opcode == 9:
                        send_frame(data, 10)
                        continue
                    if opcode == 10:
                        continue
                    if opcode == 1 and not started:
                        started = True
                    elif opcode != 0 or not started:
                        raise ValueError("Unexpected opcode")
                    fragments.extend(data)
                    if fin:
                        return json.loads(fragments.decode("utf-8"))

            def await_result(request_id):
                while True:
                    msg = recv_message()
                    if isinstance(msg, dict) and msg.get("id") == request_id:
                        if "error" in msg or "result" not in msg:
                            return None
                        return msg["result"]

            send_frame(json.dumps({"id": 1, "method": "initialize", "params": {
                "clientInfo": {"name": "quota-guard", "title": "quota-guard", "version": "1.1"},
                "capabilities": {"experimentalApi": True}}}))
            if await_result(1) is None:
                return None
            send_frame(json.dumps({"method": "initialized"}))
            send_frame(json.dumps({"id": 2, "method": method, "params": params or {}}))
            return await_result(2)

            return None
        except Exception:
            return None
        finally:
            try:
                s.close()
            except Exception:
                pass

    @classmethod
    def query_rate_limits(cls, timeout: float = 6.0) -> Optional[Dict[str, Any]]:
        return cls.query_app_server("account/rateLimits/read", {}, timeout)

    @classmethod
    def query_loaded_threads(cls, timeout: float = 4.0) -> List[str]:
        threads, seen = [], set()
        cursor = None
        deadline = time.monotonic() + timeout
        for _ in range(100):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return []
            res = cls.query_app_server("thread/loaded/list", {"cursor": cursor}, remaining)
            if not isinstance(res, dict) or not isinstance(res.get("data"), list):
                return []
            threads.extend(t for t in res["data"] if isinstance(t, str) and t)
            cursor = res.get("nextCursor")
            if not cursor:
                return list(dict.fromkeys(threads))
            if not isinstance(cursor, str) or cursor in seen:
                return []
            seen.add(cursor)
        return []


class QuotaSnapshot:
    """格式化后的 Codex 额度快照"""

    def __init__(self, raw_data: Optional[Dict[str, Any]]):
        self.raw = raw_data if isinstance(raw_data, dict) else {}
        rl = self.raw.get("rateLimits")
        rl = rl if isinstance(rl, dict) else {}
        self.plan_type = safe_text(rl.get("planType") or "unknown")
        credits = rl.get("credits") or {}
        credits = credits if isinstance(credits, dict) else {}
        self.has_credits = credits.get("hasCredits", False)
        self.credit_balance = safe_text(credits.get("balance", "0.0"))
        windows = [w for w in (rl.get("primary"), rl.get("secondary")) if isinstance(w, dict)]
        w5 = next((w for w in windows if w.get("windowDurationMins") == 300), {})
        self.weekly_window = next((w for w in windows if w.get("windowDurationMins") == 10080), {})
        self.valid = (bool(w5) and self.valid_window(w5)
                      and all(self.valid_window(w) for w in windows)
                      and all(w is None or isinstance(w, dict) for w in (rl.get("primary"), rl.get("secondary"))))
        self.used_percent = float(w5["usedPercent"]) if self.valid else 100.0
        self.remaining_percent = max(0.0, 100.0 - self.used_percent)
        self.resets_at = 0
        try:
            value = w5.get("resetsAt")
            if value is not None and not isinstance(value, bool) and math.isfinite(float(value)):
                self.resets_at = max(0, int(value))
        except (TypeError, ValueError, OverflowError):
            pass
        self.window_duration_mins = 300
        if not self.valid_window(self.weekly_window):
            self.weekly_window = {}
        self.protection_remaining = min(self.remaining_percent,
            100.0 - float(self.weekly_window["usedPercent"])) if self.weekly_window else self.remaining_percent

    @staticmethod
    def valid_window(window):
        value = window.get("usedPercent")
        return (isinstance(value, (float, int)) and not isinstance(value, bool)
                and math.isfinite(value) and 0 <= value <= 100)

    @property
    def seconds_until_reset(self) -> float:
        if self.resets_at <= 0:
            return 0.0
        return max(0.0, float(self.resets_at - time.time()))

    @property
    def reset_datetime_str(self) -> str:
        if self.resets_at <= 0:
            return "未知"
        try:
            return datetime.fromtimestamp(self.resets_at).strftime("%Y-%m-%d %H:%M:%S")
        except (ValueError, OverflowError, OSError):
            return "未知"

    @property
    def time_to_reset_str(self) -> str:
        secs = int(self.seconds_until_reset)
        if secs <= 0:
            return "已到期/即将刷新"
        hours = secs // 3600
        mins = (secs % 3600) // 60
        if hours > 0:
            return f"{hours}小时 {mins}分钟"
        return f"{mins}分钟 ({secs}秒)"


class SessionManager:
    """会话生命周期与列表恢复管理器"""

    DB_PATH = os.path.join(CODEX_HOME, "state_5.sqlite")
    LOCK_DIR = os.path.join(CODEX_HOME, "thread-writer-locks")
    INDEX_FILE = os.path.join(CODEX_HOME, "session_index.jsonl")

    @classmethod
    def get_loaded_thread_ids(cls) -> List[str]:
        """获取当前正在加载中的活跃会话 ID 列表"""
        # A lock file's existence does not mean that a session is loaded.
        return CodexSocketClient.query_loaded_threads()

    @classmethod
    def get_db_connection(cls) -> Optional[sqlite3.Connection]:
        """安全建立只读模式 SQLite 连接 (超时 10s，避免与 app-server 写操作互锁)"""
        if not os.path.exists(cls.DB_PATH):
            return None
        try:
            real_path = os.path.realpath(cls.DB_PATH)
            return sqlite3.connect(f"file:{quote(real_path, safe='/')}?mode=ro", uri=True, timeout=10.0)
        except Exception:
            return None

    @classmethod
    def get_thread_info(cls, thread_id: str) -> Optional[Dict[str, Any]]:
        """获取指定会话的完整元数据"""
        conn = cls.get_db_connection()
        if not conn:
            return None
        try:
            c = conn.cursor()
            c.execute(
                "SELECT id, title, cwd, updated_at, source, model FROM threads WHERE id = ?",
                (thread_id,)
            )
            row = c.fetchone()
            conn.close()
            if row:
                return {
                    "id": row[0],
                    "title": safe_text(row[1] or "(未命名任务)"),
                    "cwd": row[2],
                    "updated_at": row[3],
                    "source": row[4],
                    "model": row[5]
                }
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
        return None

    @classmethod
    def is_subagent(cls, thread_id: str) -> bool:
        """判断是否为多智能体架构衍生的子代理 (Sub-Agent，不支持直接接收用户输入或单独拉起)"""
        info = cls.get_thread_info(thread_id)
        if not info:
            return False
        source = str(info.get("source") or "")
        return "subagent" in source.lower()

    @classmethod
    def get_root_thread_id(cls, thread_id: str) -> str:
        """如果目标 thread_id 是子代理，溯源并返回其所属根会话 parent_thread_id；否则返回自身"""
        seen = set()
        while thread_id not in seen and len(seen) < 100:
            seen.add(thread_id)
            info = cls.get_thread_info(thread_id)
            try:
                source = json.loads(info.get("source") or "{}") if info else {}
                parent = source.get("subagent", {}).get("thread_spawn", {}).get("parent_thread_id")
            except (ValueError, TypeError, AttributeError):
                parent = None
            if not isinstance(parent, str) or not parent:
                break
            thread_id = parent
        return thread_id

    @classmethod
    def get_live_thread_state(cls, thread_id: str) -> Dict[str, Any]:
        """获取指定会话的实时运行状态（status, turns 等）"""
        res = CodexSocketClient.query_app_server("thread/read", {"threadId": thread_id, "includeTurns": True})
        if not res or not isinstance(res, dict):
            return {}
        thread = res.get("thread", {})
        status = thread.get("status", {})
        status_type = status.get("type") if isinstance(status, dict) else str(status)
        turns = thread.get("turns", [])
        last_turn = turns[-1] if turns else {}
        return {
            "status_type": status_type,
            "turns_count": len(turns),
            "last_turn_id": last_turn.get("id"),
            "last_turn_status": last_turn.get("status"),
        }

    @classmethod
    def get_recent_sessions(cls, limit: int = 15) -> List[Dict[str, Any]]:
        """从 SQLite 获取最近的会话列表"""
        conn = cls.get_db_connection()
        if not conn:
            return []
        try:
            c = conn.cursor()
            c.execute(
                """SELECT id, title, cwd, updated_at, source, model, archived
                   FROM threads 
                   WHERE archived = 0 AND (source IS NULL OR source NOT LIKE '%subagent%')
                   ORDER BY updated_at DESC 
                   LIMIT ?""",
                (limit,)
            )
            rows = c.fetchall()
            conn.close()
            res = []
            for r in rows:
                res.append({
                    "id": r[0],
                    "title": safe_text(r[1] or "(未命名任务)"),
                    "cwd": r[2],
                    "updated_at": r[3],
                    "source": r[4],
                    "model": r[5],
                    "archived": bool(r[6])
                })
            return res
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
            return []

    @classmethod
    def interrupt_active_turns(cls) -> List[Dict[str, Any]]:
        """主动掐断所有正在运行中的 Turn（向 Codex App-Server 发送 turn/interrupt），
        请求中断服务器正在执行的回合；成功响应不构成零扣费保证。
        返回被中断的 turn 列表: [{'threadId': tid, 'turnId': turn_id, 'title': ...}]
        """
        interrupted = []
        loaded_ids = cls.get_loaded_thread_ids()
        for tid in loaded_ids:
            try:
                res = CodexSocketClient.query_app_server("thread/read", {"threadId": tid, "includeTurns": True})
                if not res or not isinstance(res, dict):
                    continue
                thread = res.get("thread", {})
                status = thread.get("status", {})
                status_type = status.get("type") if isinstance(status, dict) else str(status)
                turns = thread.get("turns", [])
                if turns:
                    last_turn = turns[-1]
                    turn_st = last_turn.get("status")
                    turn_id = last_turn.get("id")
                    if turn_st == "inProgress":
                        if turn_id:
                            result = CodexSocketClient.query_app_server("turn/interrupt", {"threadId": tid, "turnId": turn_id})
                            if result is None:
                                log(f"中断会话 [{tid[:8]}] 失败，无法确认后台任务已停止。")
                                continue
                            tinfo = cls.get_thread_info(tid)
                            title = tinfo.get("title", tid[:8]) if tinfo else tid[:8]
                            log(f"🛑 [额度拦截] 已掐断会话 [{title}] (Turn #{len(turns)}) 的后台运行: 已向 App-Server 发送 turn/interrupt！服务器已确认中断请求。")
                            interrupted.append({
                                "threadId": tid,
                                "turnId": turn_id,
                                "title": title,
                                "turns_count": len(turns)
                            })
            except Exception as e:
                log(f"掐断会话 [{tid[:8]}] 异常: {e}")
        return interrupted

    @classmethod
    def kill_orphaned_tool_subprocesses(cls):
        """检查并清理 Codex 衍生出来的子工具进程（例如正在运行的脚本或编译任务）"""
        # Only descendants of detected user clients are eligible. Never scan
        # command text for a substring and terminate unrelated process trees.
        roots = {pid for pid, _, _ in ProcessManager.get_codex_client_pids()}
        processes = {}
        for path in glob.glob("/proc/[0-9]*"):
            try:
                pid = int(os.path.basename(path))
                if os.stat(path).st_uid != os.getuid():
                    continue
                fields = ProcessManager.read_stat(pid)
                processes[pid] = (int(fields[1]), ProcessManager.process_identity(pid))
            except (OSError, ValueError, IndexError):
                continue
        protected = {os.getpid()}
        ancestor = os.getpid()
        while ancestor in processes and ancestor not in roots:
            ancestor = processes[ancestor][0]
            if ancestor in protected:
                break
            protected.add(ancestor)
        descendants = []
        for pid, (parent, identity) in processes.items():
            seen = {pid}
            depth = 0
            while parent in processes and parent not in seen:
                depth += 1
                if parent in roots:
                    if pid not in roots and pid not in protected and identity:
                        descendants.append((depth, pid, identity))
                    break
                seen.add(parent)
                parent = processes[parent][0]
        for _, pid, identity in sorted(descendants, reverse=True):
            if ProcessManager.signal_pid(pid, signal.SIGTERM, identity):
                log(f"已终止 Codex 子工具进程 PID: {pid}")

    @classmethod
    def save_snapshot(cls, active_pids: List[int], reason: str = "quota_low", interrupted_turns: Optional[List[Dict[str, Any]]] = None) -> Dict[str, Any]:
        """暂停前保存活跃会话与列表快照"""
        loaded_ids = cls.get_loaded_thread_ids()
        sessions = []
        for tid in loaded_ids:
            info = cls.get_thread_info(tid)
            if info:
                sessions.append(info)

        snapshot = {
            "timestamp": time.time(),
            "datetime": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "reason": reason,
            "active_pids": active_pids,
            "process_identities": {str(pid): ProcessManager.process_identity(pid) for pid in active_pids},
            "loaded_thread_ids": loaded_ids,
            "sessions": sessions,
            "interrupted_turns": interrupted_turns or [],
        }

        try:
            if not write_snapshot(snapshot, automatic=reason in {"quota_low", "quota_exceeded", "quota_unavailable"}):
                return {}
            log(f"已保存会话快照: {len(sessions)} 个活跃会话 (PIDs: {active_pids}), 中断了 {len(interrupted_turns or [])} 个正在运行的回合")
        except Exception as e:
            raise RuntimeError(f"保存会话快照失败，拒绝挂起未记录的进程: {e}") from e

        return snapshot

    @classmethod
    def clean_stale_locks(cls):
        """检查并清理无进程持有的死锁文件，防止会话恢复时报被占用错误"""
        # Lock lifecycle belongs to Codex. fuser + unlink is racy and can allow
        # two writers to hold different inodes for the same session.
        return

    @classmethod
    def send_continue_prompt(cls, thread_id: str, prompt: str = "继续") -> bool:
        """使用 codex queue 向指定会话发送消息（例如 '继续'）触发自动继续工作"""
        if not isinstance(thread_id, str) or not thread_id or thread_id.startswith("-"):
            return False
        if cls.is_subagent(thread_id):
            log(f"跳过向子代理 [{thread_id[:8]}...] 发送指令: 多智能体 v2 子代理不接受直接外部队列输入。")
            return False
        try:
            res = subprocess.run(
                ["codex", "queue", "--thread", thread_id, "--message", prompt],
                capture_output=True,
                text=True,
                timeout=10,
            )
            if res.returncode == 0:
                log(f"已成功向会话 [{thread_id[:8]}...] 发送指令: '{prompt}'")
                return True
            else:
                err_msg = res.stderr.strip() or res.stdout.strip()
                log(f"向会话 [{thread_id[:8]}...] 发送指令失败: {err_msg}")
                return False
        except Exception as e:
            log(f"向会话 [{thread_id[:8]}...] 发送指令异常: {e}")
            return False

    @classmethod
    def launch_codex_session(cls, session_id: str, prompt: str = "继续") -> bool:
        """自动拉起并恢复指定的 Codex 会话 (优先弹出桌面终端窗口，无图形环境则回退后台终端)"""
        # 解析根会话，避免在子代理上直接拉起
        session_id = cls.get_root_thread_id(session_id)

        # 获取系统完整图形环境变量 (含 Wayland / Xwayland 授权凭据及 DBus 路径)
        env = get_gui_env()
        if not isinstance(session_id, str) or not session_id or session_id.startswith("-"):
            return False
        info = cls.get_thread_info(session_id) or {}
        cwd = info.get("cwd")
        cwd = cwd if isinstance(cwd, str) and os.path.isdir(cwd) else None

        codex_bin = shutil.which("codex") or os.path.expanduser("~/.local/bin/codex")
        safe_bin = shlex.quote(codex_bin)
        safe_sid = shlex.quote(session_id)
        safe_prompt = shlex.quote(prompt)
        prompt_args = f" -- {safe_prompt}" if prompt else ""
        bash_cmd = f"{safe_bin} resume {safe_sid}{prompt_args}; exec bash"

        # 1. 尝试在 GNOME 终端中打开独立交互窗口拉起
        try:
            cmd = [
                "gnome-terminal",
                f"--title=Codex - 自动恢复任务 [{session_id[:8]}]",
                "--",
                "bash", "-c", bash_cmd
            ]
            res = subprocess.run(cmd, env=env, cwd=cwd, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                log(f"🚀 [自动拉起] 已在 GNOME 终端中自动拉起 Codex 会话 [{session_id[:8]}...]！")
                return True
            else:
                err_msg = res.stderr.strip() or res.stdout.strip()
                log(f"gnome-terminal 退出异常 (code {res.returncode}): {err_msg}，尝试其他终端...")
        except subprocess.TimeoutExpired:
            log("终端启动结果未知，停止自动降级以避免重复拉起。")
            return False
        except Exception as e:
            log(f"gnome-terminal 拉起失败: {e}，尝试其他终端...")

        # 2. 尝试 x-terminal-emulator
        try:
            xterm_cmd = ["x-terminal-emulator", "-T", f"Codex - 自动恢复任务 [{session_id[:8]}]", "-e", "bash", "-c", bash_cmd]
            res = subprocess.run(xterm_cmd, env=env, cwd=cwd, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                log(f"🚀 [自动拉起] 已在 x-terminal-emulator 中自动拉起 Codex 会话 [{session_id[:8]}...]！")
                return True
            else:
                err_msg = res.stderr.strip() or res.stdout.strip()
                log(f"x-terminal-emulator 退出异常 (code {res.returncode}): {err_msg}")
        except subprocess.TimeoutExpired:
            log("终端启动结果未知，停止自动降级以避免重复拉起。")
            return False
        except Exception as e:
            log(f"x-terminal-emulator 拉起失败: {e}")

        # 3. 回退到 screen 后台会话拉起
        try:
            screen_cmd = ["screen", "-dmS", f"codex-{session_id[:8]}", codex_bin, "resume", session_id]
            if prompt:
                screen_cmd.extend(["--", prompt])
            res = subprocess.run(screen_cmd, env=env, cwd=cwd, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                log(f"🚀 [自动拉起] 已在 screen 后台终端中自动拉起 Codex 会话 [{session_id[:8]}...]！")
                return True
        except Exception as e:
            log(f"screen 拉起失败: {e}")

        # Interactive Codex requires a PTY; nohup is not a working fallback.

        return False

    @classmethod
    def restore_and_verify_sessions(cls, resumed_pids: List[int], send_continue: bool = True, continue_prompt: str = "继续", exclude_thread_ids: Optional[List[str]] = None, automatic: bool = False) -> Dict[str, Any]:
        """额度恢复时：唤醒进程、验证会话状态、确保会话列表完整原状，并自动发送「继续」指令"""
        cls.clean_stale_locks()

        # 等待 1.5 秒让 Codex 进程与 App-Server 完成 socket 重建与状态恢复
        time.sleep(1.5)

        snapshot = read_snapshot()

        saved_sessions = snapshot.get("sessions", [])
        interrupted_turns = snapshot.get("interrupted_turns", [])
        loaded_now = cls.get_loaded_thread_ids()

        target_thread_ids = set()
        for sess in saved_sessions:
            if isinstance(sess.get("id"), str) and sess["id"]:
                target_thread_ids.add(cls.get_root_thread_id(sess["id"]))
        for iturn in interrupted_turns:
            if isinstance(iturn.get("threadId"), str) and iturn["threadId"]:
                target_thread_ids.add(cls.get_root_thread_id(iturn["threadId"]))
        if not saved_sessions and not interrupted_turns:
            for tid in snapshot.get("loaded_thread_ids", []):
                target_thread_ids.add(cls.get_root_thread_id(tid))

        # 排除多智能体架构子代理
        target_thread_ids = {tid for tid in target_thread_ids if not cls.is_subagent(tid)}

        exclude_set = set(exclude_thread_ids or [])
        restored_details = []
        for tid in target_thread_ids:
            info = cls.get_thread_info(tid)
            title = info.get("title", "(未命名任务)") if info else "(未命名任务)"
            cwd = info.get("cwd") if info else None
            is_loaded = tid in loaded_now

            queued = False
            if send_continue and (not automatic or get_auto_continue()):
                if tid in exclude_set:
                    log(f"会话 [{title}] (ID: {tid[:8]}...) 已作为新终端会话启动，跳过重复队列注入。")
                    queued = True
                elif is_loaded:
                    live = cls.get_live_thread_state(tid)
                    if live.get("status_type") == "idle" and (not automatic or get_auto_continue()):
                        queued = cls.send_continue_prompt(tid, continue_prompt)

            restored_details.append({
                "id": tid,
                "title": title,
                "cwd": cwd,
                "is_loaded": is_loaded,
                "continued": queued
            })

        log(f"会话状态校验与自动继续完成: 唤醒了 {len(resumed_pids)} 个进程，已向 {len(restored_details)} 个活跃会话自动发送「{continue_prompt}」。")
        for d in restored_details:
            log(f"  • 会话 [{d['title']}] (ID: {d['id'][:8]}...) -> 状态: {'活跃并载入中' if d['is_loaded'] else '就绪'} | 发送「{continue_prompt}」: {'成功' if d.get('continued') else '未发送/跳过'}")

        return {
            "resumed_pids": resumed_pids,
            "sessions": restored_details
        }


class ProcessManager:
    """管理并监测本机上的 Codex 客户端进程"""

    @staticmethod
    def command_index(parts: List[str]) -> Optional[int]:
        if not parts:
            return None
        exe = os.path.basename(parts[0]).lower()
        if exe == "codex":
            return 0
        if exe in ("node", "nodejs", "python", "python3", "env") and len(parts) > 1:
            if os.path.basename(parts[1]).lower() in ("codex", "codex.js"):
                return 1
        return None

    @staticmethod
    def is_codex_client(parts: List[str]) -> bool:
        idx = ProcessManager.command_index(parts)
        if idx is None:
            return False
        # Skip value-bearing global options to find the real subcommand.
        value_options = {"-c", "--config", "--enable", "--disable", "-m", "--model",
                         "-p", "--profile", "-s", "--sandbox", "-C", "--cd", "--add-dir",
                         "--remote", "--remote-auth-token-env"}
        i = idx + 1
        while i < len(parts):
            token = parts[i]
            if token == "--":
                return True
            if token in ("--help", "--version", "-h", "-V"):
                return False
            if token in value_options:
                i += 2
                continue
            if token.startswith("-"):
                i += 1
                continue
            return token not in {"app-server", "daemon", "internal-daemon", "queue", "login",
                                 "logout", "completion", "mcp", "mcp-server", "debug", "features",
                                 "help", "apply", "fork"}
        return True

    @staticmethod
    def is_guard_monitor(parts: List[str]) -> bool:
        if not parts:
            return False
        idx = 1 if os.path.basename(parts[0]) in ("python", "python3") else 0
        if idx >= len(parts):
            return False
        name = os.path.basename(parts[idx])
        return name == "codex-top" or (name == "codex-guard" and
                    len(parts) > idx + 1 and parts[idx + 1] in ("watch", "top"))

    @staticmethod
    def read_stat(pid: int) -> List[str]:
        # comm may contain spaces and parentheses: split only after its last ')'.
        with open(f"/proc/{pid}/stat", encoding="utf-8") as f:
            return f.read().rsplit(")", 1)[1].split()

    @staticmethod
    def process_identity(pid: int) -> Optional[Dict[str, Any]]:
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
            return None
        try:
            if os.stat(f"/proc/{pid}").st_uid != os.getuid():
                return None
            fields = ProcessManager.read_stat(pid)
            with open("/proc/sys/kernel/random/boot_id") as f:
                boot = f.read().strip()
            return {"start_time": fields[19], "boot_id": boot}
        except (OSError, IndexError, ValueError):
            return None

    @staticmethod
    def signal_pid(pid: int, sig: int, expected=None, require_client=False) -> bool:
        """Use a pidfd when available so PID reuse cannot redirect a signal."""
        fd = None
        try:
            if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1 or pid == os.getpid():
                return False
            if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
                fd = os.pidfd_open(pid)
            identity = ProcessManager.process_identity(pid)
            if not identity or (expected is not None and identity != expected):
                return False
            if require_client:
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    parts = [p.decode("utf-8", "replace") for p in f.read().split(b"\0") if p]
                if not ProcessManager.is_codex_client(parts):
                    return False
            if fd is not None:
                signal.pidfd_send_signal(fd, sig)
            else:
                os.kill(pid, sig)
            return True
        except (OSError, ValueError):
            return False
        finally:
            if fd is not None:
                os.close(fd)

    @staticmethod
    def terminate_pid(pid: int) -> bool:
        identity = ProcessManager.process_identity(pid)
        if not identity:
            return False
        ProcessManager.signal_pid(pid, signal.SIGCONT, identity, require_client=True)
        return ProcessManager.signal_pid(pid, signal.SIGTERM, identity, require_client=True)

    @classmethod
    def get_codex_client_pids(cls) -> List[Tuple[int, str, str]]:
        """获取所有正在运行的 Codex 客户端进程 (排除 daemon, helper 和自身)
        返回: [(pid, state, cmdline)]
        state: 'T' 为已被挂起暂停, 'S'/'R' 为正在运行
        """
        my_pid = os.getpid()
        results = []
        for pid_dir in glob.glob("/proc/[0-9]*"):
            try:
                pid = int(os.path.basename(pid_dir))
                if pid == my_pid or os.stat(pid_dir).st_uid != os.getuid():
                    continue
                cmdline_path = os.path.join(pid_dir, "cmdline")
                if not os.path.exists(cmdline_path):
                    continue
                with open(cmdline_path, "rb") as f:
                    content = f.read().decode("utf-8", errors="ignore")
                parts = [p for p in content.split("\0") if p]
                if not parts:
                    continue

                if not cls.is_codex_client(parts):
                    continue

                cmd_full = " ".join(parts)

                # 读取状态
                state = cls.read_stat(pid)[0]
                if state in ("Z", "X"):
                    continue

                results.append((pid, state, cmd_full))
            except (OSError, ValueError, IndexError):
                continue
        return results

    @staticmethod
    def reset_all_terminal_mouse_tracking():
        """向所有当前打开的 PTY 终端发送注销转义符，彻底关闭鼠标事件报告"""
        disable_seq = b"\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l"
        try:
            if sys.stdout.isatty():
                sys.stdout.buffer.write(disable_seq)
                sys.stdout.flush()
        except Exception:
            pass
        for pid, _, _ in ProcessManager.get_codex_client_pids():
            ProcessManager._disable_tty_mouse(pid)

    @staticmethod
    def _disable_tty_mouse(pid: int):
        """向目标进程关联的伪终端发送转义指令，禁用鼠标追踪上报，防止进程暂停后鼠标移动乱码"""
        for fd_num in (0, 1, 2):
            fd_link = f"/proc/{pid}/fd/{fd_num}"
            if os.path.exists(fd_link):
                try:
                    target = os.path.realpath(fd_link)
                    if target.startswith("/dev/pts/") or target.startswith("/dev/tty"):
                        fd = os.open(target, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
                        with os.fdopen(fd, "wb", buffering=0) as f:
                            f.write(b"\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
                        return
                except Exception:
                    pass

    @staticmethod
    def suspend_pid(pid: int, expected=None) -> bool:
        try:
            identity = ProcessManager.process_identity(pid)
            if not identity or (expected is not None and identity != expected):
                return False
            ProcessManager._disable_tty_mouse(pid)
            return ProcessManager.signal_pid(pid, signal.SIGSTOP, identity, require_client=True)
        except ProcessLookupError:
            return False
        except Exception as e:
            log(f"暂停 PID {pid} 失败: {e}")
            return False

    @staticmethod
    def resume_pid(pid: int, expected=None) -> bool:
        try:
            return ProcessManager.signal_pid(pid, signal.SIGCONT, expected, require_client=True)
        except ProcessLookupError:
            return False
        except Exception as e:
            log(f"恢复 PID {pid} 失败: {e}")
            return False


def cmd_status(args):
    """显示当前额度及守护状态"""
    data = CodexSocketClient.query_rate_limits()
    if not data:
        print("\033[31m[错误] 无法连接到 Codex App-Server Daemon，请确保 Codex 已安装并启动。\033[0m")
        sys.exit(1)

    snap = QuotaSnapshot(data)
    if not snap.valid:
        raise SystemExit("额度响应缺少有效 5h 窗口，无法判断额度。")
    pids = ProcessManager.get_codex_client_pids()
    loaded_threads = SessionManager.get_loaded_thread_ids()

    # 颜色设定
    green = "\033[32m"
    yellow = "\033[33m"
    red = "\033[31m"
    cyan = "\033[36m"
    bold = "\033[1m"
    reset = "\033[0m"

    if snap.remaining_percent <= 3.0:
        quota_color = red
        status_text = f"{red}🚨 额度极低 (< 3%)！守护拦截激活{reset}"
    elif snap.remaining_percent <= 10.0:
        quota_color = yellow
        status_text = f"{yellow}⚠️ 额度偏低 (3% - 10%){reset}"
    else:
        quota_color = green
        status_text = f"{green}🟢 额度充足{reset}"

    print(f"\n{bold}{cyan}============================================================{reset}")
    print(f"{bold}{cyan}              Codex Plus 5h 额度守护状态监控               {reset}")
    print(f"{bold}{cyan}============================================================{reset}")
    print(f"订阅计划:        {bold}{snap.plan_type.upper()}{reset}")
    print(f"5小时额度窗口:   {quota_color}已用 {snap.used_percent:.1f}% | 剩余 {snap.remaining_percent:.1f}%{reset} (窗口时长: {snap.window_duration_mins} 分钟)")
    print(f"重置时间:        {bold}{snap.reset_datetime_str}{reset} (距离刷新还有: {snap.time_to_reset_str})")

    if snap.weekly_window:
        w_used = float(snap.weekly_window.get("usedPercent", 0))
        w_rem = max(0.0, 100.0 - w_used)
        print(f"周额度窗口:      已用 {w_used:.1f}% | 剩余 {w_rem:.1f}%")

    print(f"额外 Credits:    {snap.credit_balance} ({'账户余额；未统计实际消费' if snap.has_credits else '无额度'})")
    print(f"默认保护阈值:    <= {bold}3.0%{reset}（实际阈值由 watch/service 参数配置）")
    print(f"当前额度评估:    {status_text}")
    print(f"{cyan}------------------------------------------------------------{reset}")

    if not pids:
        print("当前运行中进程:  无正在运行的 Codex 客户端进程")
    else:
        print(f"受守护进程 ({len(pids)} 个):")
        for p, st, cmd in pids:
            st_desc = f"{red}已暂停 (STOPPED){reset}" if st == "T" else f"{green}运行中 (RUNNING){reset}"
            cmd_preview = safe_text(cmd if len(cmd) <= 45 else cmd[:42] + "...")
            print(f"  • PID {bold}{p}{reset} [{st_desc}] : {cmd_preview}")

    # 显示当前活跃会话
    if loaded_threads:
        print(f"\n当前活跃会话 (已锁定载入):")
        for tid in loaded_threads:
            info = SessionManager.get_thread_info(tid)
            live = SessionManager.get_live_thread_state(tid)
            st_type = live.get("status_type", "unknown")
            turns_cnt = live.get("turns_count", 0)
            if st_type == "active":
                st_badge = f"{green}运行中 (第 {turns_cnt} 轮推进中){reset}"
            elif st_type == "idle":
                st_badge = f"{yellow}空闲就绪 (第 {turns_cnt} 轮已完成){reset}"
            elif turns_cnt == 0:
                st_badge = f"新会话就绪"
            else:
                st_badge = f"{st_type}"

            title = info['title'] if info else "(未命名任务)"
            cwd = safe_text(info['cwd']) if info else ""
            print(f"  • {bold}{title}{reset} (ID: {tid[:8]}...) [{st_badge}] [工作目录: {cwd}]")

    # 检查 systemd 服务状态
    service_status = "未运行"
    try:
        res = subprocess.run(
            ["systemctl", "--user", "is-active", SERVICE_NAME],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if res.stdout.strip() == "active":
            service_status = f"{green}🟢 后台守护服务运行中 (Active){reset}"
        else:
            service_status = f"{yellow}⚪ 后台守护服务未启动 (Inactive){reset}"
    except Exception:
        pass
    print(f"后台守护服务:    {service_status}")
    print(f"{bold}{cyan}============================================================{reset}\n")


def cmd_sessions(args):
    """显示会话列表及当前状态"""
    recent = SessionManager.get_recent_sessions(limit=args.limit)
    loaded = set(SessionManager.get_loaded_thread_ids())

    green = "\033[32m"
    yellow = "\033[33m"
    cyan = "\033[36m"
    bold = "\033[1m"
    reset = "\033[0m"

    print(f"\n{bold}{cyan}============================================================{reset}")
    print(f"{bold}{cyan}                   Codex 会话列表状态                       {reset}")
    print(f"{bold}{cyan}============================================================{reset}")

    if not recent:
        print("未检测到历史会话记录。")
    else:
        for idx, s in enumerate(recent, 1):
            is_active = s["id"] in loaded
            tag = f"{green}[活跃载入中]{reset}" if is_active else f"[历史就绪]"
            up_dt = datetime.fromtimestamp(s["updated_at"]).strftime("%Y-%m-%d %H:%M") if s["updated_at"] else "未知"
            title = s["title"] if len(s["title"]) <= 32 else s["title"][:29] + "..."
            print(f"{idx:2d}. {tag} {bold}{title:<32}{reset} (更新: {up_dt})")
            print(f"    ID: {safe_text(s['id'])} | CWD: {safe_text(s['cwd'])}")

    print(f"\n{cyan}提示: 可执行 codex resume [ID] 或 codex resume --last 无缝继续任意任务。{reset}")
    print(f"{bold}{cyan}============================================================{reset}\n")


def cmd_pause(args):
    """手动暂停所有运行中的 Codex 客户端进程与后台推理任务"""
    # Request interruption of active App-Server turns.
    interrupted = SessionManager.interrupt_active_turns()
    SessionManager.kill_orphaned_tool_subprocesses()

    # 2. 暂停所有前端 CLI 进程
    pids = ProcessManager.get_codex_client_pids()
    active_pids = [p for p, st, _ in pids if st != "T"]

    # 3. 保存快照
    SessionManager.save_snapshot(active_pids, reason="manual_pause", interrupted_turns=interrupted)

    for pid in active_pids:
        if ProcessManager.suspend_pid(pid):
            print(f"已发送 SIGSTOP 暂停 PID: {pid}")

    cnt_turns = len(interrupted)
    cnt_pids = len(active_pids)
    print(f"已成功暂停: {cnt_turns} 个后台运行中任务已掐断 (服务器已确认中断请求)，{cnt_pids} 个客户端已挂起。")
    send_notification("Codex 已手动暂停", f"已掐断 {cnt_turns} 个运行中任务，挂起 {cnt_pids} 个客户端，已确认的中断请求已发送；远端消耗不能保证立即停止。")


def cmd_stop(args):
    """彻底停止 codex-guard 本程序与后台守护服务，绝不误伤用户正常的 Codex 任务"""
    # 1. 停止后台守护服务
    disable_service = getattr(args, "disable", False) or getattr(args, "subcommand", "") in ("off", "disable")
    keep_service = getattr(args, "keep_service", False)
    if keep_service and (getattr(args, "disable", False) or getattr(args, "subcommand", "") in ("off", "disable")):
        raise SystemExit("--keep-service 与禁用服务选项不能同时使用。")
    if not keep_service:
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=True, timeout=10)
    service_disabled = False
    if disable_service:
        subprocess.run(["systemctl", "--user", "disable", SERVICE_NAME], check=True, timeout=10)
        service_disabled = True

    # 2. 终止任何前台残留的 codex-guard watch 或 codex-top 进程 (绝不终止用户正常的 codex 进程！)
    my_pid = os.getpid()
    stopped_guard_procs = 0
    try:
        for pid_str in os.listdir("/proc"):
            if not pid_str.isdigit():
                continue
            pid = int(pid_str)
            if pid == my_pid:
                continue
            try:
                if os.stat(f"/proc/{pid}").st_uid != os.getuid():
                    continue
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    cmd_raw = f.read().split(b"\x00")
                cmd_parts = [p.decode("utf-8", "ignore") for p in cmd_raw if p]
                if ProcessManager.is_guard_monitor(cmd_parts):
                    if keep_service and "watch" in cmd_parts:
                        continue
                    if ProcessManager.signal_pid(pid, signal.SIGTERM):
                        stopped_guard_procs += 1
            except Exception:
                pass
    except Exception:
        pass

    # 3. 立即重置并注销当前终端及 Codex 终端的鼠标追踪协议，彻底杜绝终端读取鼠标滑动乱码
    ProcessManager.reset_all_terminal_mouse_tracking()

    # 4. 仅在显式传入 --kill-codex 时才终止 Codex 应用自身
    kill_codex = getattr(args, "kill_codex", False)
    interrupted = []
    target_pids = []
    if kill_codex:
        interrupted = SessionManager.interrupt_active_turns()
        SessionManager.kill_orphaned_tool_subprocesses()
        pids_info = ProcessManager.get_codex_client_pids()
        target_pids = [p for p, _, _ in pids_info]
        for pid in target_pids:
            try:
                ProcessManager.terminate_pid(pid)
            except Exception:
                pass

    # 5. 更新快照状态
    if not keep_service or kill_codex:
        try:
            snap_data = read_snapshot()
            snap_data["reason"] = "manual_stopped"
            snap_data["stopped_at"] = time.time()
            write_snapshot(snap_data)
        except Exception:
            pass

    print(f"\033[32m[成功] 已彻底关闭并退出 codex-guard 额度守护程序！\033[0m")
    if keep_service:
        print("  • 已按 --keep-service 保留后台服务运行")
    elif service_disabled:
        print(f"  • 后台守护服务 ({SERVICE_NAME}) 已停止并禁用开机自启")
    else:
        print(f"  • 后台守护服务 ({SERVICE_NAME}) 已停止（如需重新启用请运行 `codex-guard service start`）")
    print(f"  • 已重置当前终端及 Codex 终端的鼠标追踪协议，杜绝鼠标事件读取")
    if kill_codex:
        print(f"  • [已按指定参数] 掐断了 {len(interrupted)} 个 Codex 任务，终止了 {len(target_pids)} 个客户端")
    else:
        print(f"  • 您的 Codex 应用保持原样运行，不受任何影响")
    send_notification("codex-guard 已停止", "守护服务已完全退出，终端环境已恢复正常。")


def cmd_guard_start(quiet=False):
    """Start the installed background guard, idempotently."""
    subprocess.run(["systemctl", "--user", "start", SERVICE_NAME], check=True, timeout=10)
    if not quiet:
        print("守护已开启。")


def cmd_guard_stop(quiet=False):
    """Stop protection and release only clients paused by this guard."""
    previous = read_snapshot()
    saved = dict(previous, reason="manual_stopped", stopped_at=time.time())
    write_snapshot(saved)
    try:
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        current = read_snapshot()
        if current.get("stopped_at") == saved["stopped_at"]:
            write_snapshot(previous)
        raise
    # Read again after shutdown so no final monitor write is lost.
    saved = read_snapshot()
    clients = {pid: state for pid, state, _ in ProcessManager.get_codex_client_pids()}
    identities = saved.get("process_identities", {})
    resumed = 0
    for pid in saved.get("active_pids", []):
        expected = identities.get(str(pid))
        if expected and clients.get(pid) in ("T", "t"):
            if ProcessManager.resume_pid(pid, expected=expected):
                resumed += 1
    if not quiet:
        print("守护已关闭。" + (f"已解除 {resumed} 个 Codex 客户端的守护暂停。" if resumed else ""))


def cmd_fix_mouse(args):
    """紧急修复终端鼠标读取问题，向当前终端及 Codex 终端注销鼠标追踪"""
    ProcessManager.reset_all_terminal_mouse_tracking()
    print(f"\033[32m[成功] 已向当前终端及 Codex 终端发送注销转义指令，鼠标追踪已彻底关闭！\033[0m")
    print("终端将不再读取或上报任何鼠标滑动与按键乱码。")


def cmd_resume(args):
    """手动恢复所有被暂停的 Codex 客户端进程或恢复指定 session"""
    if args.session_id:
        if args.session_id.startswith("-"):
            raise SystemExit("Session ID 不能以 '-' 开头。")
        cmd = ["codex", "resume", args.session_id]
        print(f"正在拉起会话: {' '.join(cmd)}")
        os.execvp("codex", cmd)
        return

    pids = ProcessManager.get_codex_client_pids()
    stopped_pids = [p for p, st, _ in pids if st == "T"]
    if not stopped_pids:
        print("没有处于暂停状态的 Codex 客户端进程需要唤醒。")
        return
    for pid in stopped_pids:
        if ProcessManager.resume_pid(pid):
            print(f"已发送 SIGCONT 唤醒 PID: {pid}")

    saved = read_snapshot()
    saved["reason"] = "manual_resumed"
    write_snapshot(saved)
    send_cont = not args.no_continue
    SessionManager.restore_and_verify_sessions(stopped_pids, send_continue=send_cont, continue_prompt=args.continue_prompt)
    send_notification("Codex 已手动唤醒", f"已唤醒 {len(stopped_pids)} 个 Codex 进程，已恢复原状并继续工作。")


def run_watch_loop(
    threshold: float = 3.0,
    interval: int = 10,
    continue_prompt: str = "继续",
    auto_continue: bool = True,
    idle_delay: int = 5,
):
    """Poll conservatively; recover only processes and sessions recorded by this guard."""
    log(f"Codex 守护启动 (阈值 {threshold}%, 间隔 {interval}s, 空闲续跑 {auto_continue})")
    send_notification("Codex 额度守护已启动", "监测 5h 与周额度；数据不可用时暂停，验证恢复后唤醒。")
    last_continued_turn = {}
    idle_since = {}
    auto_reasons = {"quota_exceeded", "quota_low", "quota_unavailable"}
    try:
        while True:
            enabled = get_auto_continue(auto_continue)
            write_guard_json("quota_guard_runtime.json", {
                "pid": os.getpid(), "auto_continue": enabled, "updated_at": time.time()})
            if not enabled:
                idle_since.clear()
            previous = read_snapshot()
            manual_pause = previous.get("reason") in {"manual_pause", "manual_top_pause", "manual_stopped"}
            snap = QuotaSnapshot(CodexSocketClient.query_rate_limits())
            if manual_pause:
                # A manual stop/pause always wins over automatic continuation.
                time.sleep(interval)
                continue
            if not snap.valid or snap.protection_remaining <= threshold:
                reason = "quota_exceeded" if snap.valid else "quota_unavailable"
                interrupted = SessionManager.interrupt_active_turns()
                if interrupted:
                    SessionManager.kill_orphaned_tool_subprocesses()
                clients = ProcessManager.get_codex_client_pids()
                active = [pid for pid, state, _ in clients if state not in ("T", "t")]
                if active or interrupted:
                    # Persist identities before stopping: systemd may terminate us at any time.
                    saved = SessionManager.save_snapshot(active, reason=reason, interrupted_turns=interrupted)
                    if not saved:
                        time.sleep(interval)
                        continue
                    if previous.get("reason") in auto_reasons:
                        for key, id_key in (("sessions", "id"), ("interrupted_turns", "threadId")):
                            merged = {item[id_key]: item for item in previous.get(key, [])
                                      if isinstance(item, dict) and item.get(id_key)}
                            merged.update({item[id_key]: item for item in saved.get(key, [])
                                           if isinstance(item, dict) and item.get(id_key)})
                            saved[key] = list(merged.values())
                        saved["loaded_thread_ids"] = list(dict.fromkeys(previous.get("loaded_thread_ids", []) + saved["loaded_thread_ids"]))
                        saved["active_pids"] = list(dict.fromkeys(previous.get("active_pids", []) + active))
                        identities = previous.get("process_identities", {}).copy()
                        identities.update(saved["process_identities"])
                        saved["process_identities"] = identities
                        if not write_snapshot(saved, automatic=True):
                            time.sleep(interval)
                            continue
                    for pid in active:
                        expected = saved["process_identities"].get(str(pid))
                        if ProcessManager.suspend_pid(pid, expected=expected):
                            log(f"额度不足或不可用，已暂停 PID {pid}；未确认额度恢复前保持暂停。")
                    send_notification("Codex 已暂停", "额度不足或不可用，等待有效的额度数据恢复。", urgency="critical")
                time.sleep(interval)
                continue

            if previous.get("reason") in auto_reasons:
                identities = previous.get("process_identities", {})
                resumed = []
                failed = False
                clients = {pid: state for pid, state, _ in ProcessManager.get_codex_client_pids()}
                for pid in previous.get("active_pids", []):
                    expected = identities.get(str(pid))
                    # Do not adopt arbitrary stopped clients or unverified legacy PIDs.
                    if expected and clients.get(pid) in ("T", "t") and ProcessManager.process_identity(pid) == expected:
                        if read_snapshot().get("reason") not in auto_reasons:
                            failed = True
                            break
                        if ProcessManager.resume_pid(pid, expected=expected):
                            resumed.append(pid)
                        else:
                            failed = True
                if resumed:
                    time.sleep(1)
                running = [pid for pid, state, _ in ProcessManager.get_codex_client_pids() if state not in ("T", "t")]
                launched = []
                targets = [item.get("id") for item in previous.get("sessions", []) if isinstance(item, dict)]
                targets += [item.get("threadId") for item in previous.get("interrupted_turns", []) if isinstance(item, dict)]
                targets += previous.get("loaded_thread_ids", [])
                roots = list(dict.fromkeys(SessionManager.get_root_thread_id(tid) for tid in targets if isinstance(tid, str) and tid))
                loaded = set(SessionManager.get_loaded_thread_ids()) if running else set()
                for tid in roots:
                    if tid in loaded or SessionManager.is_subagent(tid):
                        continue
                    if read_snapshot().get("reason") not in auto_reasons:
                        failed = True
                        break
                    if SessionManager.launch_codex_session(tid, prompt=continue_prompt if get_auto_continue(auto_continue) else ""):
                        launched.append(tid)
                    else:
                        failed = True
                if launched:
                    time.sleep(2)
                result = SessionManager.restore_and_verify_sessions(
                    resumed, send_continue=get_auto_continue(auto_continue), continue_prompt=continue_prompt,
                    exclude_thread_ids=launched, automatic=True)
                if isinstance(result, dict):
                    for detail in result.get("sessions", []):
                        if get_auto_continue(auto_continue) and detail.get("is_loaded") and not detail.get("continued"):
                            live = SessionManager.get_live_thread_state(detail["id"])
                            if live.get("status_type") == "idle":
                                failed = True
                # A concurrent manual action supersedes this recovery.
                current = read_snapshot()
                if not failed and current.get("reason") in auto_reasons:
                    current["reason"] = "quota_recovered"
                    current["recovered_at"] = time.time()
                    write_snapshot(current, automatic=True)
                    send_notification("Codex 额度已恢复", f"已唤醒 {len(resumed)} 个进程，拉起 {len(launched)} 个会话。")

            if get_auto_continue(auto_continue):
                clients = ProcessManager.get_codex_client_pids()
                if any(state not in ("T", "t") for _, state, _ in clients):
                    loaded = SessionManager.get_loaded_thread_ids()
                    for mapping in (idle_since, last_continued_turn):
                        for tid in list(mapping):
                            if tid not in loaded:
                                mapping.pop(tid, None)
                    for tid in loaded:
                        if SessionManager.is_subagent(tid):
                            continue
                        live = SessionManager.get_live_thread_state(tid)
                        turn = live.get("last_turn_id")
                        if (live.get("status_type") != "idle" or not turn or
                                live.get("last_turn_status") != "completed"):
                            idle_since.pop(tid, None)
                            continue
                        now = time.monotonic()
                        old = idle_since.get(tid)
                        if old is None or old[0] != turn:
                            idle_since[tid] = (turn, now)
                        if last_continued_turn.get(tid) == turn or now - idle_since[tid][1] < idle_delay:
                            continue
                        # Recheck quota and manual intent immediately before a new turn.
                        fresh = QuotaSnapshot(CodexSocketClient.query_rate_limits())
                        if (not get_auto_continue(auto_continue) or not fresh.valid or fresh.protection_remaining <= threshold or
                                read_snapshot().get("reason") in {"manual_pause", "manual_top_pause", "manual_stopped"}):
                            break
                        if SessionManager.send_continue_prompt(tid, continue_prompt):
                            last_continued_turn[tid] = turn
                            idle_since.pop(tid, None)
            time.sleep(interval)
    except KeyboardInterrupt:
        # Keep quota-paused clients stopped. Restart can recover them from disk.
        log("守护退出；已暂停的进程保持暂停，可用 codex-guard resume 手动唤醒。")


def cmd_watch(args):
    def shutdown(signum, frame):
        raise KeyboardInterrupt()
    old = signal.signal(signal.SIGTERM, shutdown)
    try:
        with monitor_lock():
            saved = read_snapshot()
            if saved.get("reason") == "manual_stopped":
                saved["reason"] = "guard_started"
                write_snapshot(saved)
            run_watch_loop(threshold=args.threshold, interval=args.interval,
                           continue_prompt=args.continue_prompt,
                           auto_continue=args.auto_continue, idle_delay=args.idle_delay)
    finally:
        signal.signal(signal.SIGTERM, old)


def cmd_run(args, unknown_args):
    """Guard only the wrapped child; never interrupt unrelated sessions."""
    real_codex = shutil.which("codex")
    if not real_codex:
        raise SystemExit("找不到 codex，请安装并加入 PATH。")
    if os.path.realpath(real_codex) == os.path.realpath(__file__):
        raise SystemExit("codex 指向 codex-guard，拒绝递归启动。")
    with monitor_lock():
        snap = QuotaSnapshot(CodexSocketClient.query_rate_limits())
        while not snap.valid or snap.protection_remaining <= args.threshold:
            log("额度不足或无法验证，延迟启动 Codex。")
            time.sleep(args.interval)
            snap = QuotaSnapshot(CodexSocketClient.query_rate_limits())
        forwarded = list(unknown_args)
        if forwarded[:1] == ["--"]:
            forwarded.pop(0)
        proc = subprocess.Popen([real_codex] + forwarded)
        stopped = False
        def shutdown(signum, frame):
            raise KeyboardInterrupt()
        old = signal.signal(signal.SIGTERM, shutdown)
        try:
            while proc.poll() is None:
                snap = QuotaSnapshot(CodexSocketClient.query_rate_limits())
                safe = snap.valid and snap.protection_remaining > args.threshold
                if not safe and not stopped:
                    stopped = ProcessManager.suspend_pid(proc.pid)
                    log(f"额度不足或无法验证，暂停包装进程 PID {proc.pid}。")
                elif safe and stopped:
                    if ProcessManager.resume_pid(proc.pid):
                        stopped = False
                time.sleep(args.interval)
        except KeyboardInterrupt:
            if stopped:
                ProcessManager.resume_pid(proc.pid)
            proc.send_signal(signal.SIGINT)
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        finally:
            signal.signal(signal.SIGTERM, old)
        raise SystemExit(proc.returncode if proc.returncode is not None else 1)


def cmd_service(args):
    """管理 systemd 用户级守护服务"""
    action = args.action
    exec_path = os.path.realpath(__file__)

    if action == "install":
        os.makedirs(os.path.dirname(SERVICE_FILE), exist_ok=True)
        auto_flag = " --auto-continue" if args.auto_continue else " --no-auto-continue"
        content = f"""[Unit]
Description=Codex Plus 5h Quota Guard Sentinel
After=network.target

[Service]
Type=simple
ExecStart={systemd_quote(exec_path)} watch --threshold {args.threshold} --interval {args.interval} --continue-prompt {systemd_quote(args.continue_prompt)} --idle-delay {args.idle_delay}{auto_flag}
Restart=on-failure
RestartSec=10
Environment={systemd_quote("PATH=" + os.path.dirname(exec_path) + ":/usr/local/bin:/usr/bin:/bin", False)}
Environment={systemd_quote("CODEX_HOME=" + CODEX_HOME, False)}
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{os.getuid()}/bus
Environment=XDG_RUNTIME_DIR=/run/user/{os.getuid()}

[Install]
WantedBy=default.target
"""
        with open(SERVICE_FILE, "w", encoding="utf-8") as f:
            f.write(content)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "restart", SERVICE_NAME], check=True)
        subprocess.run(["systemctl", "--user", "enable", SERVICE_NAME], check=True)
        print(f"\033[32m[成功] 已安装并启动系统后台服务: {SERVICE_NAME}\033[0m")
        print("开机或用户登录时将自动常驻后台监控，额度恢复或回合空闲时将自动发送「继续」，无需手动干预！")

    elif action == "uninstall":
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=True, timeout=10)
        subprocess.run(["systemctl", "--user", "disable", SERVICE_NAME], check=True, timeout=10)
        if os.path.exists(SERVICE_FILE):
            os.remove(SERVICE_FILE)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True, timeout=10)
        print(f"\033[32m[成功] 已卸载后台服务: {SERVICE_NAME}\033[0m")

    elif action == "stop":
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=True, timeout=10)
        print(f"\033[32m[成功] 已停止后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "disable":
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=True, timeout=10)
        subprocess.run(["systemctl", "--user", "disable", SERVICE_NAME], check=True, timeout=10)
        print(f"\033[32m[成功] 已停止并禁用后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "enable":
        subprocess.run(["systemctl", "--user", "enable", SERVICE_NAME], check=True, timeout=10)
        subprocess.run(["systemctl", "--user", "start", SERVICE_NAME], check=True, timeout=10)
        print(f"\033[32m[成功] 已启用并启动后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "start":
        subprocess.run(["systemctl", "--user", "start", SERVICE_NAME], check=True, timeout=10)
        print(f"\033[32m[成功] 已启动后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "restart":
        subprocess.run(["systemctl", "--user", "restart", SERVICE_NAME], check=True, timeout=10)
        print(f"\033[32m[成功] 已重启后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "status":
        subprocess.run(["systemctl", "--user", "status", SERVICE_NAME])


class TerminalKeyFilter:
    """Consume escape reports before interpreting single-character shortcuts."""

    def __init__(self):
        self.state = "normal"
        self.csi_length = 0
        self.mouse_bytes = 0

    def feed(self, key: int) -> int:
        if key < 0:
            return -1
        if key > 255:
            return key
        if self.state == "mouse":
            self.mouse_bytes -= 1
            if not self.mouse_bytes:
                self.state = "normal"
            return -1
        if key == 27:
            self.state = "escape"
            return -1
        if self.state == "escape":
            if key in (ord('['), ord('O')):
                self.state = "csi"
                self.csi_length = 0
                return -1
            self.state = "normal"
        elif self.state == "csi":
            # X10 mouse reports append three raw bytes after ESC [ M.
            # Coordinates can equal 'q', 'r', '+' or '-'.
            if key == ord('M') and self.csi_length == 0:
                self.state = "mouse"
                self.mouse_bytes = 3
            elif 0x40 <= key <= 0x7e:
                self.state = "normal"
            else:
                self.csi_length += 1
            return -1
        return key


class CodexTopDashboard:
    """类似 top/htop 的全功能实时终端控制台（异步指标采集 + 60FPS 毫秒级拖拽响应）"""

    def __init__(self, delay: float = 1.0, continue_prompt: str = "继续"):
        self.delay = delay
        self.continue_prompt = continue_prompt
        self.flash_message = ""
        self.flash_time = 0.0
        self.cpu_tracker = {}  # pid -> (jiffies, timestamp)
        self._action_lock = threading.Lock()
        self._action_thread = None

        # 异步线程安全数据缓存机制
        self._data_lock = threading.Lock()
        self._cached_data = None
        self._stop_event = threading.Event()
        self._force_refresh_event = threading.Event()
        self._worker_thread = None
        try:
            self.init_mtime = os.path.getmtime(os.path.realpath(__file__))
        except Exception:
            self.init_mtime = 0.0

    def toggle_guard(self):
        status = read_guard_service()
        if status["service_state"] in ("activating", "deactivating"):
            raise RuntimeError("守护正在切换，请稍候。")
        if status["service_active"]:
            cmd_guard_stop(quiet=True)
            return "守护已关闭，已解除守护记录的客户端暂停。"
        cmd_guard_start(quiet=True)
        return "守护已开启。"

    def toggle_auto_continue(self):
        status = read_guard_service()
        enabled = not get_auto_continue(status["default_auto_continue"])
        set_auto_continue(enabled)
        return "自动继续已" + ("开启" if enabled else "关闭") + "；设置已保存，后台下一次检查生效。"

    def pause_clients(self):
        clients = ProcessManager.get_codex_client_pids()
        active = [pid for pid, state, _ in clients if state not in ("T", "t")]
        saved = SessionManager.save_snapshot(active, reason="manual_top_pause")
        paused = sum(ProcessManager.suspend_pid(pid, expected=saved["process_identities"].get(str(pid))) for pid in active)
        interrupted = SessionManager.interrupt_active_turns()
        if interrupted:
            SessionManager.kill_orphaned_tool_subprocesses()
        saved["interrupted_turns"] = interrupted
        write_snapshot(saved)
        return f"已暂停 {paused} 个客户端，中断 {len(interrupted)} 个回合。"

    def resume_clients(self):
        saved = read_snapshot()
        resumed = []
        for pid, state, _ in ProcessManager.get_codex_client_pids():
            if state in ("T", "t") and ProcessManager.resume_pid(pid):
                resumed.append(pid)
        saved["reason"] = "manual_resumed"
        write_snapshot(saved)
        status = read_guard_service()
        enabled = get_auto_continue(status["default_auto_continue"])
        SessionManager.restore_and_verify_sessions(resumed, send_continue=enabled,
                                                  continue_prompt=self.continue_prompt)
        return f"已唤醒 {len(resumed)} 个客户端。"

    def continue_now(self):
        snap = QuotaSnapshot(CodexSocketClient.query_rate_limits())
        if not snap.valid or snap.protection_remaining <= 3:
            raise RuntimeError("额度不足或不可用，暂不发送继续。")
        for tid in SessionManager.get_loaded_thread_ids():
            if not SessionManager.is_subagent(tid) and SessionManager.get_live_thread_state(tid).get("status_type") == "idle":
                if SessionManager.send_continue_prompt(tid, self.continue_prompt):
                    return "已向当前空闲会话发送继续。"
                raise RuntimeError("发送失败，请查看守护日志。")
        raise RuntimeError("没有可接收继续的空闲根会话。")

    def handle_control_key(self, key):
        actions = {ord('g'): self.toggle_guard, ord('s'): self.toggle_guard,
                   ord('a'): self.toggle_auto_continue, ord('p'): self.pause_clients,
                   ord('c'): self.resume_clients, ord(' '): self.continue_now}
        action = actions.get(key + 32 if ord('A') <= key <= ord('Z') else key)
        if action is None:
            return False
        if not self._action_lock.acquire(blocking=False):
            self.set_flash("正在执行上一项操作，请稍候。")
            return True
        self.set_flash("正在执行操作…")
        def perform():
            try:
                self.set_flash(action())
            except Exception as error:
                self.set_flash(f"操作失败: {error}")
            finally:
                self._action_lock.release()
                self.trigger_background_refresh()
        self._action_thread = threading.Thread(target=perform, name="codex-top-control", daemon=True)
        self._action_thread.start()
        return True

    @staticmethod
    def control_status(data):
        active = data.get("service_active")
        guard = "ON" if active is True else "OFF" if active is False else "UNKNOWN"
        enabled = data.get("auto_continue_enabled")
        automatic = "ON" if enabled is True else "OFF" if enabled is False else "UNKNOWN"
        if active is False:
            automatic += " (守护关闭，未执行)"
        elif data.get("auto_continue_pending"):
            automatic += " (待后台应用)"
        return f"[g] 守护: {guard} | [a] 自动继续: {automatic}"

    def check_and_reload(self) -> bool:
        """若检测到磁盘上的脚本文件被更新，自动重新执行当前进程以热加载最新逻辑"""
        try:
            cur_path = os.path.realpath(__file__)
            if os.path.exists(cur_path) and os.path.getmtime(cur_path) > self.init_mtime:
                try:
                    if curses and not curses.isendwin():
                        curses.endwin()
                except Exception:
                    pass
                os.execv(sys.executable, [sys.executable, cur_path] + sys.argv[1:])
                return True
        except Exception:
            pass
        return False

    def set_flash(self, msg: str):
        self.flash_message = safe_text(msg)
        self.flash_time = time.time()

    def _background_collector(self):
        """后台异步指标采集线程：完全解耦数据采集与界面渲染，保证前台 UI 毫秒级跟手响应"""
        while not self._stop_event.is_set():
            try:
                new_data = self.collect_data()
                with self._data_lock:
                    self._cached_data = new_data
            except Exception:
                pass

            # 等待 self.delay 秒或等待强制刷新信号
            self._force_refresh_event.wait(timeout=self.delay)
            self._force_refresh_event.clear()

    def get_snapshot(self) -> Dict[str, Any]:
        """获取最新的指标快照 (非阻塞极速返回)"""
        with self._data_lock:
            if self._cached_data is not None:
                return self._cached_data
        data = self.collect_data()
        with self._data_lock:
            self._cached_data = data
        return data

    def trigger_background_refresh(self):
        """唤醒后台采集线程立即执行一次采集"""
        self._force_refresh_event.set()

    def get_proc_metrics(self, pid: int) -> Dict[str, Any]:
        """获取指定进程的 CPU% 与物理内存 RSS"""
        try:
            with open(f"/proc/{pid}/stat", "r") as f:
                parts = f.read().rsplit(")", 1)[1].split()
            state = parts[0]
            utime = int(parts[11])
            stime = int(parts[12])
            total_jiffies = utime + stime
            rss_pages = int(parts[21])
            mem_mb = (rss_pages * os.sysconf("SC_PAGE_SIZE")) / (1024.0 * 1024.0)

            now = time.time()
            cpu_pct = 0.0
            if pid in self.cpu_tracker:
                prev_jiffies, prev_time = self.cpu_tracker[pid]
                dt = now - prev_time
                if dt > 0.1:
                    dj = total_jiffies - prev_jiffies
                    clk = os.sysconf("SC_CLK_TCK")
                    cpu_pct = max(0.0, ((dj / clk) / dt) * 100.0)
            self.cpu_tracker[pid] = (total_jiffies, now)

            return {
                "pid": pid,
                "state": state,
                "state_desc": "STOPPED" if state == "T" else "RUNNING",
                "cpu_pct": cpu_pct,
                "mem_mb": mem_mb,
            }
        except Exception:
            return {"pid": pid, "state": "S", "state_desc": "RUNNING", "cpu_pct": 0.0, "mem_mb": 0.0}

    def collect_data(self) -> Dict[str, Any]:
        """采集一次完整监控指标数据 (在后台线程执行，不卡前台)"""
        rate_data = CodexSocketClient.query_rate_limits()
        snap = QuotaSnapshot(rate_data)
        snap = snap if snap.valid else None

        client_pids = ProcessManager.get_codex_client_pids()
        current_pids = {p for p, _, _ in client_pids}
        dead_pids = [p for p in self.cpu_tracker if p not in current_pids]
        for p in dead_pids:
            self.cpu_tracker.pop(p, None)

        proc_metrics = []
        for p, st, cmd in client_pids:
            m = self.get_proc_metrics(p)
            m["cmd"] = cmd
            proc_metrics.append(m)

        loaded_threads = SessionManager.get_loaded_thread_ids()
        sorted_threads = sorted(loaded_threads, key=lambda tid: 1 if SessionManager.is_subagent(tid) else 0)
        threads_info = []
        for idx, tid in enumerate(sorted_threads):
            info = SessionManager.get_thread_info(tid)
            live = SessionManager.get_live_thread_state(tid)
            need_turns = (idx == 0)
            turns = []
            if need_turns:
                res = CodexSocketClient.query_app_server("thread/read", {"threadId": tid, "includeTurns": True})
                if res and isinstance(res, dict) and "thread" in res:
                    turns = res["thread"].get("turns", [])
            threads_info.append({
                "id": tid,
                "title": info.get("title", "(未命名任务)") if info else "(未命名任务)",
                "cwd": info.get("cwd", "") if info else "",
                "status_type": live.get("status_type", "unknown"),
                "turns_count": len(turns) if turns else (live.get("turns_count") or 0),
                "last_turn_id": live.get("last_turn_id"),
                "last_turn_status": live.get("last_turn_status"),
                "turns": turns,
                "is_subagent": SessionManager.is_subagent(tid),
            })

        try:
            with open("/proc/uptime", "r") as f:
                sec = float(f.read().split()[0])
            up_str = f"up {int(sec//3600)}h {int((sec%3600)//60)}m"
        except Exception:
            up_str = "up"
        try:
            l1, l5, l15 = os.getloadavg()
            load_str = f"{l1:.2f}, {l5:.2f}, {l15:.2f}"
        except Exception:
            load_str = "N/A"

        service = {"service_active": None, "service_state": "unknown", "service_pid": "N/A",
                   "default_auto_continue": True}
        try:
            service = read_guard_service()
        except (OSError, subprocess.SubprocessError, RuntimeError):
            pass
        enabled = get_auto_continue(service["default_auto_continue"])
        runtime = read_guard_json("quota_guard_runtime.json")
        applied = runtime.get("pid") == int(service["service_pid"]) if service["service_pid"].isdigit() else False
        pending = service["service_active"] is True and (not applied or runtime.get("auto_continue") != enabled)

        return {
            "snapshot": snap,
            "processes": proc_metrics,
            "threads": threads_info,
            "uptime": up_str,
            "load": load_str,
            "service_active": service["service_active"],
            "service_state": service["service_state"],
            "service_pid": service["service_pid"],
            "auto_continue_enabled": enabled,
            "auto_continue_pending": pending,
            "time_str": time.strftime("%H:%M:%S"),
        }

    def render_batch_from_data(self, d: Dict[str, Any], out=sys.stdout):
        """根据提供的数据快照格式化并输出到终端"""
        d = safe_display_data(d)
        snap = d["snapshot"]

        BOLD = "\033[1m"
        RESET = "\033[0m"
        GREEN = "\033[32m"
        YELLOW = "\033[33m"
        RED = "\033[31m"
        CYAN = "\033[36m"
        BG_CYAN = "\033[46;30m"
        BG_GRAY = "\033[47;30m"
        DIM = "\033[2m"

        def make_bar(used, width=28):
            u = max(0, min(width, int(round((used/100.0)*width))))
            return "█"*u + "░"*(width - u)

        st_color = GREEN if d["service_active"] else YELLOW
        st_desc = f"ACTIVE (PID {d['service_pid']})" if d["service_active"] is True else "INACTIVE" if d["service_active"] is False else "UNKNOWN"
        out.write(f"{BG_CYAN} codex-top {RESET} - {BOLD}{d['time_str']}{RESET} {d['uptime']}, load: {d['load']}, Sentinel: {st_color}{st_desc}{RESET}\n")

        if snap:
            rem = snap.remaining_percent
            q_color = RED if rem <= 3.0 else (YELLOW if rem <= 15.0 else GREEN)
            b_5h = make_bar(snap.used_percent)
            out.write(f"5h Quota:   [{q_color}{b_5h}{RESET}] {snap.used_percent:.1f}% used | {BOLD}{q_color}{rem:.1f}% left{RESET} (Reset: {snap.reset_datetime_str} in {snap.time_to_reset_str})\n")

            if snap.weekly_window:
                w_used = float(snap.weekly_window.get("usedPercent", 0))
                w_rem = max(0.0, 100.0 - w_used)
                b_wk = make_bar(w_used)
                out.write(f"Week Quota: [{CYAN}{b_wk}{RESET}] {w_used:.1f}% used | {w_rem:.1f}% left | Credits: {BOLD}{snap.credit_balance}{RESET} (余额；未统计消费)\n")

            out.write(f"Plan: {snap.plan_type.upper()}\n")
        out.write(self.control_status(d) + "\n\n")

        out.write(f"{BG_GRAY} PID      STATE     CPU%   MEM     TURNS  STATUS       ACTIVE SESSION / TASK TITLE                  {RESET}\n")
        if not d["processes"]:
            out.write(" (No active Codex client process detected)\n")
        else:
            for p in d["processes"]:
                st_str = f"{RED}STOPPED{RESET}" if p["state"] == "T" else f"{GREEN}RUNNING{RESET}"
                th_title = p["cmd"][:35]
                turns_cnt = "-"
                turn_st = "-"
                matched_thread = None
                for th in d.get("threads", []):
                    if th["id"] in p["cmd"]:
                        matched_thread = th
                        break
                if not matched_thread and d.get("threads"):
                    root_threads = [th for th in d["threads"] if not th.get("is_subagent", False)]
                    matched_thread = root_threads[0] if root_threads else d["threads"][0]

                if matched_thread:
                    th_title = matched_thread["title"]
                    turns_cnt = str(matched_thread["turns_count"])
                    turn_st = str(matched_thread["last_turn_status"] or matched_thread["status_type"])

                cpu_fmt = f"{p['cpu_pct']:.1f}%"
                mem_fmt = f"{p['mem_mb']:.1f}M"
                out.write(f" {p['pid']:<8} {st_str:<17} {cpu_fmt:<6} {mem_fmt:<7} #{turns_cnt:<5} {turn_st:<12} {th_title[:45]}\n")

        out.write("\n")
        if d["threads"]:
            t0 = d["threads"][0]
            turns = t0["turns"]
            if turns:
                last_turn = turns[-1]
                items = last_turn.get("items", [])
                t_idx = len(turns)
                t_st = last_turn.get("status", "inProgress")
                st_color = GREEN if t_st == "inProgress" else YELLOW
                out.write(f"{DIM}─── Live Turn Execution Stream (Turn #{t_idx} ─ {st_color}{t_st}{RESET}{DIM}, {len(items)} actions) ────────────────────────{RESET}\n")
                for it in items[-8:]:
                    itype = it.get("type")
                    if itype == "commandExecution":
                        c_st = it.get("status", "running")
                        cmd_txt = it.get("command", "").replace("\n", " ").strip()
                        c_color = GREEN if c_st == "completed" else (RED if c_st == "failed" else YELLOW)
                        dur = f"{it.get('durationMs', 0)}ms" if it.get("durationMs") else ""
                        out.write(f"  • {BOLD}[CMD:{c_color}{c_st}{RESET}{BOLD}]{RESET} {cmd_txt[:70]} {DIM}{dur}{RESET}\n")
                    elif itype == "reasoning":
                        out.write(f"  • {CYAN}[REASONING]{RESET} Deep model reasoning & kernel latency analysis...\n")
                    elif itype == "webSearch":
                        out.write(f"  • {YELLOW}[SEARCH]{RESET} {it.get('query', '')[:65]}\n")
                    elif itype == "message":
                        content = str(it.get("content", "")).replace("\n", " ")[:65]
                        out.write(f"  • {DIM}[MSG]{RESET} {content}\n")

        out.write(f"\n{DIM}───────────────────────────────────────────────────────────────────────────────{RESET}\n")
        now = time.time()
        if self.flash_message and (now - self.flash_time < 3.0):
            out.write(f" {BOLD}{GREEN}>>> {self.flash_message}{RESET}\n")
        else:
            out.write(f" [q] 退出  [r] 刷新  [+/-] 调频 ({self.delay:.1f}s) | [g] 守护开关 [a] 自动继续 [p/c] 暂停/唤醒 [Space] 继续\n")
        out.flush()

    def render_batch(self, out=sys.stdout):
        """单次快照输出"""
        self.render_batch_from_data(self.get_snapshot(), out)

    def draw_curses_screen(self, stdscr, data: Dict[str, Any], maxy: int, maxx: int):
        """极速纯内存重绘 Curses 界面 (耗时 < 0.2ms，拖拽窗口极致丝滑)"""
        snap = data["snapshot"]

        def c_pair(n: int) -> int:
            try:
                return curses.color_pair(n)
            except Exception:
                return 0

        data = safe_display_data(data)

        def safe_addstr(y, x, s, attr=0):
            if y < 0 or y >= maxy or x < 0 or x >= maxx:
                return
            avail = maxx - x if y < maxy - 1 else max(0, maxx - x - 1)
            if avail <= 0:
                return
            try:
                stdscr.addnstr(y, x, s, avail, attr)
            except curses.error:
                pass

        def pad_line(y, x, s, attr=0):
            """输出文本并用空格填充整行，防止拖拽缩放时残影"""
            if y < 0 or y >= maxy or x < 0 or x >= maxx:
                return
            avail = maxx - x if y < maxy - 1 else max(0, maxx - x - 1)
            if avail <= 0:
                return
            full_str = s if len(s) >= avail else s + " " * (avail - len(s))
            try:
                stdscr.addnstr(y, x, full_str, avail, attr)
            except curses.error:
                pass

        # 极小窗口自适应
        if maxy < 6 or maxx < 35:
            safe_addstr(0, 0, " codex-top ", c_pair(6) | curses.A_BOLD)
            if snap:
                safe_addstr(1, 0, f"5h: {snap.used_percent:.0f}% used | {snap.remaining_percent:.0f}% left")
            safe_addstr(2, 0, f"[g] 守护: {'ON' if data.get('service_active') else 'OFF'}")
            automatic = data.get("auto_continue_enabled")
            safe_addstr(3, 0, f"[a] 自动继续: {'ON' if automatic else 'OFF'} [q]退出")
            return

        # 1. 顶部 Header
        st_color = c_pair(1) if data["service_active"] else c_pair(2)
        st_desc = f"ACTIVE (PID {data['service_pid']})" if data["service_active"] is True else "INACTIVE" if data["service_active"] is False else "UNKNOWN"
        pad_line(0, 0, f" codex-top  - {data['time_str']} {data['uptime']}, load: {data['load']}, Sentinel: {st_desc}")
        safe_addstr(0, 0, " codex-top ", c_pair(6) | curses.A_BOLD)
        sentinel_pos = len(f" codex-top  - {data['time_str']} {data['uptime']}, load: {data['load']}, Sentinel: ")
        safe_addstr(0, sentinel_pos, st_desc, st_color | curses.A_BOLD)

        # 2. 额度进度条
        if snap:
            bar_w = min(28, max(8, maxx - 52))
            def make_bar_txt(used, width):
                u = max(0, min(width, int(round((used/100.0)*width))))
                return "█"*u, "░"*(width - u)

            rem = snap.remaining_percent
            q_attr = c_pair(3) if rem <= 3.0 else (c_pair(2) if rem <= 15.0 else c_pair(1))
            u_chars, r_chars = make_bar_txt(snap.used_percent, bar_w)

            pad_line(1, 0, f"5h Quota:   [{' '*bar_w}] {snap.used_percent:.1f}% used | {rem:.1f}% left (Reset: {snap.reset_datetime_str} in {snap.time_to_reset_str})")
            safe_addstr(1, 13, u_chars, q_attr | curses.A_BOLD)
            safe_addstr(1, 13 + len(u_chars), r_chars, curses.A_DIM)

            if snap.weekly_window:
                w_used = float(snap.weekly_window.get("usedPercent", 0))
                w_rem = max(0.0, 100.0 - w_used)
                wu_chars, wr_chars = make_bar_txt(w_used, bar_w)
                pad_line(2, 0, f"Week Quota: [{' '*bar_w}] {w_used:.1f}% used | {w_rem:.1f}% left | Credits: {snap.credit_balance} (余额；未统计消费)")
                safe_addstr(2, 13, wu_chars, c_pair(4) | curses.A_BOLD)
                safe_addstr(2, 13 + len(wu_chars), wr_chars, curses.A_DIM)

        pad_line(3, 0, self.control_status(data))

        # 3. 进程表格
        pad_line(4, 0, "")
        header_row = 5
        header_txt = f" {'PID':<8} {'STATE':<9} {'CPU%':<6} {'MEM':<7} {'TURNS':<6} {'STATUS':<12} {'ACTIVE SESSION / TASK TITLE':<{max(10, maxx-52)}}"
        pad_line(header_row, 0, header_txt, c_pair(7) | curses.A_BOLD)

        cur_row = 6
        if not data["processes"]:
            pad_line(cur_row, 0, "  (No active Codex client process detected)", curses.A_DIM)
            cur_row += 1
        else:
            for p in data["processes"]:
                if cur_row >= maxy - 4:
                    break
                st_attr = c_pair(3) | curses.A_BOLD if p["state"] == "T" else c_pair(1) | curses.A_BOLD
                th_title = p["cmd"][:45]
                turns_cnt = "-"
                turn_st = "-"
                matched_thread = None
                for th in data.get("threads", []):
                    if th["id"] in p["cmd"]:
                        matched_thread = th
                        break
                if not matched_thread and data.get("threads"):
                    root_threads = [th for th in data["threads"] if not th.get("is_subagent", False)]
                    matched_thread = root_threads[0] if root_threads else data["threads"][0]

                if matched_thread:
                    th_title = matched_thread["title"]
                    turns_cnt = str(matched_thread["turns_count"])
                    turn_st = str(matched_thread["last_turn_status"] or matched_thread["status_type"])

                pad_line(cur_row, 0, "")
                safe_addstr(cur_row, 1, f"{p['pid']:<8}")
                safe_addstr(cur_row, 10, f"{p['state_desc']:<9}", st_attr)
                safe_addstr(cur_row, 20, f"{p['cpu_pct']:>4.1f}% ")
                safe_addstr(cur_row, 27, f"{p['mem_mb']:>5.1f}M ")
                safe_addstr(cur_row, 35, f"#{turns_cnt:<5}")
                safe_addstr(cur_row, 42, f"{turn_st:<12}")
                safe_addstr(cur_row, 55, th_title[:max(10, maxx-56)])
                cur_row += 1

        # 4. 实时执行流（Turn Stream）
        pad_line(cur_row, 0, "")
        cur_row += 1
        if data["threads"] and cur_row < maxy - 4:
            target_th = None
            if data.get("processes"):
                for th in data["threads"]:
                    if th["id"] in data["processes"][0]["cmd"]:
                        target_th = th
                        break
            if not target_th:
                root_threads = [th for th in data["threads"] if not th.get("is_subagent", False)]
                target_th = root_threads[0] if root_threads else data["threads"][0]

            turns = target_th["turns"] if target_th else []
            if turns:
                last_turn = turns[-1]
                items = last_turn.get("items", [])
                t_idx = len(turns)
                t_st = last_turn.get("status", "inProgress")

                div_title = f"─── Live Turn Execution Stream (Turn #{t_idx} ─ {t_st}, {len(items)} actions) "
                div_full = div_title + "─" * max(0, maxx - len(div_title) - 1)
                pad_line(cur_row, 0, div_full, curses.A_DIM)
                cur_row += 1

                avail_rows = maxy - cur_row - 3
                disp_items = items[-avail_rows:] if avail_rows > 0 else []
                for it in disp_items:
                    if cur_row >= maxy - 2:
                        break
                    pad_line(cur_row, 0, "")
                    itype = it.get("type")
                    if itype == "commandExecution":
                        c_st = it.get("status", "running")
                        cmd_txt = it.get("command", "").replace("\n", " ").strip()
                        c_color = c_pair(1) if c_st == "completed" else (c_pair(3) if c_st == "failed" else c_pair(2))
                        dur = f"{it.get('durationMs', 0)}ms" if it.get("durationMs") else ""
                        safe_addstr(cur_row, 2, "• [CMD:", curses.A_BOLD)
                        safe_addstr(cur_row, 8, c_st, c_color | curses.A_BOLD)
                        safe_addstr(cur_row, 8 + len(c_st), f"] {cmd_txt[:max(10, maxx-25)]} ")
                        if dur:
                            safe_addstr(cur_row, min(maxx - len(dur) - 2, 8 + len(c_st) + len(cmd_txt) + 3), dur, curses.A_DIM)
                    elif itype == "reasoning":
                        safe_addstr(cur_row, 2, "• [REASONING] ", c_pair(4) | curses.A_BOLD)
                        safe_addstr(cur_row, 16, f"Deep model reasoning & kernel latency analysis... ({target_th['title'][:25]})", curses.A_DIM)
                    elif itype == "webSearch":
                        safe_addstr(cur_row, 2, "• [SEARCH] ", c_pair(2) | curses.A_BOLD)
                        safe_addstr(cur_row, 13, it.get("query", "")[:max(10, maxx-16)])
                    elif itype == "message":
                        content = str(it.get("content", "")).replace("\n", " ")[:max(10, maxx-16)]
                        safe_addstr(cur_row, 2, "• [MSG] ", curses.A_DIM)
                        safe_addstr(cur_row, 10, content)
                    cur_row += 1

        # 清除多余行直到 footer
        while cur_row < maxy - 2:
            pad_line(cur_row, 0, "")
            cur_row += 1

        # 5. 底部快捷栏与状态通知
        footer_y = maxy - 1
        sep_y = maxy - 2
        pad_line(sep_y, 0, "─" * (maxx - 1), curses.A_DIM)

        now = time.time()
        if self.flash_message and (now - self.flash_time < 3.0):
            pad_line(footer_y, 0, f" >>> {self.flash_message}", c_pair(1) | curses.A_BOLD)
        else:
            pad_line(maxy - 1, 0, f" [q] 退出 [r] 刷新 [+/-] 调频 ({self.delay:.1f}s) [g] 守护 [a] 自动继续 [p/c] 暂停/唤醒 [Space] 继续")

    def run_curses(self, stdscr):
        """交互式实时全屏 Curses TUI 运行循环 (高帧率事件响应，拖拽窗口毫秒级跟手)"""
        # 1. 启动后台异步指标采集线程
        self._stop_event.clear()
        self._worker_thread = threading.Thread(target=self._background_collector, daemon=True)
        self._worker_thread.start()

        # 2. Curses 基础设定与防错色彩对齐
        try:
            curses.curs_set(0)
        except Exception:
            pass

        # 显式向终端注销任何鼠标追踪协议（防止终端把鼠标移动当作键盘按键发送）
        sys.stdout.write("\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
        sys.stdout.flush()

        try:
            curses.use_default_colors()
            bg_color = -1
        except Exception:
            bg_color = curses.COLOR_BLACK

        for idx, fg in enumerate([curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED, curses.COLOR_CYAN, curses.COLOR_MAGENTA], 1):
            try:
                curses.init_pair(idx, fg, bg_color)
            except Exception:
                try:
                    curses.init_pair(idx, fg, curses.COLOR_BLACK)
                except Exception:
                    pass

        try:
            curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)   # Title banner
            curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_WHITE)  # Table header
            curses.init_pair(8, curses.COLOR_WHITE, curses.COLOR_RED)    # Alert banner
        except Exception:
            pass

        # 预先拉取一次指标快照，确保首帧 0ms 秒开渲染
        if self._cached_data is None:
            self.get_snapshot()

        # 3. 高帧率事件循环 (30ms 轮询 = ~33FPS，拖拽窗口极致跟手)
        stdscr.nodelay(False)
        stdscr.keypad(True)
        stdscr.timeout(30)
        key_filter = TerminalKeyFilter()

        last_draw_time = 0.0
        needs_redraw = True

        try:
            while True:
                now = time.time()
                try:
                    ch = stdscr.getch()
                except Exception:
                    ch = -1

                ch = key_filter.feed(ch)
                if ch == getattr(curses, "KEY_MOUSE", -2):
                    try:
                        curses.getmouse()
                    except curses.error:
                        pass
                    continue
                if ch in (ord('q'), ord('Q')):
                    break
                elif ch == curses.KEY_RESIZE:
                    # 关键：窗口拖动事件！更新终端尺寸并标记立即重绘 (勿调 resizeterm 避免死循环)
                    try:
                        curses.update_lines_cols()
                    except Exception:
                        pass
                    stdscr.erase()
                    needs_redraw = True
                elif self.handle_control_key(ch):
                    needs_redraw = True
                elif ch in (ord('r'), ord('R')):
                    self.set_flash("正在刷新数据...")
                    self.check_and_reload()
                    self.trigger_background_refresh()
                    needs_redraw = True
                elif ch in (ord('+'), ord('=')):
                    self.delay = max(0.2, self.delay - 0.2)
                    self.set_flash(f"刷新频率调快至: {self.delay:.1f}s")
                    needs_redraw = True
                elif ch in (ord('-'), ord('_')):
                    self.delay = min(10.0, self.delay + 0.5)
                    self.set_flash(f"刷新频率调慢至: {self.delay:.1f}s")
                    needs_redraw = True

                # 每 100ms 刷新界面，或当窗口改变/按键交互时立即重绘 (绝不卡顿)
                if (now - last_draw_time >= 0.1) or needs_redraw:
                    data = self.get_snapshot()
                    maxy, maxx = stdscr.getmaxyx()
                    self.draw_curses_screen(stdscr, data, maxy, maxx)
                    stdscr.refresh()
                    last_draw_time = now
                    needs_redraw = False

        finally:
            self._stop_event.set()
            self._force_refresh_event.set()
            if self._worker_thread:
                self._worker_thread.join(timeout=0.5)
            if self._action_thread:
                self._action_thread.join(timeout=12)
            sys.stdout.write("\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
            sys.stdout.flush()

    def run_ansi_loop(self):
        """ANSI 转义终端持久实时全屏循环 (在 Curses 不可用或无特殊支持时的万能实时保底)"""
        self._stop_event.clear()
        self._worker_thread = threading.Thread(target=self._background_collector, daemon=True)
        self._worker_thread.start()

        sys.stdout.write("\033[?25l\033[?1049h\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")  # 隐藏光标，关闭鼠标追踪
        sys.stdout.flush()
        old_settings = None
        resized = [False]

        def on_sigwinch(signum, frame):
            resized[0] = True

        old_handler = None
        try:
            old_handler = signal.signal(signal.SIGWINCH, on_sigwinch)
        except Exception:
            pass

        try:
            import select
            try:
                import termios
                import tty
                if sys.stdin.isatty():
                    old_settings = termios.tcgetattr(sys.stdin)
                    tty.setcbreak(sys.stdin.fileno())
            except Exception:
                pass

            last_refresh = 0.0
            key_filter = TerminalKeyFilter()
            while True:
                now = time.time()
                if (now - last_refresh >= self.delay) or resized[0]:
                    resized[0] = False
                    sys.stdout.write("\033[H\033[2J")  # 移到屏幕左上角并清屏
                    self.render_batch_from_data(self.get_snapshot(), sys.stdout)
                    last_refresh = now

                # 非阻塞监听按键 (50ms 轮询保证跟手)
                if sys.stdin.isatty():
                    r, _, _ = select.select([sys.stdin], [], [], 0.05)
                    if r:
                        ch = os.read(sys.stdin.fileno(), 1).decode("latin1")
                        key = key_filter.feed(ord(ch)) if ch else -1
                        ch = chr(key) if 0 <= key <= 255 else ''
                        if ch in ('q', 'Q'):
                            break
                        elif self.handle_control_key(key):
                            last_refresh = 0.0
                        elif ch in ('r', 'R'):
                            self.set_flash("正在刷新数据...")
                            self.check_and_reload()
                            self.trigger_background_refresh()
                            last_refresh = 0.0
                        elif ch in ('+', '='):
                            self.delay = max(0.2, self.delay - 0.2)
                            self.set_flash(f"刷新频率调快至: {self.delay:.1f}s")
                            last_refresh = 0.0
                        elif ch in ('-', '_'):
                            self.delay = min(10.0, self.delay + 0.5)
                            self.set_flash(f"刷新频率调慢至: {self.delay:.1f}s")
                            last_refresh = 0.0

                else:
                    # 非 TTY / 管道环境：监听键盘或管道输入，遇到 EOF 或退出键正常退出
                    r, _, _ = select.select([sys.stdin], [], [], 0.05)
                    if r:
                        ch = os.read(sys.stdin.fileno(), 1).decode("latin1")
                        if not ch:
                            break
                        key = key_filter.feed(ord(ch))
                        if key in (ord('q'), ord('Q')):
                            break
                        self.handle_control_key(key)
                    else:
                        time.sleep(0.05)
        except KeyboardInterrupt:
            pass
        finally:
            self._stop_event.set()
            self._force_refresh_event.set()
            if self._worker_thread:
                self._worker_thread.join(timeout=0.5)
            if self._action_thread:
                self._action_thread.join(timeout=12)
            if old_handler is not None:
                try:
                    signal.signal(signal.SIGWINCH, old_handler)
                except Exception:
                    pass
            if old_settings:
                try:
                    import termios
                    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
                except Exception:
                    pass
            sys.stdout.write("\033[?1049l\033[?25h\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
            sys.stdout.flush()


def cmd_top(args):
    """启动类似 top/htop 的实时监控控制台"""
    delay = getattr(args, "delay", 1.0)
    batch = getattr(args, "batch", False)
    prompt = getattr(args, "continue_prompt", "继续")
    dashboard = CodexTopDashboard(delay=delay, continue_prompt=prompt)

    # 1. 显式指定批处理快照模式
    if batch:
        dashboard.render_batch()
        return

    # 2. 交互式持久实时刷新 (类似 top / htop)
    if curses is not None and sys.stdout.isatty():
        try:
            curses.wrapper(dashboard.run_curses)
            return
        except KeyboardInterrupt:
            return
        except Exception:
            # curses 遭遇异常（如终端环境不支持），平滑回退到 ANSI 持续实时循环，绝不单次退出！
            pass

    # 3. ANSI 持久实时刷新循环（保底确保一直动态刷新，按 q 退出）
    dashboard.run_ansi_loop()


def threshold_arg(value):
    result = float(value)
    if not math.isfinite(result) or not 0 <= result < 100:
        raise argparse.ArgumentTypeError("阈值必须在 0（含）到 100（不含）之间")
    return result


def positive_int(value):
    result = int(value)
    if result <= 0:
        raise argparse.ArgumentTypeError("必须是正整数")
    return result


def nonnegative_int(value):
    result = int(value)
    if result < 0:
        raise argparse.ArgumentTypeError("不能为负数")
    return result


def delay_arg(value):
    result = float(value)
    if not math.isfinite(result) or result <= 0:
        raise argparse.ArgumentTypeError("刷新间隔必须为有限正数")
    return result


def main():
    public_command = os.path.basename(sys.argv[0])
    if public_command in ("codexguard-start", "codexguard-stop"):
        public_parser = argparse.ArgumentParser(prog=public_command, allow_abbrev=False,
            description="开启后台守护" if public_command == "codexguard-start" else "关闭后台守护")
        public_parser.parse_args()
        try:
            if public_command == "codexguard-start":
                cmd_guard_start()
            else:
                cmd_guard_stop()
        except (OSError, subprocess.SubprocessError) as error:
            raise SystemExit(f"守护操作失败: {error}")
        return
    parser = argparse.ArgumentParser(
        allow_abbrev=False,
        description="Codex Plus 5h 额度守护神：低于 3% 自动暂停防扣 Credits，恢复后自动唤醒原状并发送「继续」"
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="子命令",
                                     parser_class=lambda **kwargs: argparse.ArgumentParser(allow_abbrev=False, **kwargs))

    # top
    p_top = subparsers.add_parser("top", help="启动类似 top 的交互式实时全屏监控控制台")
    p_top.add_argument("-d", "--delay", type=delay_arg, default=1.0, help="刷新间隔秒数 (默认: 1.0)")
    p_top.add_argument("-b", "--batch", action="store_true", help="单次快照批处理模式 (不进入全屏交互)")
    p_top.add_argument("--continue-prompt", type=str, default="继续", help="恢复或注入的指令 (默认: '继续')")

    # status
    subparsers.add_parser("status", help="查询当前 5h 额度、重置时间及守护状态")

    # sessions
    p_sess = subparsers.add_parser("sessions", help="查看所有 Codex 会话列表与活跃/挂起状态")
    p_sess.add_argument("--limit", type=positive_int, default=15, help="显示数量 (默认: 15)")

    # watch
    p_watch = subparsers.add_parser("watch", help="在前台启动守护监视器")
    p_watch.add_argument("--threshold", type=threshold_arg, default=3.0, help="额度剩余百分比阈值 (默认: 3.0)")
    p_watch.add_argument("--interval", type=positive_int, default=10, help="监控轮询间隔秒数 (默认: 10)")
    p_watch.add_argument("--continue-prompt", type=str, default="继续", help="恢复或空闲时向会话自动发送的指令 (默认: '继续')")
    p_watch.add_argument("--auto-continue", dest="auto_continue", action="store_true", default=True, help="当 Codex 回合结束空闲时自动发送「继续」(默认开启)")
    p_watch.add_argument("--no-auto-continue", dest="auto_continue", action="store_false", help="禁用回合空闲时自动发送「继续」")
    p_watch.add_argument("--idle-delay", type=nonnegative_int, default=5, help="检测到空闲后等待的缓冲秒数 (默认: 5s)")

    # pause
    subparsers.add_parser("pause", help="手动暂停正在运行的 Codex 客户端进程并记录快照")

    # stop / kill / off / disable
    for s_name in ("stop", "kill", "off", "disable"):
        p_stop = subparsers.add_parser(s_name, help="彻底停止 codex-guard 本程序与后台守护服务 (默认保留 Codex 应用)")
        p_stop.add_argument("--disable", action="store_true", help="同时禁用后台守护服务的开机/登录自启")
        p_stop.add_argument("--kill-codex", action="store_true", default=s_name == "kill", help="可选：强制同时终止 Codex 客户端与正在运行的推理任务")
        p_stop.add_argument("--keep-service", action="store_true", help="保留后台守护服务运行")

    # fix-mouse
    subparsers.add_parser("fix-mouse", help="紧急修复终端鼠标读取问题，向当前终端及 Codex 终端注销鼠标追踪协议")

    # resume
    p_resume = subparsers.add_parser("resume", help="手动唤醒被暂停的 Codex 客户端进程或恢复指定 session")
    p_resume.add_argument("session_id", nargs="?", default=None, help="可选：指定恢复的 Session ID")
    p_resume.add_argument("--no-continue", action="store_true", help="唤醒后不发送「继续」指令")
    p_resume.add_argument("--continue-prompt", type=str, default="继续", help="恢复时发送的指令 (默认: '继续')")

    # run
    p_run = subparsers.add_parser("run", help="包装运行 Codex 并自动保护当前任务与会话")
    p_run.add_argument("--threshold", type=threshold_arg, default=3.0, help="额度剩余百分比阈值 (默认: 3.0)")
    p_run.add_argument("--interval", type=positive_int, default=15, help="监控轮询间隔秒数 (默认: 15)")
    p_run.add_argument("--continue-prompt", type=str, default="继续", help="恢复时发送的指令 (默认: '继续')")

    # service
    p_service = subparsers.add_parser("service", help="管理 systemd 守护服务 (install / uninstall / start / stop / restart / status / enable / disable)")
    p_service.add_argument("action", choices=["install", "uninstall", "start", "stop", "restart", "status", "enable", "disable"], help="操作")
    p_service.add_argument("--threshold", type=threshold_arg, default=3.0, help="额度剩余百分比阈值 (默认: 3.0)")
    p_service.add_argument("--interval", type=positive_int, default=10, help="监控轮询间隔秒数 (默认: 10)")
    p_service.add_argument("--continue-prompt", type=str, default="继续", help="恢复或空闲时向会话自动发送的指令 (默认: '继续')")
    p_service.add_argument("--auto-continue", dest="auto_continue", action="store_true", default=True, help="当 Codex 回合结束空闲时自动发送「继续」(默认开启)")
    p_service.add_argument("--no-auto-continue", dest="auto_continue", action="store_false", help="禁用回合空闲时自动发送「继续」")
    p_service.add_argument("--idle-delay", type=nonnegative_int, default=5, help="检测到空闲后等待的缓冲秒数 (默认: 5s)")

    prog_name = os.path.basename(sys.argv[0]).lower()
    if prog_name in ("codex-top", "top"):
        if len(sys.argv) == 1 or sys.argv[1] not in ("top", "-h", "--help"):
            sys.argv.insert(1, "top")
    elif prog_name in ("codex-stop", "stop", "codex-kill", "kill"):
        if len(sys.argv) == 1 or sys.argv[1] not in ("stop", "kill", "off", "disable", "-h", "--help"):
            sys.argv.insert(1, "kill" if prog_name in ("codex-kill", "kill") else "stop")
    elif prog_name in ("codex-fix-mouse", "fix-mouse"):
        if len(sys.argv) == 1 or sys.argv[1] not in ("fix-mouse", "-h", "--help"):
            sys.argv.insert(1, "fix-mouse")

    # 如果无子命令，默认使用 status
    if len(sys.argv) == 1:
        cmd_status(None)
        return

    known_cmds = ["top", "status", "sessions", "watch", "pause", "stop", "kill", "off", "disable", "fix-mouse", "resume", "run", "service", "-h", "--help"]
    if sys.argv[1] not in known_cmds:
        args, unknown = parser.parse_known_args(["run"] + sys.argv[1:])
        cmd_run(args, unknown)
        return

    args, unknown = parser.parse_known_args()
    if unknown and args.subcommand != "run":
        parser.error("无法识别参数: " + " ".join(unknown))

    if args.subcommand == "top":
        cmd_top(args)
    elif args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "sessions":
        cmd_sessions(args)
    elif args.subcommand == "watch":
        cmd_watch(args)
    elif args.subcommand == "pause":
        cmd_pause(args)
    elif args.subcommand in ("stop", "kill", "off", "disable"):
        cmd_stop(args)
    elif args.subcommand == "fix-mouse":
        cmd_fix_mouse(args)
    elif args.subcommand == "resume":
        cmd_resume(args)
    elif args.subcommand == "run":
        cmd_run(args, unknown)
    elif args.subcommand == "service":
        cmd_service(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
