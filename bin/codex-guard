#!/usr/bin/env python3
"""
Codex Plus 5h Quota Guard (额度守护神)
=====================================
自动检测 Codex 5小时订阅额度。当 5h 额度低于设定阈值（默认 3%）时：
1. 自动暂停/挂起 Codex 执行以避免消耗付费 Credits；
2. 完整快照并保存当前会话（Session）与会话列表元数据；
3. 待 5h 额度刷新恢复后，自动拉起/唤醒 Codex，自动向会话发送「继续」指令，
   并完整恢复原状（包括活跃会话上下文、会话锁及会话列表）。
"""

import os
import sys
import time
import socket
import select
import base64
import struct
import json
import signal
import glob
import sqlite3
import subprocess
import argparse
import threading
import shutil
import shlex
try:
    import curses
except ImportError:
    curses = None
from datetime import datetime
from typing import Optional, Dict, Any, List, Tuple

LOG_FILE = os.path.expanduser("~/.codex/quota_guard.log")
SNAPSHOT_FILE = os.path.expanduser("~/.codex/quota_guard_snapshot.json")
SERVICE_NAME = "codex-quota-guard"
SERVICE_FILE = os.path.expanduser(f"~/.config/systemd/user/{SERVICE_NAME}.service")


def log(msg: str, print_to_stdout: bool = True):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    formatted = f"[{timestamp}] {msg}"
    if print_to_stdout:
        print(formatted, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(formatted + "\n")
    except Exception:
        pass


def get_gui_env() -> Dict[str, str]:
    """动态检索当前系统活跃桌面会话的图形环境变量 (含 Wayland, Xwayland 授权凭据与 DBus 路径)"""
    uid = os.getuid()
    env = os.environ.copy()

    # 1. 尝试从运行中的桌面会话进程中读取真实完整的图形环境
    gui_procs = ['gnome-shell', 'mutter', 'kwin', 'sway', 'hyprland', 'xfce4-session', 'plasmashell', 'nautilus', 'Xwayland']
    found = {}
    for pid_dir in glob.glob('/proc/[0-9]*'):
        try:
            with open(f'{pid_dir}/cmdline', 'rb') as f:
                cmd = f.read().decode('utf-8', errors='ignore')
            if any(p in cmd for p in gui_procs):
                with open(f'{pid_dir}/environ', 'rb') as f:
                    for item in f.read().split(b'\0'):
                        if b'=' in item:
                            k, v = item.split(b'=', 1)
                            ks = k.decode('utf-8', errors='ignore')
                            if ks in ('DISPLAY', 'WAYLAND_DISPLAY', 'XAUTHORITY', 'DBUS_SESSION_BUS_ADDRESS', 'XDG_RUNTIME_DIR'):
                                found[ks] = v.decode('utf-8', errors='ignore')
                if 'XAUTHORITY' in found or 'WAYLAND_DISPLAY' in found:
                    break
        except Exception:
            continue

    env.update(found)

    # 2. 如果缺少 XAUTHORITY，自动检索 /run/user/{uid}/.mutter-Xwaylandauth.* 或 ~/.Xauthority
    if 'XAUTHORITY' not in env or not os.path.exists(env['XAUTHORITY']):
        mutter_auth = glob.glob(f'/run/user/{uid}/.mutter-Xwaylandauth.*')
        if mutter_auth and os.path.exists(mutter_auth[0]):
            env['XAUTHORITY'] = mutter_auth[0]
        elif os.path.exists(os.path.expanduser('~/.Xauthority')):
            env['XAUTHORITY'] = os.path.expanduser('~/.Xauthority')

    # 3. 如果缺少 WAYLAND_DISPLAY，自动检索 /run/user/{uid}/wayland-*
    if 'WAYLAND_DISPLAY' not in env:
        wayland_socks = glob.glob(f'/run/user/{uid}/wayland-[0-9]*')
        if wayland_socks:
            env['WAYLAND_DISPLAY'] = os.path.basename(wayland_socks[0])

    if 'DISPLAY' not in env:
        env['DISPLAY'] = ':0'
    if 'XDG_RUNTIME_DIR' not in env:
        env['XDG_RUNTIME_DIR'] = f'/run/user/{uid}'
    if 'DBUS_SESSION_BUS_ADDRESS' not in env:
        bus = f'/run/user/{uid}/bus'
        if os.path.exists(bus):
            env['DBUS_SESSION_BUS_ADDRESS'] = f'unix:path={bus}'

    return env


def send_notification(title: str, message: str, urgency: str = "normal"):
    """发送系统桌面通知 (通过 notify-send)"""
    env = get_gui_env()
    try:
        subprocess.run(
            ["notify-send", "-a", "Codex Quota Guard", "-u", urgency, title, message],
            env=env,
            timeout=5,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


class CodexSocketClient:
    """与 Codex App-Server Daemon 进行 WebSocket 通信的轻量客户端"""

    @staticmethod
    def get_socket_path() -> Optional[str]:
        # 1. 优先尝试 ~/.codex/app-server-control/app-server-control.sock
        default_link = os.path.expanduser("~/.codex/app-server-control/app-server-control.sock")
        if os.path.exists(default_link):
            return os.path.realpath(default_link)

        # 2. 搜索 /tmp/codex-daemon-* 下的 socket
        candidates = glob.glob(f"/tmp/codex-daemon-{os.getuid()}/*")
        for cand in candidates:
            try:
                mode = os.stat(cand).st_mode
                import stat
                if stat.S_ISSOCK(mode):
                    return cand
            except OSError:
                pass
        return None

    @classmethod
    def ensure_daemon_running(cls) -> bool:
        sock_path = cls.get_socket_path()
        if sock_path and os.path.exists(sock_path):
            return True
        try:
            # 尝试自启动 daemon
            subprocess.run(
                ["codex", "app-server", "daemon", "start"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
            time.sleep(1)
            sock_path = cls.get_socket_path()
            return sock_path is not None and os.path.exists(sock_path)
        except Exception:
            return False

    @classmethod
    def query_app_server(cls, method: str, params: Optional[Dict[str, Any]] = None, timeout: float = 6.0) -> Optional[Any]:
        if not cls.ensure_daemon_running():
            return None

        sock_path = cls.get_socket_path()
        if not sock_path:
            return None

        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        try:
            s.connect(sock_path)

            # 1. WebSocket 握手
            key = base64.b64encode(os.urandom(16)).decode("utf-8")
            req = (
                f"GET / HTTP/1.1\r\n"
                f"Host: localhost\r\n"
                f"Upgrade: websocket\r\n"
                f"Connection: Upgrade\r\n"
                f"Sec-WebSocket-Key: {key}\r\n"
                f"Sec-WebSocket-Version: 13\r\n\r\n"
            )
            s.sendall(req.encode("utf-8"))

            resp_header = b""
            while b"\r\n\r\n" not in resp_header:
                chunk = s.recv(512)
                if not chunk:
                    return None
                resp_header += chunk

            def send_frame(payload_str: str):
                data = payload_str.encode("utf-8")
                length = len(data)
                mask = os.urandom(4)
                hdr = bytearray([0x81])
                if length <= 125:
                    hdr.append(0x80 | length)
                elif length <= 65535:
                    hdr.append(0x80 | 126)
                    hdr.extend(struct.pack("!H", length))
                else:
                    hdr.append(0x80 | 127)
                    hdr.extend(struct.pack("!Q", length))
                hdr.extend(mask)
                masked = bytearray(data[i] ^ mask[i % 4] for i in range(length))
                s.sendall(hdr + masked)

            def recv_exact(n: int) -> Optional[bytes]:
                b = bytearray()
                while len(b) < n:
                    chunk = s.recv(n - len(b))
                    if not chunk:
                        return None
                    b.extend(chunk)
                return bytes(b)

            def recv_frame():
                header = recv_exact(2)
                if not header or len(header) < 2:
                    return None, None
                b1, b2 = header[0], header[1]
                opcode = b1 & 0x0F
                is_masked = (b2 & 0x80) != 0
                length = b2 & 0x7F
                if length == 126:
                    ext = recv_exact(2)
                    if not ext or len(ext) < 2:
                        return None, None
                    length = struct.unpack("!H", ext)[0]
                elif length == 127:
                    ext = recv_exact(8)
                    if not ext or len(ext) < 8:
                        return None, None
                    length = struct.unpack("!Q", ext)[0]

                mask = recv_exact(4) if is_masked else None
                buf = recv_exact(length)
                if buf is None:
                    return None, None
                if is_masked and mask:
                    buf = bytearray(buf[i] ^ mask[i % 4] for i in range(len(buf)))
                return opcode, bytes(buf)

            # 2. 发送 initialize
            send_frame(json.dumps({
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {"name": "quota-guard", "title": "quota-guard", "version": "1.0"},
                    "capabilities": {"experimentalApi": True, "requestAttestation": False}
                }
            }))

            start_t = time.time()
            while time.time() - start_t < 3:
                _, data = recv_frame()
                if not data:
                    break
                try:
                    msg = json.loads(data.decode("utf-8"))
                    if msg.get("id") == 1:
                        break
                except Exception:
                    continue

            # 3. 发送请求
            send_frame(json.dumps({
                "id": 2,
                "method": method,
                "params": params or {}
            }))

            while time.time() - start_t < timeout:
                _, data = recv_frame()
                if not data:
                    break
                try:
                    msg = json.loads(data.decode("utf-8"))
                    if msg.get("id") == 2:
                        return msg.get("result", {})
                except Exception:
                    continue

            return None
        except Exception:
            return None
        finally:
            try:
                s.close()
            except Exception:
                pass

    @classmethod
    def query_rate_limits(cls, timeout: float = 6.0) -> Optional[Dict[str, Any]]:
        return cls.query_app_server("account/rateLimits/read", {}, timeout)

    @classmethod
    def query_loaded_threads(cls, timeout: float = 4.0) -> List[str]:
        res = cls.query_app_server("thread/loaded/list", {}, timeout)
        if isinstance(res, dict) and "data" in res:
            return res["data"]
        return []


class QuotaSnapshot:
    """格式化后的 Codex 额度快照"""

    def __init__(self, raw_data: Optional[Dict[str, Any]]):
        self.raw = raw_data or {}
        rl = self.raw.get("rateLimits", {})
        self.plan_type = rl.get("planType") or "unknown"
        self.has_credits = rl.get("credits", {}).get("hasCredits", False)
        self.credit_balance = rl.get("credits", {}).get("balance", "0.0")

        # 查找 5 小时窗口 (windowDurationMins == 300)
        p = rl.get("primary") or {}
        s = rl.get("secondary") or {}

        w5 = None
        if p.get("windowDurationMins") == 300:
            w5 = p
            self.weekly_window = s
        elif s.get("windowDurationMins") == 300:
            w5 = s
            self.weekly_window = p
        else:
            w5 = p
            self.weekly_window = s

        self.used_percent: float = float(w5.get("usedPercent", 0))
        self.remaining_percent: float = max(0.0, 100.0 - self.used_percent)
        self.resets_at: int = int(w5.get("resetsAt", 0))
        self.window_duration_mins: int = int(w5.get("windowDurationMins", 300))

    @property
    def seconds_until_reset(self) -> float:
        if self.resets_at <= 0:
            return 0.0
        return max(0.0, float(self.resets_at - time.time()))

    @property
    def reset_datetime_str(self) -> str:
        if self.resets_at <= 0:
            return "未知"
        return datetime.fromtimestamp(self.resets_at).strftime("%Y-%m-%d %H:%M:%S")

    @property
    def time_to_reset_str(self) -> str:
        secs = int(self.seconds_until_reset)
        if secs <= 0:
            return "已到期/即将刷新"
        hours = secs // 3600
        mins = (secs % 3600) // 60
        if hours > 0:
            return f"{hours}小时 {mins}分钟"
        return f"{mins}分钟 ({secs}秒)"


class SessionManager:
    """会话生命周期与列表恢复管理器"""

    DB_PATH = os.path.expanduser("~/.codex/state_5.sqlite")
    LOCK_DIR = os.path.expanduser("~/.codex/thread-writer-locks")
    INDEX_FILE = os.path.expanduser("~/.codex/session_index.jsonl")

    @classmethod
    def get_loaded_thread_ids(cls) -> List[str]:
        """获取当前正在加载中的活跃会话 ID 列表"""
        # 1. 优先尝试从 app-server 查询
        threads = CodexSocketClient.query_loaded_threads()
        if threads:
            return threads
        # 2. 从 writer lock 文件检索
        if os.path.exists(cls.LOCK_DIR):
            res = []
            for f in os.listdir(cls.LOCK_DIR):
                if f.endswith(".lock") and not f.startswith("."):
                    res.append(f[:-5])
            return res
        return []

    @classmethod
    def get_db_connection(cls) -> Optional[sqlite3.Connection]:
        """安全建立只读模式 SQLite 连接 (超时 10s，避免与 app-server 写操作互锁)"""
        if not os.path.exists(cls.DB_PATH):
            return None
        try:
            real_path = os.path.realpath(cls.DB_PATH)
            return sqlite3.connect(f"file:{real_path}?mode=ro", uri=True, timeout=10.0)
        except Exception:
            try:
                return sqlite3.connect(cls.DB_PATH, timeout=10.0)
            except Exception:
                return None

    @classmethod
    def get_thread_info(cls, thread_id: str) -> Optional[Dict[str, Any]]:
        """获取指定会话的完整元数据"""
        conn = cls.get_db_connection()
        if not conn:
            return None
        try:
            c = conn.cursor()
            c.execute(
                "SELECT id, title, cwd, updated_at, source, model FROM threads WHERE id = ?",
                (thread_id,)
            )
            row = c.fetchone()
            conn.close()
            if row:
                return {
                    "id": row[0],
                    "title": row[1] or "(未命名任务)",
                    "cwd": row[2],
                    "updated_at": row[3],
                    "source": row[4],
                    "model": row[5]
                }
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
        return None

    @classmethod
    def is_subagent(cls, thread_id: str) -> bool:
        """判断是否为多智能体架构衍生的子代理 (Sub-Agent，不支持直接接收用户输入或单独拉起)"""
        info = cls.get_thread_info(thread_id)
        if not info:
            return False
        source = str(info.get("source") or "")
        return "subagent" in source.lower()

    @classmethod
    def get_root_thread_id(cls, thread_id: str) -> str:
        """如果目标 thread_id 是子代理，溯源并返回其所属根会话 parent_thread_id；否则返回自身"""
        info = cls.get_thread_info(thread_id)
        if not info:
            return thread_id
        source = str(info.get("source") or "")
        if "parent_thread_id" in source:
            try:
                data = json.loads(source)
                parent = data.get("subagent", {}).get("thread_spawn", {}).get("parent_thread_id")
                if parent:
                    return cls.get_root_thread_id(parent)
            except Exception:
                pass
        return thread_id

    @classmethod
    def get_live_thread_state(cls, thread_id: str) -> Dict[str, Any]:
        """获取指定会话的实时运行状态（status, turns 等）"""
        res = CodexSocketClient.query_app_server("thread/read", {"threadId": thread_id, "includeTurns": True})
        if not res or not isinstance(res, dict):
            return {}
        thread = res.get("thread", {})
        status = thread.get("status", {})
        status_type = status.get("type") if isinstance(status, dict) else str(status)
        turns = thread.get("turns", [])
        last_turn = turns[-1] if turns else {}
        return {
            "status_type": status_type,
            "turns_count": len(turns),
            "last_turn_id": last_turn.get("id"),
            "last_turn_status": last_turn.get("status"),
        }

    @classmethod
    def get_recent_sessions(cls, limit: int = 15) -> List[Dict[str, Any]]:
        """从 SQLite 获取最近的会话列表"""
        conn = cls.get_db_connection()
        if not conn:
            return []
        try:
            c = conn.cursor()
            c.execute(
                """SELECT id, title, cwd, updated_at, source, model, archived
                   FROM threads 
                   WHERE archived = 0 AND (source IS NULL OR source NOT LIKE '%subagent%')
                   ORDER BY updated_at DESC 
                   LIMIT ?""",
                (limit,)
            )
            rows = c.fetchall()
            conn.close()
            res = []
            for r in rows:
                res.append({
                    "id": r[0],
                    "title": r[1] or "(未命名任务)",
                    "cwd": r[2],
                    "updated_at": r[3],
                    "source": r[4],
                    "model": r[5],
                    "archived": bool(r[6])
                })
            return res
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
            return []

    @classmethod
    def interrupt_active_turns(cls) -> List[Dict[str, Any]]:
        """主动掐断所有正在运行中的 Turn（向 Codex App-Server 发送 turn/interrupt），
        立即中止云端模型推理、Token 消耗及工具执行，彻底杜绝额度偷跑！
        返回被中断的 turn 列表: [{'threadId': tid, 'turnId': turn_id, 'title': ...}]
        """
        interrupted = []
        loaded_ids = cls.get_loaded_thread_ids()
        for tid in loaded_ids:
            try:
                res = CodexSocketClient.query_app_server("thread/read", {"threadId": tid, "includeTurns": True})
                if not res or not isinstance(res, dict):
                    continue
                thread = res.get("thread", {})
                status = thread.get("status", {})
                status_type = status.get("type") if isinstance(status, dict) else str(status)
                turns = thread.get("turns", [])
                if turns:
                    last_turn = turns[-1]
                    turn_st = last_turn.get("status")
                    turn_id = last_turn.get("id")
                    if turn_st == "inProgress" or status_type not in ("idle", "notLoaded", None):
                        if turn_id:
                            CodexSocketClient.query_app_server("turn/interrupt", {"threadId": tid, "turnId": turn_id})
                            tinfo = cls.get_thread_info(tid)
                            title = tinfo.get("title", tid[:8]) if tinfo else tid[:8]
                            log(f"🛑 [额度拦截] 已掐断会话 [{title}] (Turn #{len(turns)}) 的后台运行: 已向 App-Server 发送 turn/interrupt！OpenAI Token 消耗已彻底终止。")
                            interrupted.append({
                                "threadId": tid,
                                "turnId": turn_id,
                                "title": title,
                                "turns_count": len(turns)
                            })
            except Exception as e:
                log(f"掐断会话 [{tid[:8]}] 异常: {e}")
        return interrupted

    @classmethod
    def kill_orphaned_tool_subprocesses(cls):
        """检查并清理 Codex 衍生出来的子工具进程（例如正在运行的脚本或编译任务）"""
        def get_descendants(parent_pid: int) -> List[int]:
            try:
                res = subprocess.run(["pgrep", "-P", str(parent_pid)], capture_output=True, text=True, timeout=1)
                children = [int(p) for p in res.stdout.strip().split() if p]
                desc = list(children)
                for c in children:
                    desc.extend(get_descendants(c))
                return desc
            except Exception:
                return []

        for pid_dir in glob.glob("/proc/[0-9]*"):
            try:
                pid = int(os.path.basename(pid_dir))
                cmdline_path = os.path.join(pid_dir, "cmdline")
                if not os.path.exists(cmdline_path):
                    continue
                with open(cmdline_path, "rb") as f:
                    content = f.read().decode("utf-8", errors="ignore")
                if "code-mode-host" in content:
                    descendants = get_descendants(pid)
                    # 从底层叶子节点向上清理
                    for cpid in reversed(descendants):
                        try:
                            with open(f"/proc/{cpid}/cmdline", "rb") as f:
                                c_cmd = f.read().decode("utf-8", errors="ignore")
                            if "code-mode" in c_cmd:
                                continue
                            os.kill(cpid, signal.SIGTERM)
                            log(f"已终止 Codex 遗留子工具进程 PID: {cpid}")
                        except Exception:
                            pass
            except Exception:
                continue

    @classmethod
    def save_snapshot(cls, active_pids: List[int], reason: str = "quota_low", interrupted_turns: Optional[List[Dict[str, Any]]] = None) -> Dict[str, Any]:
        """暂停前保存活跃会话与列表快照"""
        loaded_ids = cls.get_loaded_thread_ids()
        sessions = []
        for tid in loaded_ids:
            info = cls.get_thread_info(tid)
            if info:
                sessions.append(info)

        snapshot = {
            "timestamp": time.time(),
            "datetime": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "reason": reason,
            "active_pids": active_pids,
            "loaded_thread_ids": loaded_ids,
            "sessions": sessions,
            "interrupted_turns": interrupted_turns or [],
        }

        try:
            with open(SNAPSHOT_FILE, "w", encoding="utf-8") as f:
                json.dump(snapshot, f, ensure_ascii=False, indent=2)
            log(f"已保存会话快照: {len(sessions)} 个活跃会话 (PIDs: {active_pids}), 中断了 {len(interrupted_turns or [])} 个正在运行的回合")
        except Exception as e:
            log(f"保存会话快照失败: {e}")

        return snapshot

    @classmethod
    def clean_stale_locks(cls):
        """检查并清理无进程持有的死锁文件，防止会话恢复时报被占用错误"""
        if not os.path.exists(cls.LOCK_DIR):
            return
        for fname in os.listdir(cls.LOCK_DIR):
            if not fname.endswith(".lock") or fname.startswith("."):
                continue
            lpath = os.path.join(cls.LOCK_DIR, fname)
            try:
                # 检查是否有活跃进程持有此锁
                res = subprocess.run(["fuser", lpath], capture_output=True, text=True, timeout=1)
                pids = res.stdout.strip().split()
                if not pids and not res.stderr.strip():
                    os.remove(lpath)
                    log(f"清理无进程持有的会话锁: {fname}")
            except Exception:
                pass

    @classmethod
    def send_continue_prompt(cls, thread_id: str, prompt: str = "继续") -> bool:
        """使用 codex queue 向指定会话发送消息（例如 '继续'）触发自动继续工作"""
        if cls.is_subagent(thread_id):
            log(f"跳过向子代理 [{thread_id[:8]}...] 发送指令: 多智能体 v2 子代理不接受直接外部队列输入。")
            return False
        try:
            res = subprocess.run(
                ["codex", "queue", "--thread", thread_id, "--message", prompt],
                capture_output=True,
                text=True,
                timeout=10,
            )
            if res.returncode == 0:
                log(f"已成功向会话 [{thread_id[:8]}...] 发送指令: '{prompt}'")
                return True
            else:
                err_msg = res.stderr.strip() or res.stdout.strip()
                log(f"向会话 [{thread_id[:8]}...] 发送指令失败: {err_msg}")
                return False
        except Exception as e:
            log(f"向会话 [{thread_id[:8]}...] 发送指令异常: {e}")
            return False

    @classmethod
    def launch_codex_session(cls, session_id: str, prompt: str = "继续") -> bool:
        """自动拉起并恢复指定的 Codex 会话 (优先弹出桌面终端窗口，无图形环境则回退后台终端)"""
        # 解析根会话，避免在子代理上直接拉起
        session_id = cls.get_root_thread_id(session_id)

        # 获取系统完整图形环境变量 (含 Wayland / Xwayland 授权凭据及 DBus 路径)
        env = get_gui_env()

        codex_bin = shutil.which("codex") or os.path.expanduser("~/.local/bin/codex")
        safe_bin = shlex.quote(codex_bin)
        safe_sid = shlex.quote(session_id)
        safe_prompt = shlex.quote(prompt)
        bash_cmd = f"{safe_bin} resume {safe_sid} {safe_prompt}; exec bash"

        # 1. 尝试在 GNOME 终端中打开独立交互窗口拉起
        try:
            cmd = [
                "gnome-terminal",
                f"--title=Codex - 自动恢复任务 [{session_id[:8]}]",
                "--",
                "bash", "-c", bash_cmd
            ]
            res = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                log(f"🚀 [自动拉起] 已在 GNOME 终端中自动拉起 Codex 会话 [{session_id[:8]}...]！")
                return True
            else:
                err_msg = res.stderr.strip() or res.stdout.strip()
                log(f"gnome-terminal 退出异常 (code {res.returncode}): {err_msg}，尝试其他终端...")
        except Exception as e:
            log(f"gnome-terminal 拉起失败: {e}，尝试其他终端...")

        # 2. 尝试 x-terminal-emulator
        try:
            xterm_cmd = ["x-terminal-emulator", "-T", f"Codex - 自动恢复任务 [{session_id[:8]}]", "-e", f"bash -c {shlex.quote(bash_cmd)}"]
            res = subprocess.run(xterm_cmd, env=env, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                log(f"🚀 [自动拉起] 已在 x-terminal-emulator 中自动拉起 Codex 会话 [{session_id[:8]}...]！")
                return True
            else:
                err_msg = res.stderr.strip() or res.stdout.strip()
                log(f"x-terminal-emulator 退出异常 (code {res.returncode}): {err_msg}")
        except Exception as e:
            log(f"x-terminal-emulator 拉起失败: {e}")

        # 3. 回退到 screen 后台会话拉起
        try:
            screen_cmd = ["screen", "-dmS", f"codex-{session_id[:8]}", codex_bin, "resume", session_id, prompt]
            res = subprocess.run(screen_cmd, env=env, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                log(f"🚀 [自动拉起] 已在 screen 后台终端中自动拉起 Codex 会话 [{session_id[:8]}...]！")
                return True
        except Exception as e:
            log(f"screen 拉起失败: {e}")

        # 4. 终极保底: nohup 后台启动
        try:
            nohup_cmd = ["nohup", codex_bin, "resume", session_id, prompt]
            subprocess.Popen(nohup_cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            log(f"🚀 [自动拉起] 已在 nohup 后台进程中自动拉起 Codex 会话 [{session_id[:8]}...]！")
            return True
        except Exception as e:
            log(f"nohup 拉起失败: {e}")

        return False

    @classmethod
    def restore_and_verify_sessions(cls, resumed_pids: List[int], send_continue: bool = True, continue_prompt: str = "继续", exclude_thread_ids: Optional[List[str]] = None) -> Dict[str, Any]:
        """额度恢复时：唤醒进程、验证会话状态、确保会话列表完整原状，并自动发送「继续」指令"""
        cls.clean_stale_locks()

        # 等待 1.5 秒让 Codex 进程与 App-Server 完成 socket 重建与状态恢复
        time.sleep(1.5)

        # 读取暂停时的快照
        snapshot = {}
        if os.path.exists(SNAPSHOT_FILE):
            try:
                with open(SNAPSHOT_FILE, "r", encoding="utf-8") as f:
                    snapshot = json.load(f)
            except Exception:
                pass

        saved_sessions = snapshot.get("sessions", [])
        interrupted_turns = snapshot.get("interrupted_turns", [])
        loaded_now = cls.get_loaded_thread_ids()

        target_thread_ids = set()
        for sess in saved_sessions:
            if sess.get("id"):
                target_thread_ids.add(cls.get_root_thread_id(sess["id"]))
        for iturn in interrupted_turns:
            if iturn.get("threadId"):
                target_thread_ids.add(cls.get_root_thread_id(iturn["threadId"]))
        for tid in loaded_now:
            target_thread_ids.add(cls.get_root_thread_id(tid))

        # 排除多智能体架构子代理
        target_thread_ids = {tid for tid in target_thread_ids if not cls.is_subagent(tid)}

        exclude_set = set(exclude_thread_ids or [])
        restored_details = []
        for tid in target_thread_ids:
            info = cls.get_thread_info(tid)
            title = info.get("title", "(未命名任务)") if info else "(未命名任务)"
            cwd = info.get("cwd") if info else None
            is_loaded = tid in loaded_now

            queued = False
            if send_continue:
                if tid in exclude_set:
                    log(f"会话 [{title}] (ID: {tid[:8]}...) 已作为新终端会话启动，跳过重复队列注入。")
                    queued = True
                else:
                    queued = cls.send_continue_prompt(tid, continue_prompt)

            restored_details.append({
                "id": tid,
                "title": title,
                "cwd": cwd,
                "is_loaded": is_loaded,
                "continued": queued
            })

        log(f"会话状态校验与自动继续完成: 唤醒了 {len(resumed_pids)} 个进程，已向 {len(restored_details)} 个活跃会话自动发送「{continue_prompt}」。")
        for d in restored_details:
            log(f"  • 会话 [{d['title']}] (ID: {d['id'][:8]}...) -> 状态: {'活跃并载入中' if d['is_loaded'] else '就绪'} | 发送「{continue_prompt}」: {'成功' if d.get('continued') else '未发送/跳过'}")

        return {
            "resumed_pids": resumed_pids,
            "sessions": restored_details
        }


class ProcessManager:
    """管理并监测本机上的 Codex 客户端进程"""

    @staticmethod
    def is_codex_client(parts: List[str]) -> bool:
        """精准判定给定的命令行 parts 是否为一个合法的 Codex 用户交互/运行客户端进程，
        严格排除内部 daemon/helper、本工具自身，且绝不会因为用户 Prompt 或路径包含 'codex-guard' 等关键字而误排除！
        """
        if not parts:
            return False

        exe = parts[0]
        exe_base = os.path.basename(exe).lower()

        # 1. 快速排除本工具自身 (codex-guard, codex-top, codex-quota)
        if any(tool in exe_base for tool in ("codex-guard", "codex-top", "codex-quota")):
            return False
        if len(parts) > 1 and any(tool in os.path.basename(parts[1]).lower() for tool in ("codex-guard", "codex-top", "codex-quota")):
            return False

        # 2. 快速排除内部 helper (如 codex-code-mode-host)
        if "code-mode-host" in exe_base:
            return False

        # 3. 判定是否为 codex 主程序调用
        is_codex = False
        subcmd_idx = 1

        if "codex" in exe_base:
            is_codex = True
            subcmd_idx = 1
        else:
            # 处理通过解释器或启动器调用的情况 (例如 python3 /path/to/codex, env codex, etc.)
            for idx in (1, 2):
                if idx < len(parts) and "codex" in os.path.basename(parts[idx]).lower():
                    cand = os.path.basename(parts[idx]).lower()
                    if not any(tool in cand for tool in ("codex-guard", "codex-top", "codex-quota")):
                        is_codex = True
                        subcmd_idx = idx + 1
                        break

        if not is_codex:
            return False

        # 4. 排除 codex 自身的内部子命令 (app-server, daemon)
        if subcmd_idx < len(parts):
            subcmd = parts[subcmd_idx].lower()
            if subcmd in ("app-server", "daemon", "internal-daemon"):
                return False

        return True

    @classmethod
    def get_codex_client_pids(cls) -> List[Tuple[int, str, str]]:
        """获取所有正在运行的 Codex 客户端进程 (排除 daemon, helper 和自身)
        返回: [(pid, state, cmdline)]
        state: 'T' 为已被挂起暂停, 'S'/'R' 为正在运行
        """
        my_pid = os.getpid()
        results = []
        for pid_dir in glob.glob("/proc/[0-9]*"):
            try:
                pid = int(os.path.basename(pid_dir))
                if pid == my_pid:
                    continue
                cmdline_path = os.path.join(pid_dir, "cmdline")
                if not os.path.exists(cmdline_path):
                    continue
                with open(cmdline_path, "rb") as f:
                    content = f.read().decode("utf-8", errors="ignore")
                parts = [p for p in content.split("\0") if p]
                if not parts:
                    continue

                if not cls.is_codex_client(parts):
                    continue

                cmd_full = " ".join(parts)

                # 读取状态
                stat_path = os.path.join(pid_dir, "stat")
                with open(stat_path, "r") as f:
                    stat_parts = f.read().split()
                    state = stat_parts[2]  # R, S, D, Z, T

                results.append((pid, state, cmd_full))
            except (ValueError, FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        return results

    @staticmethod
    def _disable_tty_mouse(pid: int):
        """向目标进程关联的伪终端发送转义指令，禁用鼠标追踪上报，防止进程暂停后鼠标移动乱码"""
        for fd_num in (0, 1, 2):
            fd_link = f"/proc/{pid}/fd/{fd_num}"
            if os.path.exists(fd_link):
                try:
                    target = os.path.realpath(fd_link)
                    if target.startswith("/dev/pts/") or target.startswith("/dev/tty"):
                        with open(target, "wb", buffering=0) as f:
                            f.write(b"\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
                        return
                except Exception:
                    pass

    @staticmethod
    def suspend_pid(pid: int) -> bool:
        try:
            ProcessManager._disable_tty_mouse(pid)
            os.kill(pid, signal.SIGSTOP)
            return True
        except ProcessLookupError:
            return False
        except Exception as e:
            log(f"暂停 PID {pid} 失败: {e}")
            return False

    @staticmethod
    def resume_pid(pid: int) -> bool:
        try:
            os.kill(pid, signal.SIGCONT)
            return True
        except ProcessLookupError:
            return False
        except Exception as e:
            log(f"恢复 PID {pid} 失败: {e}")
            return False


def cmd_status(args):
    """显示当前额度及守护状态"""
    data = CodexSocketClient.query_rate_limits()
    if not data:
        print("\033[31m[错误] 无法连接到 Codex App-Server Daemon，请确保 Codex 已安装并启动。\033[0m")
        sys.exit(1)

    snap = QuotaSnapshot(data)
    pids = ProcessManager.get_codex_client_pids()
    loaded_threads = SessionManager.get_loaded_thread_ids()

    # 颜色设定
    green = "\033[32m"
    yellow = "\033[33m"
    red = "\033[31m"
    cyan = "\033[36m"
    bold = "\033[1m"
    reset = "\033[0m"

    if snap.remaining_percent <= 3.0:
        quota_color = red
        status_text = f"{red}🚨 额度极低 (< 3%)！守护拦截激活{reset}"
    elif snap.remaining_percent <= 10.0:
        quota_color = yellow
        status_text = f"{yellow}⚠️ 额度偏低 (3% - 10%){reset}"
    else:
        quota_color = green
        status_text = f"{green}🟢 额度充足{reset}"

    print(f"\n{bold}{cyan}============================================================{reset}")
    print(f"{bold}{cyan}              Codex Plus 5h 额度守护状态监控               {reset}")
    print(f"{bold}{cyan}============================================================{reset}")
    print(f"订阅计划:        {bold}{snap.plan_type.upper()}{reset}")
    print(f"5小时额度窗口:   {quota_color}已用 {snap.used_percent:.1f}% | 剩余 {snap.remaining_percent:.1f}%{reset} (窗口时长: {snap.window_duration_mins} 分钟)")
    print(f"重置时间:        {bold}{snap.reset_datetime_str}{reset} (距离刷新还有: {snap.time_to_reset_str})")

    if snap.weekly_window:
        w_used = float(snap.weekly_window.get("usedPercent", 0))
        w_rem = max(0.0, 100.0 - w_used)
        print(f"周额度窗口:      已用 {w_used:.1f}% | 剩余 {w_rem:.1f}%")

    print(f"额外 Credits:    {snap.credit_balance} ({'已充值但避免消耗' if snap.has_credits else '无额度'})")
    print(f"守护触发阈值:    低于 {bold}3.0%{reset} 自动暂停")
    print(f"当前额度评估:    {status_text}")
    print(f"{cyan}------------------------------------------------------------{reset}")

    if not pids:
        print("当前运行中进程:  无正在运行的 Codex 客户端进程")
    else:
        print(f"受守护进程 ({len(pids)} 个):")
        for p, st, cmd in pids:
            st_desc = f"{red}已暂停 (STOPPED){reset}" if st == "T" else f"{green}运行中 (RUNNING){reset}"
            cmd_preview = cmd if len(cmd) <= 45 else cmd[:42] + "..."
            print(f"  • PID {bold}{p}{reset} [{st_desc}] : {cmd_preview}")

    # 显示当前活跃会话
    if loaded_threads:
        print(f"\n当前活跃会话 (已锁定载入):")
        for tid in loaded_threads:
            info = SessionManager.get_thread_info(tid)
            live = SessionManager.get_live_thread_state(tid)
            st_type = live.get("status_type", "unknown")
            turns_cnt = live.get("turns_count", 0)
            if st_type == "active":
                st_badge = f"{green}运行中 (第 {turns_cnt} 轮推进中){reset}"
            elif st_type == "idle":
                st_badge = f"{yellow}空闲就绪 (第 {turns_cnt} 轮已完成){reset}"
            elif turns_cnt == 0:
                st_badge = f"新会话就绪"
            else:
                st_badge = f"{st_type}"

            title = info['title'] if info else "(未命名任务)"
            cwd = info['cwd'] if info else ""
            print(f"  • {bold}{title}{reset} (ID: {tid[:8]}...) [{st_badge}] [工作目录: {cwd}]")

    # 检查 systemd 服务状态
    service_status = "未运行"
    try:
        res = subprocess.run(
            ["systemctl", "--user", "is-active", SERVICE_NAME],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if res.stdout.strip() == "active":
            service_status = f"{green}🟢 后台守护服务运行中 (Active){reset}"
        else:
            service_status = f"{yellow}⚪ 后台守护服务未启动 (Inactive){reset}"
    except Exception:
        pass
    print(f"后台守护服务:    {service_status}")
    print(f"{bold}{cyan}============================================================{reset}\n")


def cmd_sessions(args):
    """显示会话列表及当前状态"""
    recent = SessionManager.get_recent_sessions(limit=args.limit)
    loaded = set(SessionManager.get_loaded_thread_ids())

    green = "\033[32m"
    yellow = "\033[33m"
    cyan = "\033[36m"
    bold = "\033[1m"
    reset = "\033[0m"

    print(f"\n{bold}{cyan}============================================================{reset}")
    print(f"{bold}{cyan}                   Codex 会话列表状态                       {reset}")
    print(f"{bold}{cyan}============================================================{reset}")

    if not recent:
        print("未检测到历史会话记录。")
    else:
        for idx, s in enumerate(recent, 1):
            is_active = s["id"] in loaded
            tag = f"{green}[活跃载入中]{reset}" if is_active else f"[历史就绪]"
            up_dt = datetime.fromtimestamp(s["updated_at"]).strftime("%Y-%m-%d %H:%M") if s["updated_at"] else "未知"
            title = s["title"] if len(s["title"]) <= 32 else s["title"][:29] + "..."
            print(f"{idx:2d}. {tag} {bold}{title:<32}{reset} (更新: {up_dt})")
            print(f"    ID: {s['id']} | CWD: {s['cwd']}")

    print(f"\n{cyan}提示: 可执行 codex resume [ID] 或 codex resume --last 无缝继续任意任务。{reset}")
    print(f"{bold}{cyan}============================================================{reset}\n")


def cmd_pause(args):
    """手动暂停所有运行中的 Codex 客户端进程与后台推理任务"""
    # 1. 首先主动掐断 App-Server 正在生成的 turn (彻底停止 Token 消耗)
    interrupted = SessionManager.interrupt_active_turns()
    SessionManager.kill_orphaned_tool_subprocesses()

    # 2. 暂停所有前端 CLI 进程
    pids = ProcessManager.get_codex_client_pids()
    active_pids = [p for p, st, _ in pids if st != "T"]

    # 3. 保存快照
    SessionManager.save_snapshot(active_pids, reason="manual_pause", interrupted_turns=interrupted)

    for pid in active_pids:
        if ProcessManager.suspend_pid(pid):
            print(f"已发送 SIGSTOP 暂停 PID: {pid}")

    cnt_turns = len(interrupted)
    cnt_pids = len(active_pids)
    print(f"已成功暂停: {cnt_turns} 个后台运行中任务已掐断 (Token 停止消耗)，{cnt_pids} 个客户端已挂起。")
    send_notification("Codex 已手动暂停", f"已掐断 {cnt_turns} 个运行中任务，挂起 {cnt_pids} 个客户端，Token 消耗已彻底停止。")


def cmd_stop(args):
    """彻底停止正在运行的 Codex 任务与客户端，掐断模型推理，防止继续消耗额度或自动拉起"""
    # 1. 彻底掐断当前所有正在运行的回合（向 Codex App-Server 发送 turn/interrupt，立即终止 Token 推理）
    interrupted = SessionManager.interrupt_active_turns()
    
    # 2. 终止孤儿工具/子进程
    SessionManager.kill_orphaned_tool_subprocesses()

    # 3. 终止所有运行中或挂起中的 Codex 客户端进程
    pids_info = ProcessManager.get_codex_client_pids()
    target_pids = [p for p, _, _ in pids_info]
    
    # 若进程处于挂起状态 (SIGSTOP)，先发 SIGCONT 再发 SIGTERM 保证能接收退出信号
    for pid in target_pids:
        try:
            os.kill(pid, signal.SIGCONT)
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        except Exception as e:
            log(f"终止进程 {pid} 异常: {e}")

    # 等待 0.8 秒检查是否有进程未退出，若仍存活则 SIGKILL 强杀
    if target_pids:
        time.sleep(0.8)
        for pid in target_pids:
            if os.path.exists(f"/proc/{pid}"):
                try:
                    os.kill(pid, signal.SIGKILL)
                except Exception:
                    pass

    # 4. 更新快照状态为 manual_stopped，确保后台守护不会误以为是额度耗尽而自动再次拉起！
    if os.path.exists(SNAPSHOT_FILE):
        try:
            with open(SNAPSHOT_FILE, "r", encoding="utf-8") as f:
                snap_data = json.load(f)
            snap_data["reason"] = "manual_stopped"
            snap_data["stopped_at"] = time.time()
            with open(SNAPSHOT_FILE, "w", encoding="utf-8") as f:
                json.dump(snap_data, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

    # 5. 可选：停止后台守护服务 (--all 或 --service)
    stop_service = getattr(args, "all", False) or getattr(args, "service", False)
    if stop_service:
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=False)
        print(f"\033[32m[成功] 已停止后台守护服务: {SERVICE_NAME}\033[0m")

    cnt_turns = len(interrupted)
    cnt_pids = len(target_pids)
    print(f"\033[32m[成功] 已彻底停止 Codex 运行！\033[0m")
    print(f"  • 已向 App-Server 发送中断，掐断了 {cnt_turns} 个正在运行的推理回合（Token 消耗已彻底终止）")
    print(f"  • 已终止 {cnt_pids} 个 Codex 交互客户端进程及衍生工具子进程")
    if not stop_service:
        print(f"  • 提示：后台守护服务仍保持待机（如需彻底退出后台守护，请运行 `codex-guard stop --all` 或 `codex-guard service stop`）")
    send_notification("Codex 已彻底停止", f"已掐断 {cnt_turns} 个推理任务，终止 {cnt_pids} 个客户端，额度消耗彻底终止。")


def cmd_resume(args):
    """手动恢复所有被暂停的 Codex 客户端进程或恢复指定 session"""
    if args.session_id:
        cmd = ["codex", "resume", args.session_id]
        print(f"正在拉起会话: {' '.join(cmd)}")
        os.execvp("codex", cmd)
        return

    pids = ProcessManager.get_codex_client_pids()
    stopped_pids = [p for p, st, _ in pids if st == "T"]
    if not stopped_pids:
        print("没有处于暂停状态的 Codex 客户端进程需要唤醒。")
        return
    for pid in stopped_pids:
        if ProcessManager.resume_pid(pid):
            print(f"已发送 SIGCONT 唤醒 PID: {pid}")

    send_cont = not args.no_continue
    SessionManager.restore_and_verify_sessions(stopped_pids, send_continue=send_cont, continue_prompt=args.continue_prompt)
    send_notification("Codex 已手动唤醒", f"已唤醒 {len(stopped_pids)} 个 Codex 进程，已恢复原状并继续工作。")


def run_watch_loop(
    threshold: float = 3.0,
    interval: int = 10,
    continue_prompt: str = "继续",
    auto_continue: bool = True,
    idle_delay: int = 5,
):
    """核心守护监控主循环"""
    auto_desc = f"，空闲自动续跑: 开启 (延迟 {idle_delay}s)" if auto_continue else "，空闲自动续跑: 关闭"
    log(f"Codex 额度守护神启动 (阈值: {threshold}%, 检查间隔: {interval}s, 唤醒指令: '{continue_prompt}'{auto_desc})")
    send_notification(
        "Codex 额度守护已启动",
        f"守护监控生效中：当 5h 额度低于 {threshold}% 时自动暂停，恢复后自动唤醒原状并发送「{continue_prompt}」。{auto_desc}",
    )

    suspended_pids = set()
    last_continued_turn: Dict[str, str] = {}
    idle_since: Dict[str, float] = {}

    try:
        while True:
            data = CodexSocketClient.query_rate_limits()
            if not data:
                time.sleep(interval)
                continue

            snap = QuotaSnapshot(data)
            rem = snap.remaining_percent

            # 情况 1: 额度低于阈值 -> 必须停止/暂停
            if rem <= threshold:
                # 1. 核心防御：首先掐断正在后台运行的 Turn（直接向 App-Server 发送 turn/interrupt，立即掐断 OpenAI API 推理与 Token 消耗！）
                interrupted = SessionManager.interrupt_active_turns()
                if interrupted:
                    SessionManager.kill_orphaned_tool_subprocesses()

                # 2. 挂起所有运行中的前端 CLI 客户端
                client_pids = ProcessManager.get_codex_client_pids()
                newly_suspended = []

                for pid, state, cmd in client_pids:
                    if state != "T":
                        if ProcessManager.suspend_pid(pid):
                            suspended_pids.add(pid)
                            newly_suspended.append(pid)
                            log(f"⚠️ [额度预警] 5h额度仅剩 {rem:.1f}% (<= {threshold}%)！已暂停 Codex 客户端 (PID {pid}: {cmd})")

                if newly_suspended or interrupted:
                    # 快照记录会话元数据与列表
                    SessionManager.save_snapshot(list(suspended_pids), reason="quota_exceeded", interrupted_turns=interrupted)
                    loaded_threads = SessionManager.get_loaded_thread_ids()
                    session_desc = ""
                    if loaded_threads:
                        tinfo = SessionManager.get_thread_info(loaded_threads[0])
                        if tinfo:
                            session_desc = f"\n当前任务: {tinfo['title']}"

                    send_notification(
                        "⚠️ Codex 额度不足，已自动拦截暂停",
                        f"当前 5h 额度仅剩 {rem:.1f}%（低于 {threshold}% 保护线）！\n"
                        f"已掐断 {len(interrupted)} 个正在运行的模型推理任务，挂起 {len(newly_suspended)} 个客户端，杜绝消耗额外 Credits。{session_desc}\n"
                        f"将在 {snap.reset_datetime_str} 额度刷新后自动唤醒并发送「{continue_prompt}」继续执行。",
                        urgency="critical",
                    )

                # 计算距离重置的时间并进行等待
                secs_left = snap.seconds_until_reset
                if secs_left > 0:
                    sleep_step = min(max(10, secs_left - 5), 30)
                    time.sleep(sleep_step)
                else:
                    time.sleep(5)

            # 情况 2: 额度已恢复正常 (> 阈值)
            else:
                # 检查是否有之前被暂停/记录在快照中的会话需要恢复或自动拉起
                needs_recovery = False
                snapshot_data = {}
                if os.path.exists(SNAPSHOT_FILE):
                    try:
                        with open(SNAPSHOT_FILE, "r", encoding="utf-8") as f:
                            snapshot_data = json.load(f)
                        if snapshot_data.get("reason") in ("quota_exceeded", "quota_low"):
                            needs_recovery = True
                    except Exception:
                        pass

                if suspended_pids or needs_recovery:
                    log(f"✅ [额度已恢复] 5h额度已刷新，当前剩余 {rem:.1f}% (> {threshold}%)，准备自动恢复原状并拉起 Codex 发送「{continue_prompt}」！")
                    resumed_pids = []
                    for pid in list(suspended_pids):
                        if os.path.exists(f"/proc/{pid}"):
                            if ProcessManager.resume_pid(pid):
                                log(f"已唤醒原进程 PID {pid} 继续执行。")
                                resumed_pids.append(pid)
                        suspended_pids.remove(pid)

                    # 若唤醒了旧进程，给予 1 秒缓冲让其要么稳定恢复，要么因 turn 中断干净退出
                    if resumed_pids:
                        time.sleep(1.0)

                    # 检查当前是否已有正在运行的 Codex 客户端
                    client_pids = ProcessManager.get_codex_client_pids()
                    running_clients = [p for p, st, _ in client_pids if st != "T"]

                    # 若当前没有运行中的客户端，说明此前被关闭/杀掉/中断退出，主动执行“自动拉起”！
                    launched_sid = None
                    if not running_clients:
                        target_sid = None
                        # 1. 尝试从快照 sessions 检索
                        saved_sessions = snapshot_data.get("sessions", [])
                        for s in saved_sessions:
                            if s.get("id"):
                                target_sid = s["id"]
                                break
                        # 2. 尝试从快照 interrupted_turns 检索
                        if not target_sid:
                            for it in snapshot_data.get("interrupted_turns", []):
                                if it.get("threadId"):
                                    target_sid = it["threadId"]
                                    break
                        # 3. 尝试从快照 loaded_thread_ids 检索
                        if not target_sid:
                            lids = snapshot_data.get("loaded_thread_ids", [])
                            if lids:
                                target_sid = lids[0]
                        # 4. 尝试从 app-server 当前活跃线程检索
                        if not target_sid:
                            curr_loaded = SessionManager.get_loaded_thread_ids()
                            if curr_loaded:
                                target_sid = curr_loaded[0]
                        # 5. 尝试从本地 SQLite 最近历史检索
                        if not target_sid:
                            recent = SessionManager.get_recent_sessions(limit=1)
                            if recent and recent[0].get("id"):
                                target_sid = recent[0]["id"]

                        if target_sid:
                            # 溯源为根会话，避免在子代理上启动
                            target_sid = SessionManager.get_root_thread_id(target_sid)
                            log(f"检测到当前无存活客户端，正在自动拉起 Codex 会话 [{target_sid[:8]}...]...")
                            if SessionManager.launch_codex_session(target_sid, prompt=continue_prompt):
                                launched_sid = target_sid
                            time.sleep(2)

                    # 恢复会话列表、校验并自动发送“继续”
                    SessionManager.restore_and_verify_sessions(
                        resumed_pids,
                        send_continue=True,
                        continue_prompt=continue_prompt,
                        exclude_thread_ids=[launched_sid] if launched_sid else []
                    )

                    # 将快照标记为已恢复，避免重复拉起
                    if os.path.exists(SNAPSHOT_FILE):
                        try:
                            snapshot_data["reason"] = "quota_recovered"
                            snapshot_data["recovered_at"] = time.time()
                            with open(SNAPSHOT_FILE, "w", encoding="utf-8") as f:
                                json.dump(snapshot_data, f, ensure_ascii=False, indent=2)
                        except Exception:
                            pass

                    send_notification(
                        "✅ Codex 5h 额度已恢复！",
                        f"额度已刷新（当前剩余 {rem:.1f}%）！\n已自动拉起并恢复会话，发送「{continue_prompt}」，继续工作中！",
                        urgency="normal",
                    )

                # 检查空闲会话是否需要自动续跑 (Auto-Continue on Idle)
                if auto_continue:
                    client_pids = ProcessManager.get_codex_client_pids()
                    running_clients = [p for p, st, _ in client_pids if st != "T"]
                    if running_clients:
                        loaded_threads = SessionManager.get_loaded_thread_ids()
                        # 清理已卸载会话的空闲计时器
                        curr_loaded_set = set(loaded_threads)
                        for tid in list(idle_since.keys()):
                            if tid not in curr_loaded_set:
                                idle_since.pop(tid, None)

                        now = time.time()
                        for tid in loaded_threads:
                            # 过滤多智能体子代理
                            if SessionManager.is_subagent(tid):
                                continue
                            live = SessionManager.get_live_thread_state(tid)
                            st_type = live.get("status_type")
                            last_turn_id = live.get("last_turn_id")
                            last_turn_st = live.get("last_turn_status")

                            if st_type == "idle" and last_turn_id:
                                if last_turn_st == "completed" and last_continued_turn.get(tid) != last_turn_id:
                                    if tid not in idle_since:
                                        idle_since[tid] = now
                                    
                                    if now - idle_since[tid] >= idle_delay:
                                        tinfo = SessionManager.get_thread_info(tid)
                                        title = tinfo.get("title", tid[:8]) if tinfo else tid[:8]
                                        log(f"🔄 [自动续跑] 会话 [{title}] (ID: {tid[:8]}...) 已完成上一回合处于空闲，自动发送「{continue_prompt}」驱动继续工作！")
                                        success = SessionManager.send_continue_prompt(tid, continue_prompt)
                                        if success:
                                            last_continued_turn[tid] = last_turn_id
                                            idle_since.pop(tid, None)
                                            send_notification(
                                                "Codex 自动续跑",
                                                f"会话 [{title}] 已完成上一回合，已自动注入「{continue_prompt}」，继续自主推进！",
                                                urgency="low",
                                            )
                            else:
                                idle_since.pop(tid, None)

                # 正常间隔休眠
                time.sleep(interval)

    except KeyboardInterrupt:
        log("收到中断信号，守护退出。")
        if suspended_pids:
            print("注意: 退出时仍有被暂停的进程，正在全部唤醒...")
            for pid in suspended_pids:
                ProcessManager.resume_pid(pid)
            SessionManager.clean_stale_locks()


def cmd_watch(args):
    """启动监视循环"""
    run_watch_loop(
        threshold=args.threshold,
        interval=args.interval,
        continue_prompt=args.continue_prompt,
        auto_continue=args.auto_continue,
        idle_delay=args.idle_delay,
    )


def cmd_run(args, unknown_args):
    """包装运行模式: codex-guard run [codex 参数...]"""
    cmd_args = unknown_args
    if not cmd_args:
        cmd_args = []

    # 1. 检查启动前额度
    data = CodexSocketClient.query_rate_limits()
    if data:
        snap = QuotaSnapshot(data)
        if snap.remaining_percent <= args.threshold:
            print(f"\033[33m[Codex Guard] 当前 5h 额度仅剩 {snap.remaining_percent:.1f}% (<= {args.threshold}%)！\033[0m")
            print(f"[Codex Guard] 为避免消耗付费 Credits，正在等待额度在 {snap.reset_datetime_str} 刷新...")
            send_notification("Codex 延迟启动", f"当前 5h 额度仅剩 {snap.remaining_percent:.1f}%，等待恢复后再自动启动。")
            while True:
                data = CodexSocketClient.query_rate_limits()
                if data:
                    snap = QuotaSnapshot(data)
                    if snap.remaining_percent > args.threshold:
                        print(f"\033[32m[Codex Guard] 5h 额度已恢复 (剩余 {snap.remaining_percent:.1f}%)，现在启动 Codex！\033[0m")
                        break
                time.sleep(15)

    # 2. 启动真实 codex 进程
    real_codex = "/home/lizhonghu/.local/bin/codex"
    full_cmd = [real_codex] + cmd_args
    proc = subprocess.Popen(full_cmd)

    # 3. 伴随监控线程或循环
    try:
        while proc.poll() is None:
            data = CodexSocketClient.query_rate_limits()
            if data:
                snap = QuotaSnapshot(data)
                if snap.remaining_percent <= args.threshold:
                    log(f"⚠️ [Guard Run] 5h额度仅剩 {snap.remaining_percent:.1f}%！正在掐断推理并暂停子进程 PID {proc.pid}...")
                    interrupted = SessionManager.interrupt_active_turns()
                    SessionManager.kill_orphaned_tool_subprocesses()
                    SessionManager.save_snapshot([proc.pid], reason="quota_exceeded", interrupted_turns=interrupted)
                    send_notification(
                        "⚠️ Codex 任务已暂停",
                        f"额度低于 {args.threshold}%，已掐断后台推理并暂停任务。将在刷新后自动发送「{args.continue_prompt}」继续执行。",
                    )
                    ProcessManager.suspend_pid(proc.pid)

                    # 等待恢复
                    while proc.poll() is None:
                        secs_left = snap.seconds_until_reset
                        time.sleep(min(max(10, secs_left - 5), 30))
                        data = CodexSocketClient.query_rate_limits()
                        if data:
                            snap = QuotaSnapshot(data)
                            if snap.remaining_percent > args.threshold:
                                log(f"✅ [Guard Run] 额度已恢复（剩余 {snap.remaining_percent:.1f}%），自动唤醒 PID {proc.pid}！")
                                ProcessManager.resume_pid(proc.pid)
                                SessionManager.restore_and_verify_sessions(
                                    [proc.pid],
                                    send_continue=True,
                                    continue_prompt=args.continue_prompt,
                                )
                                send_notification("✅ Codex 任务已唤醒", f"5h 额度已恢复，已发送「{args.continue_prompt}」，继续工作中！")
                                break
            time.sleep(args.interval)
    except KeyboardInterrupt:
        try:
            proc.send_signal(signal.SIGINT)
            proc.wait(timeout=3)
        except Exception:
            proc.kill()
    sys.exit(proc.returncode if proc.returncode is not None else 0)


def cmd_service(args):
    """管理 systemd 用户级守护服务"""
    action = args.action
    exec_path = os.path.realpath(__file__)

    if action == "install":
        os.makedirs(os.path.dirname(SERVICE_FILE), exist_ok=True)
        auto_flag = "" if args.auto_continue else " --no-auto-continue"
        content = f"""[Unit]
Description=Codex Plus 5h Quota Guard Sentinel
After=network.target

[Service]
Type=simple
ExecStart={exec_path} watch --threshold {args.threshold} --interval {args.interval} --continue-prompt "{args.continue_prompt}" --idle-delay {args.idle_delay}{auto_flag}
Restart=always
RestartSec=10
Environment=PATH={os.path.dirname(exec_path)}:/usr/local/bin:/usr/bin:/bin
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{os.getuid()}/bus
Environment=XDG_RUNTIME_DIR=/run/user/{os.getuid()}

[Install]
WantedBy=default.target
"""
        with open(SERVICE_FILE, "w", encoding="utf-8") as f:
            f.write(content)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "restart", SERVICE_NAME], check=True)
        subprocess.run(["systemctl", "--user", "enable", SERVICE_NAME], check=True)
        print(f"\033[32m[成功] 已安装并启动系统后台服务: {SERVICE_NAME}\033[0m")
        print("开机或用户登录时将自动常驻后台监控，额度恢复或回合空闲时将自动发送「继续」，无需手动干预！")

    elif action == "uninstall":
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=False)
        subprocess.run(["systemctl", "--user", "disable", SERVICE_NAME], check=False)
        if os.path.exists(SERVICE_FILE):
            os.remove(SERVICE_FILE)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        print(f"\033[32m[成功] 已卸载后台服务: {SERVICE_NAME}\033[0m")

    elif action == "stop":
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME], check=False)
        print(f"\033[32m[成功] 已停止后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "start":
        subprocess.run(["systemctl", "--user", "start", SERVICE_NAME], check=False)
        print(f"\033[32m[成功] 已启动后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "restart":
        subprocess.run(["systemctl", "--user", "restart", SERVICE_NAME], check=False)
        print(f"\033[32m[成功] 已重启后台守护服务: {SERVICE_NAME}\033[0m")

    elif action == "status":
        subprocess.run(["systemctl", "--user", "status", SERVICE_NAME])


class CodexTopDashboard:
    """类似 top/htop 的全功能实时终端控制台（异步指标采集 + 60FPS 毫秒级拖拽响应）"""

    def __init__(self, delay: float = 1.0, continue_prompt: str = "继续"):
        self.delay = delay
        self.continue_prompt = continue_prompt
        self.flash_message = ""
        self.flash_time = 0.0
        self.cpu_tracker = {}  # pid -> (jiffies, timestamp)
        self.auto_continue_enabled = True

        # 异步线程安全数据缓存机制
        self._data_lock = threading.Lock()
        self._cached_data = None
        self._stop_event = threading.Event()
        self._force_refresh_event = threading.Event()
        self._worker_thread = None
        try:
            self.init_mtime = os.path.getmtime(os.path.realpath(__file__))
        except Exception:
            self.init_mtime = 0.0

    def check_and_reload(self) -> bool:
        """若检测到磁盘上的脚本文件被更新，自动重新执行当前进程以热加载最新逻辑"""
        try:
            cur_path = os.path.realpath(__file__)
            if os.path.exists(cur_path) and os.path.getmtime(cur_path) > self.init_mtime:
                try:
                    if curses and not curses.isendwin():
                        curses.endwin()
                except Exception:
                    pass
                os.execv(sys.executable, [sys.executable, cur_path] + sys.argv[1:])
                return True
        except Exception:
            pass
        return False

    def set_flash(self, msg: str):
        self.flash_message = msg
        self.flash_time = time.time()

    def _background_collector(self):
        """后台异步指标采集线程：完全解耦数据采集与界面渲染，保证前台 UI 毫秒级跟手响应"""
        while not self._stop_event.is_set():
            try:
                new_data = self.collect_data()
                with self._data_lock:
                    self._cached_data = new_data
            except Exception:
                pass

            # 等待 self.delay 秒或等待强制刷新信号
            self._force_refresh_event.wait(timeout=self.delay)
            self._force_refresh_event.clear()

    def get_snapshot(self) -> Dict[str, Any]:
        """获取最新的指标快照 (非阻塞极速返回)"""
        with self._data_lock:
            if self._cached_data is not None:
                return self._cached_data
        data = self.collect_data()
        with self._data_lock:
            self._cached_data = data
        return data

    def trigger_background_refresh(self):
        """唤醒后台采集线程立即执行一次采集"""
        self._force_refresh_event.set()

    def get_proc_metrics(self, pid: int) -> Dict[str, Any]:
        """获取指定进程的 CPU% 与物理内存 RSS"""
        try:
            with open(f"/proc/{pid}/stat", "r") as f:
                parts = f.read().split()
            state = parts[2]
            utime = int(parts[13])
            stime = int(parts[14])
            total_jiffies = utime + stime
            rss_pages = int(parts[23])
            mem_mb = (rss_pages * os.sysconf("SC_PAGE_SIZE")) / (1024.0 * 1024.0)

            now = time.time()
            cpu_pct = 0.0
            if pid in self.cpu_tracker:
                prev_jiffies, prev_time = self.cpu_tracker[pid]
                dt = now - prev_time
                if dt > 0.1:
                    dj = total_jiffies - prev_jiffies
                    clk = os.sysconf("SC_CLK_TCK")
                    cpu_pct = max(0.0, ((dj / clk) / dt) * 100.0)
            self.cpu_tracker[pid] = (total_jiffies, now)

            return {
                "pid": pid,
                "state": state,
                "state_desc": "STOPPED" if state == "T" else "RUNNING",
                "cpu_pct": cpu_pct,
                "mem_mb": mem_mb,
            }
        except Exception:
            return {"pid": pid, "state": "S", "state_desc": "RUNNING", "cpu_pct": 0.0, "mem_mb": 0.0}

    def collect_data(self) -> Dict[str, Any]:
        """采集一次完整监控指标数据 (在后台线程执行，不卡前台)"""
        rate_data = CodexSocketClient.query_rate_limits()
        snap = QuotaSnapshot(rate_data) if rate_data else None

        client_pids = ProcessManager.get_codex_client_pids()
        current_pids = {p for p, _, _ in client_pids}
        dead_pids = [p for p in self.cpu_tracker if p not in current_pids]
        for p in dead_pids:
            self.cpu_tracker.pop(p, None)

        proc_metrics = []
        for p, st, cmd in client_pids:
            m = self.get_proc_metrics(p)
            m["cmd"] = cmd
            proc_metrics.append(m)

        loaded_threads = SessionManager.get_loaded_thread_ids()
        sorted_threads = sorted(loaded_threads, key=lambda tid: 1 if SessionManager.is_subagent(tid) else 0)
        threads_info = []
        for idx, tid in enumerate(sorted_threads):
            info = SessionManager.get_thread_info(tid)
            live = SessionManager.get_live_thread_state(tid)
            need_turns = (idx == 0)
            turns = []
            if need_turns:
                res = CodexSocketClient.query_app_server("thread/read", {"threadId": tid, "includeTurns": True})
                if res and isinstance(res, dict) and "thread" in res:
                    turns = res["thread"].get("turns", [])
            threads_info.append({
                "id": tid,
                "title": info.get("title", "(未命名任务)") if info else "(未命名任务)",
                "cwd": info.get("cwd", "") if info else "",
                "status_type": live.get("status_type", "unknown"),
                "turns_count": len(turns) if turns else (live.get("turns_count") or 0),
                "last_turn_id": live.get("last_turn_id"),
                "last_turn_status": live.get("last_turn_status"),
                "turns": turns,
                "is_subagent": SessionManager.is_subagent(tid),
            })

        try:
            with open("/proc/uptime", "r") as f:
                sec = float(f.read().split()[0])
            up_str = f"up {int(sec//3600)}h {int((sec%3600)//60)}m"
        except Exception:
            up_str = "up"
        try:
            l1, l5, l15 = os.getloadavg()
            load_str = f"{l1:.2f}, {l5:.2f}, {l15:.2f}"
        except Exception:
            load_str = "N/A"

        service_active = False
        service_pid = "N/A"
        try:
            res = subprocess.run(["systemctl", "--user", "is-active", SERVICE_NAME], capture_output=True, text=True, timeout=1)
            service_active = (res.stdout.strip() == "active")
            if service_active:
                res_p = subprocess.run(["systemctl", "--user", "show", "--property", "MainPID", SERVICE_NAME], capture_output=True, text=True, timeout=1)
                line = res_p.stdout.strip()
                if line.startswith("MainPID="):
                    service_pid = line.split("=")[1]
        except Exception:
            pass

        return {
            "snapshot": snap,
            "processes": proc_metrics,
            "threads": threads_info,
            "uptime": up_str,
            "load": load_str,
            "service_active": service_active,
            "service_pid": service_pid,
            "time_str": time.strftime("%H:%M:%S"),
        }

    def render_batch_from_data(self, d: Dict[str, Any], out=sys.stdout):
        """根据提供的数据快照格式化并输出到终端"""
        snap = d["snapshot"]

        BOLD = "\033[1m"
        RESET = "\033[0m"
        GREEN = "\033[32m"
        YELLOW = "\033[33m"
        RED = "\033[31m"
        CYAN = "\033[36m"
        BG_CYAN = "\033[46;30m"
        BG_GRAY = "\033[47;30m"
        DIM = "\033[2m"

        def make_bar(used, width=28):
            u = max(0, min(width, int(round((used/100.0)*width))))
            return "█"*u + "░"*(width - u)

        st_color = GREEN if d["service_active"] else YELLOW
        st_desc = f"ACTIVE (PID {d['service_pid']})" if d["service_active"] else "INACTIVE"
        out.write(f"{BG_CYAN} codex-top {RESET} - {BOLD}{d['time_str']}{RESET} {d['uptime']}, load: {d['load']}, Sentinel: {st_color}{st_desc}{RESET}\n")

        if snap:
            rem = snap.remaining_percent
            q_color = RED if rem <= 3.0 else (YELLOW if rem <= 15.0 else GREEN)
            b_5h = make_bar(snap.used_percent)
            out.write(f"5h Quota:   [{q_color}{b_5h}{RESET}] {snap.used_percent:.1f}% used | {BOLD}{q_color}{rem:.1f}% left{RESET} (Reset: {snap.reset_datetime_str} in {snap.time_to_reset_str})\n")

            if snap.weekly_window:
                w_used = float(snap.weekly_window.get("usedPercent", 0))
                w_rem = max(0.0, 100.0 - w_used)
                b_wk = make_bar(w_used)
                out.write(f"Week Quota: [{CYAN}{b_wk}{RESET}] {w_used:.1f}% used | {w_rem:.1f}% left | Credits: {BOLD}{snap.credit_balance}{RESET} ({GREEN}SAFE - 0 used{RESET})\n")

            auto_st = f"{GREEN}ON (5s debounce){RESET}" if self.auto_continue_enabled else f"{YELLOW}OFF{RESET}"
            out.write(f"Guard Rule: Threshold <= {BOLD}3.0%{RESET} (SIGSTOP) | Auto-Continue: {auto_st} | Plan: {BOLD}{snap.plan_type.upper()}{RESET}\n\n")

        out.write(f"{BG_GRAY} PID      STATE     CPU%   MEM     TURNS  STATUS       ACTIVE SESSION / TASK TITLE                  {RESET}\n")
        if not d["processes"]:
            out.write(" (No active Codex client process detected)\n")
        else:
            for p in d["processes"]:
                st_str = f"{RED}STOPPED{RESET}" if p["state"] == "T" else f"{GREEN}RUNNING{RESET}"
                th_title = p["cmd"][:35]
                turns_cnt = "-"
                turn_st = "-"
                matched_thread = None
                for th in d.get("threads", []):
                    if th["id"] in p["cmd"]:
                        matched_thread = th
                        break
                if not matched_thread and d.get("threads"):
                    root_threads = [th for th in d["threads"] if not th.get("is_subagent", False)]
                    matched_thread = root_threads[0] if root_threads else d["threads"][0]

                if matched_thread:
                    th_title = matched_thread["title"]
                    turns_cnt = str(matched_thread["turns_count"])
                    turn_st = str(matched_thread["last_turn_status"] or matched_thread["status_type"])

                cpu_fmt = f"{p['cpu_pct']:.1f}%"
                mem_fmt = f"{p['mem_mb']:.1f}M"
                out.write(f" {p['pid']:<8} {st_str:<17} {cpu_fmt:<6} {mem_fmt:<7} #{turns_cnt:<5} {turn_st:<12} {th_title[:45]}\n")

        out.write("\n")
        if d["threads"]:
            t0 = d["threads"][0]
            turns = t0["turns"]
            if turns:
                last_turn = turns[-1]
                items = last_turn.get("items", [])
                t_idx = len(turns)
                t_st = last_turn.get("status", "inProgress")
                st_color = GREEN if t_st == "inProgress" else YELLOW
                out.write(f"{DIM}─── Live Turn Execution Stream (Turn #{t_idx} ─ {st_color}{t_st}{RESET}{DIM}, {len(items)} actions) ────────────────────────{RESET}\n")
                for it in items[-8:]:
                    itype = it.get("type")
                    if itype == "commandExecution":
                        c_st = it.get("status", "running")
                        cmd_txt = it.get("command", "").replace("\n", " ").strip()
                        c_color = GREEN if c_st == "completed" else (RED if c_st == "failed" else YELLOW)
                        dur = f"{it.get('durationMs', 0)}ms" if it.get("durationMs") else ""
                        out.write(f"  • {BOLD}[CMD:{c_color}{c_st}{RESET}{BOLD}]{RESET} {cmd_txt[:70]} {DIM}{dur}{RESET}\n")
                    elif itype == "reasoning":
                        out.write(f"  • {CYAN}[REASONING]{RESET} Deep model reasoning & kernel latency analysis...\n")
                    elif itype == "webSearch":
                        out.write(f"  • {YELLOW}[SEARCH]{RESET} {it.get('query', '')[:65]}\n")
                    elif itype == "message":
                        content = str(it.get("content", "")).replace("\n", " ")[:65]
                        out.write(f"  • {DIM}[MSG]{RESET} {content}\n")

        out.write(f"\n{DIM}───────────────────────────────────────────────────────────────────────────────{RESET}\n")
        now = time.time()
        if self.flash_message and (now - self.flash_time < 3.0):
            out.write(f" {BOLD}{GREEN}>>> {self.flash_message}{RESET}\n")
        else:
            out.write(f" {BOLD}[q]{RESET} 退出  {BOLD}[r]{RESET} 刷新  {BOLD}[p]{RESET} 暂停  {BOLD}[c]{RESET} 唤醒  {BOLD}[k]{RESET} 停止  {BOLD}[Space]{RESET} 注入「继续」  {BOLD}[+/-]{RESET} 调频 ({self.delay:.1f}s)\n")
        out.flush()

    def render_batch(self, out=sys.stdout):
        """单次快照输出"""
        self.render_batch_from_data(self.get_snapshot(), out)

    def draw_curses_screen(self, stdscr, data: Dict[str, Any], maxy: int, maxx: int):
        """极速纯内存重绘 Curses 界面 (耗时 < 0.2ms，拖拽窗口极致丝滑)"""
        snap = data["snapshot"]

        def c_pair(n: int) -> int:
            try:
                return curses.color_pair(n)
            except Exception:
                return 0

        def safe_addstr(y, x, s, attr=0):
            if y < 0 or y >= maxy or x < 0 or x >= maxx:
                return
            avail = maxx - x if y < maxy - 1 else max(0, maxx - x - 1)
            if avail <= 0:
                return
            try:
                stdscr.addnstr(y, x, s, avail, attr)
            except curses.error:
                pass

        def pad_line(y, x, s, attr=0):
            """输出文本并用空格填充整行，防止拖拽缩放时残影"""
            if y < 0 or y >= maxy or x < 0 or x >= maxx:
                return
            avail = maxx - x if y < maxy - 1 else max(0, maxx - x - 1)
            if avail <= 0:
                return
            full_str = s if len(s) >= avail else s + " " * (avail - len(s))
            try:
                stdscr.addnstr(y, x, full_str, avail, attr)
            except curses.error:
                pass

        # 极小窗口自适应
        if maxy < 6 or maxx < 35:
            safe_addstr(0, 0, " codex-top ", c_pair(6) | curses.A_BOLD)
            if snap:
                safe_addstr(1, 0, f"5h: {snap.used_percent:.0f}% used | {snap.remaining_percent:.0f}% left")
            safe_addstr(2, 0, f"PIDs: {len(data['processes'])} [q:退出]")
            return

        # 1. 顶部 Header
        st_color = c_pair(1) if data["service_active"] else c_pair(2)
        st_desc = f"ACTIVE (PID {data['service_pid']})" if data["service_active"] else "INACTIVE"
        pad_line(0, 0, f" codex-top  - {data['time_str']} {data['uptime']}, load: {data['load']}, Sentinel: {st_desc}")
        safe_addstr(0, 0, " codex-top ", c_pair(6) | curses.A_BOLD)
        sentinel_pos = len(f" codex-top  - {data['time_str']} {data['uptime']}, load: {data['load']}, Sentinel: ")
        safe_addstr(0, sentinel_pos, st_desc, st_color | curses.A_BOLD)

        # 2. 额度进度条
        if snap:
            bar_w = min(28, max(8, maxx - 52))
            def make_bar_txt(used, width):
                u = max(0, min(width, int(round((used/100.0)*width))))
                return "█"*u, "░"*(width - u)

            rem = snap.remaining_percent
            q_attr = c_pair(3) if rem <= 3.0 else (c_pair(2) if rem <= 15.0 else c_pair(1))
            u_chars, r_chars = make_bar_txt(snap.used_percent, bar_w)

            pad_line(1, 0, f"5h Quota:   [{' '*bar_w}] {snap.used_percent:.1f}% used | {rem:.1f}% left (Reset: {snap.reset_datetime_str} in {snap.time_to_reset_str})")
            safe_addstr(1, 13, u_chars, q_attr | curses.A_BOLD)
            safe_addstr(1, 13 + len(u_chars), r_chars, curses.A_DIM)

            if snap.weekly_window:
                w_used = float(snap.weekly_window.get("usedPercent", 0))
                w_rem = max(0.0, 100.0 - w_used)
                wu_chars, wr_chars = make_bar_txt(w_used, bar_w)
                pad_line(2, 0, f"Week Quota: [{' '*bar_w}] {w_used:.1f}% used | {w_rem:.1f}% left | Credits: {snap.credit_balance} (SAFE - 0 used)")
                safe_addstr(2, 13, wu_chars, c_pair(4) | curses.A_BOLD)
                safe_addstr(2, 13 + len(wu_chars), wr_chars, curses.A_DIM)

            auto_str = "ON (5s debounce)" if self.auto_continue_enabled else "OFF"
            pad_line(3, 0, f"Guard Rule: Threshold <= 3.0% (SIGSTOP) | Auto-Continue: {auto_str} | Plan: {snap.plan_type.upper()}")

        # 3. 进程表格
        pad_line(4, 0, "")
        header_row = 5
        header_txt = f" {'PID':<8} {'STATE':<9} {'CPU%':<6} {'MEM':<7} {'TURNS':<6} {'STATUS':<12} {'ACTIVE SESSION / TASK TITLE':<{max(10, maxx-52)}}"
        pad_line(header_row, 0, header_txt, c_pair(7) | curses.A_BOLD)

        cur_row = 6
        if not data["processes"]:
            pad_line(cur_row, 0, "  (No active Codex client process detected)", curses.A_DIM)
            cur_row += 1
        else:
            for p in data["processes"]:
                if cur_row >= maxy - 4:
                    break
                st_attr = c_pair(3) | curses.A_BOLD if p["state"] == "T" else c_pair(1) | curses.A_BOLD
                th_title = p["cmd"][:45]
                turns_cnt = "-"
                turn_st = "-"
                matched_thread = None
                for th in data.get("threads", []):
                    if th["id"] in p["cmd"]:
                        matched_thread = th
                        break
                if not matched_thread and data.get("threads"):
                    root_threads = [th for th in data["threads"] if not th.get("is_subagent", False)]
                    matched_thread = root_threads[0] if root_threads else data["threads"][0]

                if matched_thread:
                    th_title = matched_thread["title"]
                    turns_cnt = str(matched_thread["turns_count"])
                    turn_st = str(matched_thread["last_turn_status"] or matched_thread["status_type"])

                pad_line(cur_row, 0, "")
                safe_addstr(cur_row, 1, f"{p['pid']:<8}")
                safe_addstr(cur_row, 10, f"{p['state_desc']:<9}", st_attr)
                safe_addstr(cur_row, 20, f"{p['cpu_pct']:>4.1f}% ")
                safe_addstr(cur_row, 27, f"{p['mem_mb']:>5.1f}M ")
                safe_addstr(cur_row, 35, f"#{turns_cnt:<5}")
                safe_addstr(cur_row, 42, f"{turn_st:<12}")
                safe_addstr(cur_row, 55, th_title[:max(10, maxx-56)])
                cur_row += 1

        # 4. 实时执行流（Turn Stream）
        pad_line(cur_row, 0, "")
        cur_row += 1
        if data["threads"] and cur_row < maxy - 4:
            target_th = None
            if data.get("processes"):
                for th in data["threads"]:
                    if th["id"] in data["processes"][0]["cmd"]:
                        target_th = th
                        break
            if not target_th:
                root_threads = [th for th in data["threads"] if not th.get("is_subagent", False)]
                target_th = root_threads[0] if root_threads else data["threads"][0]

            turns = target_th["turns"] if target_th else []
            if turns:
                last_turn = turns[-1]
                items = last_turn.get("items", [])
                t_idx = len(turns)
                t_st = last_turn.get("status", "inProgress")

                div_title = f"─── Live Turn Execution Stream (Turn #{t_idx} ─ {t_st}, {len(items)} actions) "
                div_full = div_title + "─" * max(0, maxx - len(div_title) - 1)
                pad_line(cur_row, 0, div_full, curses.A_DIM)
                cur_row += 1

                avail_rows = maxy - cur_row - 3
                disp_items = items[-avail_rows:] if avail_rows > 0 else []
                for it in disp_items:
                    if cur_row >= maxy - 2:
                        break
                    pad_line(cur_row, 0, "")
                    itype = it.get("type")
                    if itype == "commandExecution":
                        c_st = it.get("status", "running")
                        cmd_txt = it.get("command", "").replace("\n", " ").strip()
                        c_color = c_pair(1) if c_st == "completed" else (c_pair(3) if c_st == "failed" else c_pair(2))
                        dur = f"{it.get('durationMs', 0)}ms" if it.get("durationMs") else ""
                        safe_addstr(cur_row, 2, "• [CMD:", curses.A_BOLD)
                        safe_addstr(cur_row, 8, c_st, c_color | curses.A_BOLD)
                        safe_addstr(cur_row, 8 + len(c_st), f"] {cmd_txt[:max(10, maxx-25)]} ")
                        if dur:
                            safe_addstr(cur_row, min(maxx - len(dur) - 2, 8 + len(c_st) + len(cmd_txt) + 3), dur, curses.A_DIM)
                    elif itype == "reasoning":
                        safe_addstr(cur_row, 2, "• [REASONING] ", c_pair(4) | curses.A_BOLD)
                        safe_addstr(cur_row, 16, f"Deep model reasoning & kernel latency analysis... ({t0['title'][:25]})", curses.A_DIM)
                    elif itype == "webSearch":
                        safe_addstr(cur_row, 2, "• [SEARCH] ", c_pair(2) | curses.A_BOLD)
                        safe_addstr(cur_row, 13, it.get("query", "")[:max(10, maxx-16)])
                    elif itype == "message":
                        content = str(it.get("content", "")).replace("\n", " ")[:max(10, maxx-16)]
                        safe_addstr(cur_row, 2, "• [MSG] ", curses.A_DIM)
                        safe_addstr(cur_row, 10, content)
                    cur_row += 1

        # 清除多余行直到 footer
        while cur_row < maxy - 2:
            pad_line(cur_row, 0, "")
            cur_row += 1

        # 5. 底部快捷栏与状态通知
        footer_y = maxy - 1
        sep_y = maxy - 2
        pad_line(sep_y, 0, "─" * (maxx - 1), curses.A_DIM)

        now = time.time()
        if self.flash_message and (now - self.flash_time < 3.0):
            pad_line(footer_y, 0, f" >>> {self.flash_message}", c_pair(1) | curses.A_BOLD)
        else:
            pad_line(footer_y, 0, f" [q] 退出  [r] 刷新  [p] 暂停  [c] 唤醒  [k] 彻底停止  [Space] 注入「{self.continue_prompt}」  [+/-] 调频 ({self.delay:.1f}s)")

    def run_curses(self, stdscr):
        """交互式实时全屏 Curses TUI 运行循环 (高帧率事件响应，拖拽窗口毫秒级跟手)"""
        # 1. 启动后台异步指标采集线程
        self._stop_event.clear()
        self._worker_thread = threading.Thread(target=self._background_collector, daemon=True)
        self._worker_thread.start()

        # 2. Curses 基础设定与防错色彩对齐
        try:
            curses.curs_set(0)
        except Exception:
            pass

        # 显式向终端注销任何鼠标追踪协议（防止终端把鼠标移动当作键盘按键发送）
        sys.stdout.write("\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
        sys.stdout.flush()

        try:
            curses.use_default_colors()
            bg_color = -1
        except Exception:
            bg_color = curses.COLOR_BLACK

        for idx, fg in enumerate([curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED, curses.COLOR_CYAN, curses.COLOR_MAGENTA], 1):
            try:
                curses.init_pair(idx, fg, bg_color)
            except Exception:
                try:
                    curses.init_pair(idx, fg, curses.COLOR_BLACK)
                except Exception:
                    pass

        try:
            curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)   # Title banner
            curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_WHITE)  # Table header
            curses.init_pair(8, curses.COLOR_WHITE, curses.COLOR_RED)    # Alert banner
        except Exception:
            pass

        # 预先拉取一次指标快照，确保首帧 0ms 秒开渲染
        if self._cached_data is None:
            self.get_snapshot()

        # 3. 高帧率事件循环 (30ms 轮询 = ~33FPS，拖拽窗口极致跟手)
        stdscr.nodelay(False)
        stdscr.timeout(30)

        last_draw_time = 0.0
        needs_redraw = True

        try:
            while True:
                now = time.time()
                try:
                    ch = stdscr.getch()
                except Exception:
                    ch = -1

                if ch in (ord('q'), ord('Q'), 27):  # ESC or q
                    break
                elif ch == curses.KEY_RESIZE:
                    # 关键：窗口拖动事件！更新终端尺寸并标记立即重绘 (勿调 resizeterm 避免死循环)
                    try:
                        curses.update_lines_cols()
                    except Exception:
                        pass
                    stdscr.erase()
                    needs_redraw = True
                elif ch in (ord('r'), ord('R')):
                    self.set_flash("正在刷新数据...")
                    self.check_and_reload()
                    self.trigger_background_refresh()
                    needs_redraw = True
                elif ch in (ord('p'), ord('P')):
                    interrupted = SessionManager.interrupt_active_turns()
                    SessionManager.kill_orphaned_tool_subprocesses()
                    pids = ProcessManager.get_codex_client_pids()
                    active = [p for p, st, _ in pids if st != "T"]
                    if active or interrupted:
                        SessionManager.save_snapshot(active, reason="manual_top_pause", interrupted_turns=interrupted)
                        for pid in active:
                            ProcessManager.suspend_pid(pid)
                        # 立即乐观更新内存缓存，达成 0ms 视觉即时响应
                        with self._data_lock:
                            if self._cached_data and "processes" in self._cached_data:
                                for p in self._cached_data["processes"]:
                                    if p["pid"] in active:
                                        p["state"] = "T"
                                        p["state_desc"] = "STOPPED"
                                if interrupted and self._cached_data.get("threads"):
                                    for t in self._cached_data["threads"]:
                                        t["last_turn_status"] = "interrupted"
                        self.set_flash(f"已暂停！掐断 {len(interrupted)} 个推理任务，挂起 {len(active)} 个客户端。")
                    else:
                        self.set_flash("没有处于运行中的 Codex 进程或推理任务需要暂停。")
                    self.trigger_background_refresh()
                    needs_redraw = True
                elif ch in (ord('k'), ord('K')):
                    interrupted = SessionManager.interrupt_active_turns()
                    SessionManager.kill_orphaned_tool_subprocesses()
                    pids_info = ProcessManager.get_codex_client_pids()
                    target_pids = [p for p, _, _ in pids_info]
                    for pid in target_pids:
                        try:
                            os.kill(pid, signal.SIGCONT)
                            os.kill(pid, signal.SIGTERM)
                        except ProcessLookupError:
                            pass
                        except Exception:
                            pass
                    if target_pids:
                        time.sleep(0.3)
                        for pid in target_pids:
                            if os.path.exists(f"/proc/{pid}"):
                                try:
                                    os.kill(pid, signal.SIGKILL)
                                except Exception:
                                    pass
                    if os.path.exists(SNAPSHOT_FILE):
                        try:
                            with open(SNAPSHOT_FILE, "r", encoding="utf-8") as f:
                                snap_data = json.load(f)
                            snap_data["reason"] = "manual_stopped"
                            snap_data["stopped_at"] = time.time()
                            with open(SNAPSHOT_FILE, "w", encoding="utf-8") as f:
                                json.dump(snap_data, f, ensure_ascii=False, indent=2)
                        except Exception:
                            pass
                    with self._data_lock:
                        if self._cached_data:
                            self._cached_data["processes"] = []
                            if self._cached_data.get("threads"):
                                for t in self._cached_data["threads"]:
                                    t["last_turn_status"] = "interrupted"
                    self.set_flash(f"已彻底停止！掐断 {len(interrupted)} 个推理任务，终止 {len(target_pids)} 个客户端进程。")
                    self.trigger_background_refresh()
                    needs_redraw = True
                elif ch in (ord('c'), ord('C')):
                    pids = ProcessManager.get_codex_client_pids()
                    stopped = [p for p, st, _ in pids if st == "T"]
                    if stopped:
                        for pid in stopped:
                            ProcessManager.resume_pid(pid)
                        # 立即乐观更新内存缓存，达成 0ms 视觉即时响应
                        with self._data_lock:
                            if self._cached_data and "processes" in self._cached_data:
                                for p in self._cached_data["processes"]:
                                    if p["pid"] in stopped:
                                        p["state"] = "S"
                                        p["state_desc"] = "RUNNING"
                        SessionManager.restore_and_verify_sessions(stopped, send_continue=True, continue_prompt=self.continue_prompt)
                        self.set_flash(f"已唤醒 {len(stopped)} 个 Codex 进程并发送「{self.continue_prompt}」！")
                    else:
                        self.set_flash("没有处于暂停中的 Codex 进程需要唤醒。")
                    self.trigger_background_refresh()
                    needs_redraw = True
                elif ch == ord(' '):
                    loaded = SessionManager.get_loaded_thread_ids()
                    if loaded:
                        tid0 = loaded[0]
                        success = SessionManager.send_continue_prompt(tid0, self.continue_prompt)
                        if success:
                            self.set_flash(f"已成功向活跃会话注入「{self.continue_prompt}」指令！")
                        else:
                            self.set_flash(f"注入「{self.continue_prompt}」失败，请查看日志。")
                    else:
                        self.set_flash("未检测到活跃会话。")
                    self.trigger_background_refresh()
                    needs_redraw = True
                elif ch in (ord('+'), ord('=')):
                    self.delay = max(0.2, self.delay - 0.2)
                    self.set_flash(f"刷新频率调快至: {self.delay:.1f}s")
                    needs_redraw = True
                elif ch in (ord('-'), ord('_')):
                    self.delay = min(10.0, self.delay + 0.5)
                    self.set_flash(f"刷新频率调慢至: {self.delay:.1f}s")
                    needs_redraw = True
                elif ch in (ord('a'), ord('A')):
                    self.auto_continue_enabled = not self.auto_continue_enabled
                    status_str = "开启" if self.auto_continue_enabled else "关闭"
                    self.set_flash(f"自动接力续跑已切换为: {status_str}")
                    needs_redraw = True

                # 每 100ms 刷新界面，或当窗口改变/按键交互时立即重绘 (绝不卡顿)
                if (now - last_draw_time >= 0.1) or needs_redraw:
                    data = self.get_snapshot()
                    maxy, maxx = stdscr.getmaxyx()
                    self.draw_curses_screen(stdscr, data, maxy, maxx)
                    stdscr.refresh()
                    last_draw_time = now
                    needs_redraw = False

        finally:
            self._stop_event.set()
            self._force_refresh_event.set()
            if self._worker_thread:
                self._worker_thread.join(timeout=0.5)
            sys.stdout.write("\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
            sys.stdout.flush()

    def run_ansi_loop(self):
        """ANSI 转义终端持久实时全屏循环 (在 Curses 不可用或无特殊支持时的万能实时保底)"""
        self._stop_event.clear()
        self._worker_thread = threading.Thread(target=self._background_collector, daemon=True)
        self._worker_thread.start()

        sys.stdout.write("\033[?25l\033[?1049h\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")  # 隐藏光标，关闭鼠标追踪
        sys.stdout.flush()
        old_settings = None
        resized = [False]

        def on_sigwinch(signum, frame):
            resized[0] = True

        old_handler = None
        try:
            old_handler = signal.signal(signal.SIGWINCH, on_sigwinch)
        except Exception:
            pass

        try:
            import select
            try:
                import termios
                import tty
                if sys.stdin.isatty():
                    old_settings = termios.tcgetattr(sys.stdin)
                    tty.setcbreak(sys.stdin.fileno())
            except Exception:
                pass

            last_refresh = 0.0
            while True:
                now = time.time()
                if (now - last_refresh >= self.delay) or resized[0]:
                    resized[0] = False
                    sys.stdout.write("\033[H\033[2J")  # 移到屏幕左上角并清屏
                    self.render_batch_from_data(self.get_snapshot(), sys.stdout)
                    last_refresh = now

                # 非阻塞监听按键 (50ms 轮询保证跟手)
                if sys.stdin.isatty():
                    r, _, _ = select.select([sys.stdin], [], [], 0.05)
                    if r:
                        ch = sys.stdin.read(1)
                        if ch in ('q', 'Q', '\x1b'):
                            break
                        elif ch in ('r', 'R'):
                            self.set_flash("正在刷新数据...")
                            self.check_and_reload()
                            self.trigger_background_refresh()
                            last_refresh = 0.0
                        elif ch in ('p', 'P'):
                            interrupted = SessionManager.interrupt_active_turns()
                            SessionManager.kill_orphaned_tool_subprocesses()
                            pids = ProcessManager.get_codex_client_pids()
                            active = [p for p, st, _ in pids if st != "T"]
                            if active or interrupted:
                                SessionManager.save_snapshot(active, reason="manual_top_pause", interrupted_turns=interrupted)
                                for pid in active:
                                    ProcessManager.suspend_pid(pid)
                                with self._data_lock:
                                    if self._cached_data and "processes" in self._cached_data:
                                        for p in self._cached_data["processes"]:
                                            if p["pid"] in active:
                                                p["state"] = "T"
                                                p["state_desc"] = "STOPPED"
                                        if interrupted and self._cached_data.get("threads"):
                                            for t in self._cached_data["threads"]:
                                                t["last_turn_status"] = "interrupted"
                                self.set_flash(f"已暂停！掐断 {len(interrupted)} 个推理任务，挂起 {len(active)} 个客户端。")
                            else:
                                self.set_flash("没有处于运行中的 Codex 进程或推理任务需要暂停。")
                            self.trigger_background_refresh()
                            last_refresh = 0.0
                        elif ch in ('k', 'K'):
                            interrupted = SessionManager.interrupt_active_turns()
                            SessionManager.kill_orphaned_tool_subprocesses()
                            pids_info = ProcessManager.get_codex_client_pids()
                            target_pids = [p for p, _, _ in pids_info]
                            for pid in target_pids:
                                try:
                                    os.kill(pid, signal.SIGCONT)
                                    os.kill(pid, signal.SIGTERM)
                                except ProcessLookupError:
                                    pass
                                except Exception:
                                    pass
                            if target_pids:
                                time.sleep(0.3)
                                for pid in target_pids:
                                    if os.path.exists(f"/proc/{pid}"):
                                        try:
                                            os.kill(pid, signal.SIGKILL)
                                        except Exception:
                                            pass
                            if os.path.exists(SNAPSHOT_FILE):
                                try:
                                    with open(SNAPSHOT_FILE, "r", encoding="utf-8") as f:
                                        snap_data = json.load(f)
                                    snap_data["reason"] = "manual_stopped"
                                    snap_data["stopped_at"] = time.time()
                                    with open(SNAPSHOT_FILE, "w", encoding="utf-8") as f:
                                        json.dump(snap_data, f, ensure_ascii=False, indent=2)
                                except Exception:
                                    pass
                            with self._data_lock:
                                if self._cached_data:
                                    self._cached_data["processes"] = []
                                    if self._cached_data.get("threads"):
                                        for t in self._cached_data["threads"]:
                                            t["last_turn_status"] = "interrupted"
                            self.set_flash(f"已彻底停止！掐断 {len(interrupted)} 个推理任务，终止 {len(target_pids)} 个客户端进程。")
                            self.trigger_background_refresh()
                            last_refresh = 0.0
                        elif ch in ('c', 'C'):
                            pids = ProcessManager.get_codex_client_pids()
                            stopped = [p for p, st, _ in pids if st == "T"]
                            for pid in stopped:
                                ProcessManager.resume_pid(pid)
                            with self._data_lock:
                                if self._cached_data and "processes" in self._cached_data:
                                    for p in self._cached_data["processes"]:
                                        if p["pid"] in stopped:
                                            p["state"] = "S"
                                            p["state_desc"] = "RUNNING"
                            SessionManager.restore_and_verify_sessions(stopped, send_continue=True, continue_prompt=self.continue_prompt)
                            self.set_flash(f"已唤醒 {len(stopped)} 个 Codex 进程并发送「{self.continue_prompt}」！")
                            self.trigger_background_refresh()
                            last_refresh = 0.0
                        elif ch == ' ':
                            loaded = SessionManager.get_loaded_thread_ids()
                            if loaded:
                                SessionManager.send_continue_prompt(loaded[0], self.continue_prompt)
                                self.set_flash(f"已成功向活跃会话注入「{self.continue_prompt}」指令！")
                            self.trigger_background_refresh()
                            last_refresh = 0.0
                        elif ch in ('+', '='):
                            self.delay = max(0.2, self.delay - 0.2)
                            self.set_flash(f"刷新频率调快至: {self.delay:.1f}s")
                            last_refresh = 0.0
                        elif ch in ('-', '_'):
                            self.delay = min(10.0, self.delay + 0.5)
                            self.set_flash(f"刷新频率调慢至: {self.delay:.1f}s")
                            last_refresh = 0.0
                        elif ch in ('a', 'A'):
                            self.auto_continue_enabled = not self.auto_continue_enabled
                            status_str = "开启" if self.auto_continue_enabled else "关闭"
                            self.set_flash(f"自动接力续跑已切换为: {status_str}")
                            last_refresh = 0.0
                else:
                    # 非 TTY / 管道环境：监听键盘或管道输入，遇到 EOF 或退出键正常退出
                    r, _, _ = select.select([sys.stdin], [], [], 0.05)
                    if r:
                        ch = sys.stdin.read(1)
                        if not ch or ch in ('q', 'Q', '\x1b'):
                            break
                    else:
                        time.sleep(0.05)
        except KeyboardInterrupt:
            pass
        finally:
            self._stop_event.set()
            self._force_refresh_event.set()
            if self._worker_thread:
                self._worker_thread.join(timeout=0.5)
            if old_handler is not None:
                try:
                    signal.signal(signal.SIGWINCH, old_handler)
                except Exception:
                    pass
            if old_settings:
                try:
                    import termios
                    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
                except Exception:
                    pass
            sys.stdout.write("\033[?1049l\033[?25h\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l")
            sys.stdout.flush()


def cmd_top(args):
    """启动类似 top/htop 的实时监控控制台"""
    delay = getattr(args, "delay", 1.0)
    batch = getattr(args, "batch", False)
    prompt = getattr(args, "continue_prompt", "继续")
    dashboard = CodexTopDashboard(delay=delay, continue_prompt=prompt)

    # 1. 显式指定批处理快照模式
    if batch:
        dashboard.render_batch()
        return

    # 2. 交互式持久实时刷新 (类似 top / htop)
    if curses is not None and sys.stdout.isatty():
        try:
            curses.wrapper(dashboard.run_curses)
            return
        except KeyboardInterrupt:
            return
        except Exception:
            # curses 遭遇异常（如终端环境不支持），平滑回退到 ANSI 持续实时循环，绝不单次退出！
            pass

    # 3. ANSI 持久实时刷新循环（保底确保一直动态刷新，按 q 退出）
    dashboard.run_ansi_loop()


def main():
    parser = argparse.ArgumentParser(
        description="Codex Plus 5h 额度守护神：低于 3% 自动暂停防扣 Credits，恢复后自动唤醒原状并发送「继续」"
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="子命令")

    # top
    p_top = subparsers.add_parser("top", help="启动类似 top 的交互式实时全屏监控控制台")
    p_top.add_argument("-d", "--delay", type=float, default=1.0, help="刷新间隔秒数 (默认: 1.0)")
    p_top.add_argument("-b", "--batch", action="store_true", help="单次快照批处理模式 (不进入全屏交互)")
    p_top.add_argument("--continue-prompt", type=str, default="继续", help="恢复或注入的指令 (默认: '继续')")

    # status
    subparsers.add_parser("status", help="查询当前 5h 额度、重置时间及守护状态")

    # sessions
    p_sess = subparsers.add_parser("sessions", help="查看所有 Codex 会话列表与活跃/挂起状态")
    p_sess.add_argument("--limit", type=int, default=15, help="显示数量 (默认: 15)")

    # watch
    p_watch = subparsers.add_parser("watch", help="在前台启动守护监视器")
    p_watch.add_argument("--threshold", type=float, default=3.0, help="额度剩余百分比阈值 (默认: 3.0)")
    p_watch.add_argument("--interval", type=int, default=10, help="监控轮询间隔秒数 (默认: 10)")
    p_watch.add_argument("--continue-prompt", type=str, default="继续", help="恢复或空闲时向会话自动发送的指令 (默认: '继续')")
    p_watch.add_argument("--auto-continue", dest="auto_continue", action="store_true", default=True, help="当 Codex 回合结束空闲时自动发送「继续」(默认开启)")
    p_watch.add_argument("--no-auto-continue", dest="auto_continue", action="store_false", help="禁用回合空闲时自动发送「继续」")
    p_watch.add_argument("--idle-delay", type=int, default=5, help="检测到空闲后等待的缓冲秒数 (默认: 5s)")

    # pause
    subparsers.add_parser("pause", help="手动暂停正在运行的 Codex 客户端进程并记录快照")

    # stop / kill
    for s_name in ("stop", "kill"):
        p_stop = subparsers.add_parser(s_name, help="彻底停止正在运行的 Codex 客户端与推理任务，掐断 Token 消耗并防止自动拉起")
        p_stop.add_argument("--all", action="store_true", help="同时停止后台守护服务 codex-quota-guard.service")
        p_stop.add_argument("--service", action="store_true", help="同时停止后台守护服务 codex-quota-guard.service")

    # resume
    p_resume = subparsers.add_parser("resume", help="手动唤醒被暂停的 Codex 客户端进程或恢复指定 session")
    p_resume.add_argument("session_id", nargs="?", default=None, help="可选：指定恢复的 Session ID")
    p_resume.add_argument("--no-continue", action="store_true", help="唤醒后不发送「继续」指令")
    p_resume.add_argument("--continue-prompt", type=str, default="继续", help="恢复时发送的指令 (默认: '继续')")

    # run
    p_run = subparsers.add_parser("run", help="包装运行 Codex 并自动保护当前任务与会话")
    p_run.add_argument("--threshold", type=float, default=3.0, help="额度剩余百分比阈值 (默认: 3.0)")
    p_run.add_argument("--interval", type=int, default=15, help="监控轮询间隔秒数 (默认: 15)")
    p_run.add_argument("--continue-prompt", type=str, default="继续", help="恢复时发送的指令 (默认: '继续')")

    # service
    p_service = subparsers.add_parser("service", help="管理 systemd 守护服务 (install / uninstall / start / stop / restart / status)")
    p_service.add_argument("action", choices=["install", "uninstall", "start", "stop", "restart", "status"], help="操作")
    p_service.add_argument("--threshold", type=float, default=3.0, help="额度剩余百分比阈值 (默认: 3.0)")
    p_service.add_argument("--interval", type=int, default=10, help="监控轮询间隔秒数 (默认: 10)")
    p_service.add_argument("--continue-prompt", type=str, default="继续", help="恢复或空闲时向会话自动发送的指令 (默认: '继续')")
    p_service.add_argument("--auto-continue", dest="auto_continue", action="store_true", default=True, help="当 Codex 回合结束空闲时自动发送「继续」(默认开启)")
    p_service.add_argument("--no-auto-continue", dest="auto_continue", action="store_false", help="禁用回合空闲时自动发送「继续」")
    p_service.add_argument("--idle-delay", type=int, default=5, help="检测到空闲后等待的缓冲秒数 (默认: 5s)")

    prog_name = os.path.basename(sys.argv[0]).lower()
    if prog_name in ("codex-top", "top"):
        if len(sys.argv) == 1 or sys.argv[1] not in ("top", "-h", "--help"):
            sys.argv.insert(1, "top")

    # 如果无子命令，默认使用 status
    if len(sys.argv) == 1:
        cmd_status(None)
        return

    known_cmds = ["top", "status", "sessions", "watch", "pause", "stop", "kill", "resume", "run", "service", "-h", "--help"]
    if sys.argv[1] not in known_cmds:
        args, unknown = parser.parse_known_args(["run"] + sys.argv[1:])
        cmd_run(args, unknown)
        return

    args, unknown = parser.parse_known_args()

    if args.subcommand == "top":
        cmd_top(args)
    elif args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "sessions":
        cmd_sessions(args)
    elif args.subcommand == "watch":
        cmd_watch(args)
    elif args.subcommand == "pause":
        cmd_pause(args)
    elif args.subcommand in ("stop", "kill"):
        cmd_stop(args)
    elif args.subcommand == "resume":
        cmd_resume(args)
    elif args.subcommand == "run":
        cmd_run(args, unknown)
    elif args.subcommand == "service":
        cmd_service(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
